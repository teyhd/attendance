<style>
  [data-presence-class-list].is-two-rows {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 0.25rem;
    margin-top: 0.5rem;
    overflow-x: visible;
    padding-bottom: 0;
  }

  [data-presence-class-list].is-two-rows > a {
    height: 1.75rem;
    min-width: 0;
    overflow: hidden;
    padding: 0;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 10px;
    line-height: 1.5rem;
  }

  .manual-class-picker { display: none; }
  [data-presence-class] { scroll-margin-top: var(--manual-scroll-margin, 13rem); }
  .manual-presence-card[hidden], [data-presence-class][hidden] { display: none; }
  .manual-history-dialog { width: min(32rem, calc(100% - 1rem)); max-height: calc(100dvh - 1rem); }
  .manual-history-content { max-height: 68dvh; overflow-y: auto; }
  .manual-summary { display: flex; align-items: flex-start; justify-content: space-between; gap: .5rem; }
  .manual-presence-card {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    min-width: 0;
  }

  .manual-presence-card [data-presence-button] { min-height: 4.5rem; overflow-wrap: anywhere; }
  @media (max-width: 767px) {
    main:has(> .manual-presence-board) { padding-block: 1rem; }
    .manual-class-picker { display: grid; align-items: center; grid-template-columns: auto minmax(0, 1fr); gap: .5rem; margin-top: .5rem; }
    .manual-class-picker select { min-width: 0; }
    [data-presence-class-list], [data-presence-class-list].is-two-rows { display: none; }
  }
  .manual-presence-card [data-conflict-actions] { grid-column: 1 / -1; padding: 0 .5rem .5rem; }

  .manual-presence-actions {
    align-self: center;
    display: grid;
    justify-items: end;
    gap: .25rem;
    padding: .5rem .5rem .5rem 0;
  }

  .manual-presence-actions:not(:has(button:not([hidden]):not(.hidden))) { display: none; }
  .manual-presence-actions > [data-phone-after-notice] {
    width: clamp(6.25rem, 34vw, 7.25rem);
    min-height: 2.75rem;
    padding: .375rem .25rem;
    white-space: normal;
    text-align: center;
    font-size: .75rem;
    line-height: 1.1;
    overflow-wrap: anywhere;
  }

  .manual-presence-icon {
    display: grid;
    width: 2.75rem;
    height: 2.75rem;
    place-items: center;
    padding: 0;
  }

  .manual-presence-icon svg { width: 1.5rem; height: 1.5rem; }
</style>

<section id="presence-top" data-presence-root data-date="{{board.date}}" data-actor-id="{{currentUser.id}}" data-server-time="{{manualServerTime}}" data-audience="{{board.audience}}" class="manual-presence-board space-y-3">
  <div data-manual-toolbar class="sticky top-2 z-20 space-y-2">
    <div class="rounded-md border border-gray-200 bg-white p-3 shadow-sm">
      <div class="manual-summary">
        <div>
          <h1 class="text-xl font-semibold text-gray-950">Приход и уход{{#if board.is_adult}} сотрудников{{/if}}</h1>
          <div class="mt-1 text-sm text-gray-600">{{board.date_label}} · <span data-manual-present>{{board.totals.present}}</span> из {{board.totals.students}} {{#if board.is_adult}}на работе{{else}}в школе{{/if}}</div>
        </div>
        <a href="#presence-top" class="inline-flex min-h-11 shrink-0 items-center rounded border border-gray-300 bg-white px-2 text-sm font-medium text-gray-700 hover:border-gray-900 hover:text-gray-950">Наверх</a>
      </div>

      {{#if audienceTabs.length}}
        <div class="mt-3 flex flex-wrap gap-2 border-b border-gray-200">
          {{#each audienceTabs}}
            <a href="{{href}}" class="rounded-t border border-b-0 px-3 py-2 text-sm font-medium {{#if active}}bg-white border-gray-200 text-gray-900 shadow-sm{{else}}border-transparent bg-gray-50 text-gray-600 hover:bg-white{{/if}}">{{label}}</a>
          {{/each}}
        </div>
      {{/if}}

      {{#if board.classes.length}}
        <label class="mt-3 block text-sm font-medium">
          <span class="sr-only">{{#if board.is_adult}}Найти сотрудника{{else}}Найти ученика{{/if}}</span>
          <input type="search" data-manual-search autocomplete="off" placeholder="{{#if board.is_adult}}Найти сотрудника{{else}}Найти ученика{{/if}}" class="min-h-11 w-full rounded-md border border-slate-300 px-3">
        </label>
        {{#if board.is_adult}}
          <label class="manual-class-picker text-sm font-medium">
            <span>Кафедра</span>
            <select data-manual-class-picker class="w-full" aria-label="Перейти к кафедре">
              <option value="">Выберите</option>
              {{#each board.classes}}<option value="{{anchor}}">{{name}}</option>{{/each}}
            </select>
          </label>
          <div data-presence-class-list class="mt-3 flex gap-2 overflow-x-auto pb-1" aria-label="Кафедры">
            {{#each board.classes}}
              <a href="#{{anchor}}" title="{{name}}" class="shrink-0 rounded border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-800 hover:border-gray-900">{{name}}</a>
            {{/each}}
          </div>
        {{else}}
          <nav data-manual-class-keys class="class-keyboard mt-3" aria-label="Перейти к классу">
            {{#each board.classes}}
              <a href="#{{anchor}}" class="class-keyboard-key">{{name}}</a>
            {{/each}}
          </nav>
        {{/if}}
      {{/if}}
    </div>

    <div data-presence-sync hidden class="rounded-md border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900">
      <span data-presence-sync-text role="status"></span>
      <button type="button" data-presence-retry hidden class="workspace-link font-medium">Повторить отправку</button>
      <button type="button" data-presence-dismiss-expired hidden class="workspace-link font-medium">Убрать просроченные</button>
      <button type="button" data-presence-reload hidden class="workspace-link font-medium">Обновить страницу</button>
    </div>
    <div data-presence-flash class="hidden" role="status" aria-live="polite">
      <span data-presence-flash-text class="min-w-0 flex-1 break-words"></span>
      <button type="button" data-presence-cancel class="hidden shrink-0 rounded border border-current px-3 py-1.5 text-sm font-medium">Отменить</button>
    </div>
  </div>

  {{#if board.classes.length}}
    <div class="space-y-3">
      {{#each board.classes}}
        <section id="{{anchor}}" data-presence-class class="rounded-md border border-gray-200 bg-white">
          <div class="flex items-center justify-between border-b border-gray-200 px-3 py-2">
            <h2 class="text-lg font-semibold text-gray-950">{{name}}</h2>
            <span class="text-sm text-gray-500">{{students_label}}</span>
          </div>
          <div class="grid grid-cols-1 gap-1.5 p-2 sm:grid-cols-2 sm:gap-2 sm:p-3 lg:grid-cols-3 xl:grid-cols-4">
            {{#each students}}
              <div class="manual-presence-card rounded-md border shadow-sm transition {{#if (or (eq state.status_code "absent") (eq state.status_code "conflict"))}}border-red-300 bg-red-50 hover:bg-red-100{{else}}{{#if (eq state.status_code "late")}}border-amber-300 bg-amber-50 hover:bg-amber-100{{else}}{{#if (eq state.status_code "present")}}border-emerald-600 bg-emerald-50 hover:bg-emerald-100{{else}}{{#if (eq state.status_code "departed")}}border-slate-300 bg-slate-50 hover:bg-slate-100{{else}}border-gray-300 bg-white hover:bg-gray-50{{/if}}{{/if}}{{/if}}{{/if}}">
                <button
                  type="button"
                  data-presence-button
                  data-student-id="{{id}}"
                  data-class-id="{{classId}}"
                  data-audience="{{../../board.audience}}"
                  data-last-event-id="{{state.last_event_id}}"
                  data-last-event-revision="{{state.last_event_revision}}"
                  data-last-event-type="{{state.last_event_type}}"
                  data-status-code="{{state.status_code}}"
                  data-conflict-id="{{state.conflict_id}}"
                  aria-label="{{name}} · {{state.status_label}}{{#unless state.conflict_id}} · {{state.next_action_label}}{{/unless}}"
                  {{#if state.conflict_id}}aria-disabled="true"{{/if}}
                  {{#unless ../../board.is_adult}}aria-describedby="manual-phone-{{id}}"{{/unless}}
                  class="min-w-0 w-full rounded-md px-2 py-2 sm:px-3 text-left focus:outline-none focus:ring-2 focus:ring-inset focus:ring-gray-900 disabled:cursor-wait disabled:opacity-60"
                >
                  <span data-presence-name class="block text-base font-semibold leading-5 text-gray-950">{{name}}</span>
                  <span data-presence-status class="mt-1 inline-flex rounded-full px-2 py-0.5 text-xs font-semibold {{#if (or (eq state.status_code "absent") (eq state.status_code "conflict"))}}bg-red-100 text-red-800{{else}}{{#if (eq state.status_code "late")}}bg-amber-100 text-amber-800{{else}}{{#if (eq state.status_code "present")}}bg-emerald-100 text-emerald-800{{else}}{{#if (eq state.status_code "departed")}}bg-slate-200 text-slate-700{{else}}bg-gray-100 text-gray-600{{/if}}{{/if}}{{/if}}{{/if}}">{{state.status_badge_label}}</span>
                  <span data-presence-detail class="mt-1 block text-sm leading-4 text-gray-600">{{state.status_detail}}</span>
                  {{#unless ../../board.is_adult}}
                    <span id="manual-phone-{{id}}" class="mt-1 block break-words text-xs text-slate-600">
                      <span class="font-medium">Телефон:</span>
                      <span data-phone-answer class="font-semibold {{#if phone_check.submitted_after_notice_at}}text-amber-800{{else if (eq phone_check.submitted true)}}text-emerald-800{{else if (eq phone_check.submitted false)}}text-red-800{{/if}}">{{#if phone_check.submitted_after_notice_at}}сдал после замечания{{else if (eq phone_check.submitted true)}}сдал{{else if (eq phone_check.submitted false)}}не сдал{{else}}нет отметки{{/if}}</span><span data-phone-pickup>{{#if (eq phone_check.picked_up true)}} · забрал{{else if (eq phone_check.picked_up false)}} · не забрал{{/if}}</span>
                    </span>
                  {{/unless}}
                  <span data-presence-pending hidden class="mt-1 text-sm font-semibold text-amber-800">Ожидает отправки</span>
                  <span data-presence-next class="mt-1 block text-sm font-semibold text-blue-700 {{#if state.conflict_id}}hidden{{/if}}">{{state.next_action_label}}</span>
                </button>
                <div class="manual-presence-actions">
                  {{#unless ../../board.is_adult}}
                    <button type="button" data-phone-after-notice class="workspace-secondary" hidden>Сдал после замечания</button>
                    <button type="button" data-manual-phone data-student-id="{{id}}" aria-label="Телефон · {{name}}" aria-haspopup="dialog" title="Телефон" class="workspace-secondary manual-presence-icon">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true">
                        <rect x="7" y="3" width="10" height="18" rx="2" />
                        <path d="M11 17h2" />
                      </svg>
                    </button>
                  {{/unless}}
                  <button type="button" data-presence-edit data-student-id="{{id}}" aria-label="История за сегодня · {{name}}" aria-haspopup="dialog" title="История за сегодня" class="workspace-secondary manual-presence-icon">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                      <path d="M3 12a9 9 0 1 1 2.6 6.4M3 5v7h7M12 7v5l3 2" />
                    </svg>
                  </button>
                </div>
                <div class="grid grid-cols-2 gap-1.5 {{#unless state.conflict_id}}hidden{{/unless}}" data-conflict-actions>
                  <button type="button" data-conflict-resolve="keep_presence" data-conflict-id="{{state.conflict_id}}" class="rounded border border-emerald-300 bg-white px-2 py-1.5 text-xs font-medium text-emerald-800 hover:bg-emerald-50">Подтвердить приход</button>
                  <button type="button" data-conflict-resolve="keep_absence" data-conflict-id="{{state.conflict_id}}" class="rounded border border-red-300 bg-white px-2 py-1.5 text-xs font-medium text-red-800 hover:bg-red-50">Оставить отсутствие</button>
                </div>
              </div>
            {{/each}}
          </div>
        </section>
      {{/each}}
    </div>
    <p data-manual-search-empty hidden role="status" class="rounded-md border border-gray-200 bg-white p-4 text-sm text-gray-600">{{#if board.is_adult}}Сотрудники не найдены{{else}}Ученики не найдены{{/if}}</p>
  {{else}}
    <div class="rounded-md border border-gray-200 bg-white p-4 text-sm text-gray-600">{{#if board.is_adult}}Нет сотрудников.{{else if (eq currentUser.role "mentor")}}В закреплённых за вами классах нет учеников для ручного ввода.{{else}}Нет учеников.{{/if}} <a href="/attendance/presence{{#if board.is_adult}}?audience=adults{{/if}}" class="workspace-link">Открыть сводку присутствия</a></div>
  {{/if}}
</section>

{{#if board.classes.length}}
  <dialog data-presence-history-dialog aria-labelledby="manual-presence-history-title" class="manual-history-dialog rounded-lg border border-gray-200 bg-white p-0 shadow-xl backdrop:bg-black/30">
    <div class="flex items-center justify-between gap-3 border-b border-gray-200 px-4 py-3">
      <h2 id="manual-presence-history-title" data-presence-history-title class="min-w-0 break-words text-lg font-semibold text-gray-950"></h2>
      <button type="button" data-presence-history-close aria-label="Закрыть" class="h-11 w-11 shrink-0 rounded text-xl text-gray-500 hover:bg-gray-100 hover:text-gray-950">×</button>
    </div>
    <div class="manual-history-content p-3 sm:p-4">
      <p data-history-error hidden role="alert" class="mb-2 rounded bg-red-50 p-2 text-sm text-red-800"></p>
      <div data-presence-history-events class="space-y-2"></div>
      {{#unless board.is_adult}}<a data-full-history class="workspace-link mt-3 inline-flex min-h-11 items-center text-sm">Вся история ученика</a>{{/unless}}
    </div>
  </dialog>
  <script id="presence-history-data" type="application/json">{{{json board.classes}}}</script>
{{/if}}

{{#unless board.is_adult}}<script src="/assets/presence-phone.js?v=7"></script>{{/unless}}
<script src="/assets/presence-manual.js?v=1"></script>
