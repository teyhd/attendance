<style>
  [data-presence-class-list].is-two-rows {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 0.25rem;
    margin-top: 0.5rem;
    overflow-x: visible;
    padding-bottom: 0;
  }

  [data-presence-class-list].is-two-rows > a {
    height: 1.75rem;
    min-width: 0;
    overflow: hidden;
    padding: 0;
    text-align: center;
    text-overflow: ellipsis;
    white-space: nowrap;
    font-size: 10px;
    line-height: 1.5rem;
  }
</style>

<section id="presence-top" data-presence-root data-date="{{board.date}}" data-audience="{{board.audience}}" class="space-y-3">
  <div class="sticky top-2 z-20 space-y-2">
    <div class="rounded-md border border-gray-200 bg-white p-3 shadow-sm">
      <div class="flex flex-col gap-3 md:flex-row md:items-end md:justify-between">
        <div>
          <h1 class="text-xl font-semibold text-gray-950">{{#if board.is_adult}}Ручной ввод сотрудников{{else}}Ручной ввод{{/if}}</h1>
          <div class="mt-1 text-sm text-gray-600">{{board.date_label}} · {{board.totals.present}} / {{board.totals.students}}</div>
        </div>
        <a href="#presence-top" class="inline-flex w-fit rounded border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-700 hover:border-gray-900 hover:text-gray-950">Наверх</a>
      </div>

      {{#if audienceTabs.length}}
        <div class="mt-3 flex flex-wrap gap-2 border-b border-gray-200">
          {{#each audienceTabs}}
            <a href="{{href}}" class="rounded-t border border-b-0 px-3 py-2 text-sm font-medium {{#if active}}bg-white border-gray-200 text-gray-900 shadow-sm{{else}}border-transparent bg-gray-50 text-gray-600 hover:bg-white{{/if}}">{{label}}</a>
          {{/each}}
        </div>
      {{/if}}

      {{#if board.classes.length}}
        <div data-presence-class-list class="mt-3 flex gap-2 overflow-x-auto pb-1" aria-label="Классы">
          {{#each board.classes}}
            <a href="#{{anchor}}" title="{{name}}" class="shrink-0 rounded border border-gray-300 bg-white px-3 py-2 text-sm font-medium text-gray-800 hover:border-gray-900">{{name}}</a>
          {{/each}}
        </div>
      {{/if}}
    </div>

    <div data-presence-flash class="hidden">
      <span data-presence-flash-text class="min-w-0 flex-1 truncate"></span>
      <button type="button" data-presence-cancel class="hidden shrink-0 rounded border border-current px-3 py-1.5 text-sm font-medium">Отменить</button>
    </div>
  </div>

  {{#if board.classes.length}}
    <div class="space-y-3">
      {{#each board.classes}}
        <section id="{{anchor}}" data-presence-class class="scroll-mt-4 rounded-md border border-gray-200 bg-white" style="scroll-margin-top: 9rem;">
          <div class="flex items-center justify-between border-b border-gray-200 px-3 py-2">
            <h2 class="text-lg font-semibold text-gray-950">{{name}}</h2>
            <span class="text-sm text-gray-500">{{students_label}}</span>
          </div>
          <div class="grid grid-cols-1 gap-2 p-3 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4">
            {{#each students}}
              <div class="space-y-1.5">
                <button
                  type="button"
                  data-presence-button
                  data-student-id="{{id}}"
                  data-class-id="{{classId}}"
                  data-audience="{{../../board.audience}}"
                  data-last-event-id="{{state.last_event_id}}"
                  data-last-event-type="{{state.last_event_type}}"
                  data-status-code="{{state.status_code}}"
                  data-conflict-id="{{state.conflict_id}}"
                  aria-label="{{name}} · {{state.status_label}}"
                  class="min-h-[6.25rem] w-full rounded-md border px-3 py-3 text-left shadow-sm transition focus:outline-none focus:ring-2 focus:ring-gray-900 disabled:cursor-wait disabled:opacity-60 {{#if (or (eq state.status_code "absent") (eq state.status_code "conflict"))}}border-red-300 bg-red-50 hover:bg-red-100{{else}}{{#if (eq state.status_code "late")}}border-amber-300 bg-amber-50 hover:bg-amber-100{{else}}{{#if (eq state.status_code "present")}}border-emerald-600 bg-emerald-50 hover:bg-emerald-100{{else}}{{#if (eq state.status_code "departed")}}border-slate-300 bg-slate-50 hover:bg-slate-100{{else}}border-gray-300 bg-white hover:bg-gray-50{{/if}}{{/if}}{{/if}}{{/if}}"
                >
                  <span class="block text-base font-semibold leading-5 text-gray-950">{{name}}</span>
                  <span data-presence-status class="mt-2 inline-flex rounded-full px-2 py-0.5 text-xs font-semibold {{#if (or (eq state.status_code "absent") (eq state.status_code "conflict"))}}bg-red-100 text-red-800{{else}}{{#if (eq state.status_code "late")}}bg-amber-100 text-amber-800{{else}}{{#if (eq state.status_code "present")}}bg-emerald-100 text-emerald-800{{else}}{{#if (eq state.status_code "departed")}}bg-slate-200 text-slate-700{{else}}bg-gray-100 text-gray-600{{/if}}{{/if}}{{/if}}{{/if}}">{{state.status_badge_label}}</span>
                  <span data-presence-detail class="mt-1 block text-sm leading-4 text-gray-600">{{state.status_detail}}</span>
                </button>
                {{#if state.conflict_id}}
                  <div class="grid grid-cols-2 gap-1.5" data-conflict-actions>
                    <button type="button" data-conflict-resolve="keep_presence" data-conflict-id="{{state.conflict_id}}" class="rounded border border-emerald-300 bg-white px-2 py-1.5 text-xs font-medium text-emerald-800 hover:bg-emerald-50">Подтвердить приход</button>
                    <button type="button" data-conflict-resolve="keep_absence" data-conflict-id="{{state.conflict_id}}" class="rounded border border-red-300 bg-white px-2 py-1.5 text-xs font-medium text-red-800 hover:bg-red-50">Оставить отсутствие</button>
                  </div>
                {{/if}}
                {{#unless ../../board.is_adult}}
                  {{#if presence_events.length}}
                    <button type="button" data-presence-edit data-student-id="{{id}}" class="w-full rounded border border-gray-300 bg-white px-3 py-1.5 text-sm font-medium text-gray-700 hover:border-gray-900 hover:text-gray-950">Редактировать</button>
                  {{/if}}
                {{/unless}}
              </div>
            {{/each}}
          </div>
        </section>
      {{/each}}
    </div>
  {{else}}
    <div class="rounded-md border border-gray-200 bg-white p-4 text-sm text-gray-500">{{#if board.is_adult}}Нет сотрудников{{else}}Нет учеников{{/if}}</div>
  {{/if}}
</section>

{{#unless board.is_adult}}
  <dialog data-presence-history-dialog class="w-[calc(100%-2rem)] max-w-lg rounded-lg border border-gray-200 bg-white p-0 shadow-xl backdrop:bg-black/30">
    <div class="flex items-center justify-between gap-3 border-b border-gray-200 px-4 py-3">
      <h2 data-presence-history-title class="text-lg font-semibold text-gray-950"></h2>
      <button type="button" data-presence-history-close aria-label="Закрыть" class="rounded px-2 py-1 text-lg text-gray-500 hover:bg-gray-100 hover:text-gray-950">×</button>
    </div>
    <div class="p-4">
      <div data-presence-history-events class="space-y-2"></div>
    </div>
  </dialog>
  <script id="presence-history-data" type="application/json">{{{json board.classes}}}</script>
{{/unless}}

<script>
(() => {
  const root = document.querySelector('[data-presence-root]');
  if (!root) return;

  const buttons = Array.from(root.querySelectorAll('[data-presence-button]'));
  const flash = root.querySelector('[data-presence-flash]');
  const flashText = root.querySelector('[data-presence-flash-text]');
  const cancelButton = root.querySelector('[data-presence-cancel]');
  const classList = root.querySelector('[data-presence-class-list]');
  const historyDialog = root.parentElement?.querySelector('[data-presence-history-dialog]');
  const historyTitle = historyDialog?.querySelector('[data-presence-history-title]');
  const historyEvents = historyDialog?.querySelector('[data-presence-history-events]');
  const historyData = parseJsonScript('presence-history-data');
  const flashBase = 'flex items-center gap-3 rounded-md border px-3 py-2 text-sm shadow-sm';

  const syncClassListLayout = () => {
    if (!classList) return;
    classList.classList.remove('is-two-rows');
    classList.classList.toggle('is-two-rows', classList.scrollWidth > classList.clientWidth + 1);
  };
  window.requestAnimationFrame(syncClassListLayout);
  window.addEventListener('resize', syncClassListLayout);

  const eventLabel = (type) => type === 'departure' ? 'Ушёл' : 'Присутствует';
  const cardToneClasses = [
    'border-red-300', 'bg-red-50', 'hover:bg-red-100',
    'border-amber-300', 'bg-amber-50', 'hover:bg-amber-100',
    'border-emerald-600', 'bg-emerald-50', 'hover:bg-emerald-100',
    'border-slate-300', 'bg-slate-50', 'hover:bg-slate-100',
    'border-gray-300', 'bg-white', 'hover:bg-gray-50',
  ];
  const statusToneClasses = [
    'bg-red-100', 'text-red-800',
    'bg-amber-100', 'text-amber-800',
    'bg-emerald-100', 'text-emerald-800',
    'bg-slate-200', 'text-slate-700',
    'bg-gray-100', 'text-gray-600',
  ];
  const cardTone = {
    conflict: ['border-red-300', 'bg-red-50', 'hover:bg-red-100'],
    absent: ['border-red-300', 'bg-red-50', 'hover:bg-red-100'],
    late: ['border-amber-300', 'bg-amber-50', 'hover:bg-amber-100'],
    present: ['border-emerald-600', 'bg-emerald-50', 'hover:bg-emerald-100'],
    departed: ['border-slate-300', 'bg-slate-50', 'hover:bg-slate-100'],
    none: ['border-gray-300', 'bg-white', 'hover:bg-gray-50'],
  };
  const statusTone = {
    conflict: ['bg-red-100', 'text-red-800'],
    absent: ['bg-red-100', 'text-red-800'],
    late: ['bg-amber-100', 'text-amber-800'],
    present: ['bg-emerald-100', 'text-emerald-800'],
    departed: ['bg-slate-200', 'text-slate-700'],
    none: ['bg-gray-100', 'text-gray-600'],
  };
  const newKey = () => window.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(16).slice(2)}`;
  const currentLocalDate = () => {
    const date = new Date();
    const pad = (value) => String(value).padStart(2, '0');
    return `${date.getFullYear()}-${pad(date.getMonth() + 1)}-${pad(date.getDate())}`;
  };
  const refreshIfDateChanged = () => {
    if (root.dataset.date && root.dataset.date !== currentLocalDate()) {
      window.location.reload();
    }
  };

  function parseJsonScript(id) {
    const source = document.getElementById(id);
    if (!source) return [];
    try {
      const parsed = JSON.parse(source.textContent || '[]');
      return Array.isArray(parsed) ? parsed : [];
    } catch {
      return [];
    }
  }

  function findStudent(studentId) {
    for (const classItem of historyData) {
      const student = (classItem.students || []).find((item) => String(item.id) === String(studentId));
      if (student) return student;
    }
    return null;
  }

  function historyEventLabel(event) {
    if (event.source === 'mentor_manual_late') return 'Опоздал · вручную';
    if (event.source === 'face') return event.event_type === 'departure' ? 'Ушёл · камера' : 'Пришёл · камера';
    return event.event_type === 'departure' ? 'Ушёл · вручную' : 'Пришёл · вручную';
  }

  function renderHistory(student) {
    if (!historyTitle || !historyEvents || !student) return;
    historyTitle.textContent = student.name || 'История отметок';
    historyEvents.replaceChildren();
    const events = Array.isArray(student.presence_events) ? student.presence_events : [];
    if (!events.length) {
      const empty = document.createElement('div');
      empty.className = 'rounded border border-gray-200 bg-gray-50 p-3 text-sm text-gray-500';
      empty.textContent = 'За сегодня отметок пока нет.';
      historyEvents.append(empty);
      return;
    }

    for (const event of events) {
      const row = document.createElement('div');
      row.className = 'flex items-center justify-between gap-3 rounded border border-gray-200 px-3 py-2';
      const details = document.createElement('div');
      const time = document.createElement('div');
      time.className = 'text-sm font-medium text-gray-900';
      time.textContent = event.occurred_label || event.occurred_at || '';
      const label = document.createElement('div');
      label.className = 'mt-0.5 text-xs text-gray-600';
      label.textContent = historyEventLabel(event);
      details.append(time, label);
      row.append(details);

      if (event.can_edit) {
        const cancel = document.createElement('button');
        cancel.type = 'button';
        cancel.dataset.presenceHistoryCancel = event.id || '';
        cancel.className = 'shrink-0 rounded border border-red-200 px-3 py-1.5 text-sm font-medium text-red-700 hover:bg-red-50 disabled:cursor-wait disabled:opacity-60';
        cancel.textContent = 'Отменить';
        row.append(cancel);
      } else {
        const readonly = document.createElement('span');
        readonly.className = 'shrink-0 rounded bg-gray-100 px-2 py-1 text-xs font-medium text-gray-600';
        readonly.textContent = 'Автоматически';
        row.append(readonly);
      }
      historyEvents.append(row);
    }
  }

  function closeHistoryDialog() {
    if (!historyDialog) return;
    if (typeof historyDialog.close === 'function') historyDialog.close();
    else historyDialog.removeAttribute('open');
  }

  function setFlash(text, { kind = 'ok', eventId = '' } = {}) {
    if (!flash || !flashText) return;
    const kindClass = kind === 'error'
      ? 'border-red-200 bg-red-50 text-red-900'
      : 'border-emerald-200 bg-emerald-50 text-emerald-900';
    flash.className = `${flashBase} ${kindClass}`;
    flashText.textContent = text;
    if (cancelButton) {
      cancelButton.dataset.eventId = eventId;
      cancelButton.classList.toggle('hidden', !eventId);
    }
  }

  async function postJson(url, body = {}) {
    const response = await fetch(url, {
      method: 'POST',
      credentials: 'same-origin',
      headers: {
        'Accept': 'application/json',
        'Content-Type': 'application/json',
      },
      body: JSON.stringify(body),
    });
    const payload = await response.json().catch(() => ({}));
    if (!response.ok) {
      throw new Error(payload.message || payload.error || 'Не удалось сохранить');
    }
    return payload;
  }

  function applyState(button, state) {
    const status = button.querySelector('[data-presence-status]');
    const detail = button.querySelector('[data-presence-detail]');
    const statusCode = state?.status_code || (state?.is_present ? 'present' : 'none');
    button.dataset.lastEventId = state?.last_event_id || '';
    button.dataset.lastEventType = state?.last_event_type || '';
    button.dataset.statusCode = statusCode;
    button.dataset.conflictId = state?.conflict_id || '';
    button.setAttribute('aria-label', `${button.querySelector('.font-semibold')?.textContent || ''} · ${state?.status_label || 'Нет отметки'}`);

    status.textContent = state?.status_badge_label || state?.status_word || 'Нет отметки';
    if (detail) detail.textContent = state?.status_detail || state?.status_time || '';
    button.classList.remove(...cardToneClasses);
    button.classList.add(...(cardTone[statusCode] || cardTone.none));
    status.classList.remove(...statusToneClasses);
    status.classList.add(...(statusTone[statusCode] || statusTone.none));
  }

  buttons.forEach((button) => {
    button.addEventListener('click', async () => {
      if (button.disabled) return;
      if (button.dataset.conflictId) {
        setFlash('Сначала выберите, какую из двух отметок оставить', { kind: 'error' });
        return;
      }
      button.disabled = true;
      try {
        const payload = await postJson('/api/attendance/presence/toggle', {
          studentId: button.dataset.studentId,
          classId: button.dataset.classId,
          audience: button.dataset.audience || root.dataset.audience || 'children',
          idempotencyKey: newKey(),
        });
        if (payload.event?.attendance_date && payload.event.attendance_date !== root.dataset.date) {
          window.location.reload();
          return;
        }
        applyState(button, payload.state);
        if (Array.isArray(payload.conflicts) && payload.conflicts.length) {
          window.location.reload();
          return;
        }
        const event = payload.event || {};
        setFlash(`${event.student_name || ''}: ${event.event_label || eventLabel(event.event_type)} ${event.occurred_label || event.occurred_time || ''}`.trim(), {
          eventId: event.id || '',
        });
      } catch (err) {
        setFlash(err.message || 'Не удалось сохранить', { kind: 'error' });
      } finally {
        button.disabled = false;
      }
    });
  });

  root.querySelectorAll('[data-conflict-resolve]').forEach((button) => {
    button.addEventListener('click', async () => {
      const conflictId = button.dataset.conflictId || '';
      if (!conflictId || button.disabled) return;
      const resolution = button.dataset.conflictResolve || '';
      button.disabled = true;
      try {
        await postJson(`/api/attendance/conflicts/${encodeURIComponent(conflictId)}/resolve`, {
          audience: root.dataset.audience || 'children',
          resolution,
        });
        window.location.reload();
      } catch (err) {
        button.disabled = false;
        setFlash(err.message || 'Не удалось разрешить конфликт', { kind: 'error' });
      }
    });
  });

  root.querySelectorAll('[data-presence-edit]').forEach((button) => {
    button.addEventListener('click', () => {
      const student = findStudent(button.dataset.studentId);
      if (!student || !historyDialog) return;
      renderHistory(student);
      if (typeof historyDialog.showModal === 'function') historyDialog.showModal();
      else historyDialog.setAttribute('open', '');
    });
  });

  historyDialog?.querySelector('[data-presence-history-close]')?.addEventListener('click', closeHistoryDialog);
  historyDialog?.addEventListener('click', (event) => {
    if (event.target === historyDialog) closeHistoryDialog();
  });
  historyEvents?.addEventListener('click', async (event) => {
    const cancel = event.target.closest('[data-presence-history-cancel]');
    const eventId = cancel?.dataset.presenceHistoryCancel || '';
    if (!eventId || !window.confirm('Отменить эту ручную отметку?')) return;
    cancel.disabled = true;
    try {
      await postJson(`/api/attendance/presence/events/${encodeURIComponent(eventId)}/cancel`, {
        audience: root.dataset.audience || 'children',
      });
      closeHistoryDialog();
      window.location.reload();
    } catch (err) {
      cancel.disabled = false;
      setFlash(err.message || 'Не удалось отменить', { kind: 'error' });
    }
  });

  cancelButton?.addEventListener('click', async () => {
    const eventId = cancelButton.dataset.eventId || '';
    if (!eventId) return;
    cancelButton.disabled = true;
    try {
      const payload = await postJson(`/api/attendance/presence/events/${encodeURIComponent(eventId)}/cancel`, {
        audience: root.dataset.audience || 'children',
      });
      const event = payload.event || {};
      const button = buttons.find((item) => String(item.dataset.studentId) === String(event.student_id));
      if (button) applyState(button, payload.state);
      setFlash(`Отменено: ${event.student_name || ''}`.trim());
    } catch (err) {
      setFlash(err.message || 'Не удалось отменить', { kind: 'error' });
    } finally {
      cancelButton.disabled = false;
    }
  });

  document.addEventListener('visibilitychange', () => {
    if (!document.hidden) refreshIfDateChanged();
  });
  window.addEventListener('focus', refreshIfDateChanged);
  window.setInterval(refreshIfDateChanged, 60_000);
})();
</script>
