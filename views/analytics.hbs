<script>
(() => {
  const panel = document.getElementById('absence-calendar');
  if (!panel) return;
  let selectedDate = '';
  function showDay(day) {
    selectedDate = day.dataset.analyticsDay;
    for (const button of panel.querySelectorAll('[data-analytics-day]')) {
      button.setAttribute('aria-pressed', String(button === day));
    }
    for (const detail of panel.querySelectorAll('[data-analytics-day-detail]')) {
      detail.hidden = detail.dataset.analyticsDayDetail !== selectedDate;
    }
  }
  function initialize() {
    const days = [...panel.querySelectorAll('[data-analytics-day]')];
    panel.querySelector('[data-analytics-calendar-empty]').hidden = days.length > 0;
    if (days.length) showDay(days.find((day) => day.dataset.analyticsDay === selectedDate) || days.at(-1));
  }
  panel.addEventListener('click', (event) => {
    const day = event.target.closest('[data-analytics-day]');
    if (day) showDay(day);
  });
  initialize();
  document.addEventListener('attendance:analytics-refreshed', initialize);
})();
</script>

<script id="analytics-data" type="application/json">{{{json analytics}}}</script>
<script>
(() => {
  const form = document.querySelector('[data-analytics-controls]');
  if (form && !form.elements.from) {
    for (const name of ['month', 'class']) {
      form.elements.namedItem(name)?.addEventListener('change', () => form.requestSubmit());
    }
  }

  document.querySelector('[data-print-analytics]')?.addEventListener('click', () => window.print());
})();

(() => {
  const button = document.querySelector('[data-export-analytics]');
  const source = document.getElementById('analytics-data');
  if (!button || !source) return;

  const quote = (value) => `"${String(value ?? '').replaceAll('"', '""')}"`;
  const row = (values) => values.map(quote).join(';');
  button.addEventListener('click', () => {
    const data = JSON.parse(source.textContent || '{}');
    if (data.is_adult) {
      window.exportStaffDays(data.people || [], data);
      return;
    }

    const lines = [
      row(['Раздел', 'Класс', 'Ученик', 'Период', 'Дни', 'Часы', 'Периоды', 'Без причины', 'Внимание', 'Опоздания', 'Минуты опозданий', 'Последний контекст']),
    ];

    (data.classes || []).forEach((item) => {
      lines.push(row(['Класс', item.class_name, '', '', item.absence_days, item.absence_hours, item.periods, item.without_reason, item.needs_attention, '', '', '']));
    });

    (data.student_attendance?.students || []).forEach((item) => {
      lines.push(row(['Ученик', item.class_name, item.student_name, item.metric_label || '', item.absence_days, '', '', item.unexcused_absence_days, '', '', '', item.absence_button_label || '']));
    });

    (data.lateness?.students || []).forEach((item) => {
      lines.push(row(['Опоздания', item.class_name, item.student_name, item.last_late_label || '', item.late_days, '', item.arrival_days, '', '', item.late_days, item.total_late_minutes, `уроки: ${item.missed_lessons || 0}; предметы: ${item.subjects || 0}`]));
    });

    const blob = new Blob([`\uFEFF${lines.join('\n')}`], { type: 'text/csv;charset=utf-8' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `attendance-${data.month || 'report'}-${data.class_id || 'all'}.csv`;
    document.body.append(link);
    link.click();
    URL.revokeObjectURL(link.href);
    link.remove();
  });
})();

(() => {
  const highlightClasses = ['ring-2', 'ring-indigo-300', 'bg-indigo-50/30'];
  const tabsRoot = document.querySelector('[data-analytics-tabs]');
  const storageKey = 'attendance.analytics.view';
  const buttons = tabsRoot ? Array.from(tabsRoot.querySelectorAll('[data-analytics-tab]')) : [];
  const panels = tabsRoot ? Array.from(tabsRoot.querySelectorAll('[data-analytics-panel]')) : [];
  const available = new Set(buttons.map((button) => button.dataset.analyticsTab));
  let activeTarget = null;
  let highlightTimer = null;

  function clearHighlight() {
    if (highlightTimer) window.clearTimeout(highlightTimer);
    highlightTimer = null;
    if (!activeTarget) return;
    activeTarget.classList.remove(...highlightClasses);
    activeTarget = null;
  }

  function highlightTarget(target) {
    clearHighlight();
    activeTarget = target;
    activeTarget.classList.add(...highlightClasses);
    highlightTimer = window.setTimeout(clearHighlight, 1500);
  }

  function tabForTarget(target) {
    return target?.closest?.('[data-analytics-panel]')?.dataset.analyticsPanel || '';
  }

  function activateTab(tab, updateHash = false) {
    if (!tabsRoot) return;
    const defaultTab = tabsRoot.dataset.defaultTab || buttons[0]?.dataset.analyticsTab || '';
    const nextTab = available.has(tab) ? tab : defaultTab;
    buttons.forEach((button) => {
      const active = button.dataset.analyticsTab === nextTab;
      button.setAttribute('role', 'tab'); button.setAttribute('aria-selected', String(active)); button.tabIndex = active ? 0 : -1;
    });
    panels.forEach((panel) => panel.classList.toggle('hidden', panel.dataset.analyticsPanel !== nextTab));
    document.querySelector('[data-analytics-controls]')?.toggleAttribute('data-phone-report-hidden', nextTab === 'phones');
    document.querySelector('.analytics-class-keys')?.toggleAttribute('data-phone-report-hidden', nextTab === 'phones');
    document.querySelector('.analytics-download')?.toggleAttribute('data-phone-report-hidden', nextTab === 'phones');
    sessionStorage.setItem(storageKey, nextTab);
    if (updateHash) window.history.replaceState(null, '', `#analytics-${nextTab}`);
    document.dispatchEvent(new CustomEvent('attendance:analytics-tab', { detail: { tab: nextTab } }));
  }

  buttons.forEach((button) => {
    button.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault(); const index = buttons.indexOf(button);
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length;
      activateTab(buttons[next].dataset.analyticsTab, true); buttons[next].focus();
    });
    button.addEventListener('click', () => activateTab(button.dataset.analyticsTab, true));
  });

  if (tabsRoot) {
    const rawHash = window.location.hash.slice(1);
    const targetFromHash = rawHash ? document.getElementById(rawHash) : null;
    const hashTab = rawHash.startsWith('analytics-') ? rawHash.replace('analytics-', '') : tabForTarget(targetFromHash);
    const storedTab = sessionStorage.getItem(storageKey) || '';
    activateTab(available.has(hashTab) ? hashTab : (available.has(storedTab) ? storedTab : tabsRoot.dataset.defaultTab));
  }

  document.addEventListener('click', (event) => {
    const link = event.target.closest('a[data-kpi-card][href^="#"]');
    if (!link) return;
    const targetId = link.getAttribute('href').slice(1);
    const target = document.getElementById(targetId);
    if (!target) return;
    event.preventDefault(); activateTab(tabForTarget(target));
    target.scrollIntoView({ behavior: 'smooth', block: 'start' }); highlightTarget(target);
    window.history.replaceState(null, '', `#${targetId}`);
  });

  if (window.location.hash) {
    const target = document.getElementById(window.location.hash.slice(1));
    if (target) {
      activateTab(tabForTarget(target));
      window.setTimeout(() => highlightTarget(target), 250);
    }
  }
})();

{{#if canViewPhoneAnalytics}}
(() => {
  const panel = document.querySelector('[data-analytics-panel="phones"]');
  if (!panel) return;

  const state = {
    days: 7, from: '', to: '', today: '', classId: '', sort: 'count', search: '', limit: 20,
    data: null, request: null, studentId: '',
  };
  const nf = new Intl.NumberFormat('ru-RU', { maximumFractionDigits: 1 });
  const df = new Intl.DateTimeFormat('ru-RU', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC' });
  const nameOrder = new Intl.Collator('ru-RU', { numeric: true, sensitivity: 'base' });
  const iso = (date) => date.toISOString().slice(0, 10);
  const utcDate = (date) => new Date(date + 'T00:00:00Z');
  const dayMs = 86_400_000;
  const count = (value) => Number(value) || 0;
  const known = (row) => count(row.handed_in) + count(row.not_handed_in);
  const share = (row) => known(row) ? count(row.not_handed_in) / known(row) : null;
  const formatShare = (value) => value === null ? '—' : nf.format(value * 100) + '%';
  const active = () => !panel.classList.contains('hidden');
  const escape = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
    '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;',
  }[char]));

  function todayInMoscow() {
    const parts = Object.fromEntries(new Intl.DateTimeFormat('en-CA', {
      year: 'numeric', month: '2-digit', day: '2-digit', timeZone: 'Europe/Moscow',
    }).formatToParts(new Date()).map(({ type, value }) => [type, value]));
    return `${parts.year}-${parts.month}-${parts.day}`;
  }

  function updateFilters() {
    panel.querySelectorAll('[data-phone-report-preset]').forEach((button) => {
      button.setAttribute('aria-pressed', String(Number(button.dataset.phoneReportPreset) === state.days));
    });
    const dateForm = panel.querySelector('[data-phone-report-dates]');
    dateForm.elements.from.value = state.from;
    dateForm.elements.to.value = state.to;
    dateForm.elements.from.max = dateForm.elements.to.max = state.today || todayInMoscow();
    const select = panel.querySelector('[data-phone-report-class]');
    select.replaceChildren(new Option('Все доступные классы', ''), ...(state.data?.classes || [])
      .map((row) => new Option(row.name, String(row.id))));
    select.value = state.classId;
  }

  function rateDescription(row) {
    const answers = known(row);
    if (!answers) return '—';
    const fraction = `${nf.format(count(row.not_handed_in))} из ${nf.format(answers)}`;
    return `<strong>${fraction}</strong> <span class="text-xs text-slate-600">(${formatShare(share(row))})</span>`;
  }

  function coverageDescription(row) {
    const arrived = count(row.arrived);
    if (!arrived) return '—';
    const answered = count(row.arrival_answered);
    return `<strong>${nf.format(answered)} из ${nf.format(arrived)}</strong> <span class="text-xs text-slate-600">(${formatShare(answered / arrived)})</span>`;
  }

  function renderSubmittedToday() {
    const section = panel.querySelector('[data-phone-today]');
    if (!state.data.today_is_school_day) {
      section.hidden = true;
      return;
    }
    const groups = state.data.submitted_today || [];
    const total = groups.reduce((sum, group) => sum + group.students.length, 0);
    const month = escape(state.today.slice(0, 7));
    section.querySelector('[data-phone-today-count]').textContent = nf.format(total);
    section.querySelector('[data-phone-today-list]').innerHTML = total
      ? groups.map((group) => `
        <div class="mt-3">
          <h3 class="rounded bg-slate-50 px-2 py-1 text-sm font-semibold text-slate-900">
            ${escape(group.name)} <span class="ml-1 font-normal text-slate-600">· ${nf.format(group.students.length)}</span>
          </h3>
          <ul class="divide-y divide-slate-100">${group.students.map((student) => `
            <li>
              <button type="button" data-student-analytics-open data-student-id="${escape(student.id)}" data-student-open-tab="phone" data-student-open-month="${month}"
                class="block min-h-11 w-full break-words rounded px-2 py-2 text-left text-sm font-medium text-blue-700 hover:bg-blue-50">
                ${escape(student.name)}
                ${student.after_notice ? '<span class="block text-xs text-amber-800">Сдал после замечания</span>' : ''}
              </button>
            </li>`).join('')}</ul>
        </div>`).join('')
      : '<p class="pt-3 text-sm text-slate-600">Сегодня пока нет отметок о сдаче телефона.</p>';
    section.hidden = false;
  }

  function renderResults() {
    const results = panel.querySelector('[data-phone-report-results]');
    if (!state.data.school_days.length) {
      results.innerHTML = '<p class="mt-3 rounded-lg bg-slate-50 p-4 text-sm text-slate-700">В выбранном периоде нет очных учебных дней.</p>';
      return;
    }
    const currentClass = state.data.classes.find((row) => String(row.id) === state.classId);
    const totals = currentClass || state.data.totals;
    const pickup = (label, key, tone) => `<span class="rounded-full px-2 py-1 ${tone}">${label}: <strong>${nf.format(count(totals[key]))}</strong></span>`;
    const tile = (label, key, color) => `<div class="workspace-kpi min-w-0"><div class="text-xs font-medium text-slate-700">${label}</div><div class="mt-1 text-2xl font-semibold tabular-nums ${color}">${nf.format(count(totals[key]))}</div></div>`;
    results.innerHTML = `
      <div class="mt-3 grid grid-cols-2 gap-2 sm:grid-cols-4">
        ${tile('Не сдали при приходе', 'not_handed_in', 'text-red-800')}
        ${tile('Сдали после замечания', 'handed_in_after_notice', 'text-amber-800')}
        ${tile('Сдали при приходе', 'handed_in', 'text-emerald-800')}
        ${tile('Нет отметки', 'unknown', 'text-slate-700')}
      </div>
      <dl class="mt-2 grid grid-cols-2 gap-2 rounded-lg border border-slate-200 p-3 text-sm">
        <div><dt class="text-xs text-slate-600">Не сдали из числа ответивших</dt><dd class="mt-1">${rateDescription(totals)}</dd></div>
        <div><dt class="text-xs text-slate-600">Приходы с отметкой о сдаче</dt><dd class="mt-1">${coverageDescription(totals)}</dd></div>
      </dl>
      ${count(totals.answers_without_arrival) ? `<p class="mt-2 text-xs text-slate-600">Отметок о сдаче без отметки о приходе: ${nf.format(totals.answers_without_arrival)}.</p>` : ''}
      ${count(totals.handed_in) + count(totals.handed_in_after_notice) ? `<div class="mt-3 rounded-lg border border-slate-200 p-3">
        <h3 class="text-sm font-semibold text-slate-900">Забрали ли телефоны</h3>
        <div class="mt-2 flex flex-wrap gap-2 text-xs">
          ${pickup('Забрали', 'picked_up', 'bg-emerald-100 text-emerald-800')}
          ${pickup('Не забрали', 'not_picked_up', 'bg-red-100 text-red-800')}
          ${pickup('Нет отметки', 'pickup_unknown', 'bg-slate-100 text-slate-700')}
        </div>
      </div>` : ''}
      <p class="mt-2 text-xs text-slate-600">Одна запись на ученика в день. Сдавшие после замечания входят в число не сдавших при приходе. «Нет отметки» означает, что приход есть, а ответа о сдаче нет. Классы указаны по текущему составу.</p>
      <div class="mb-2 mt-5 flex flex-wrap items-end justify-between gap-2">
        <div>
          <h3 data-phone-report-ranking-title tabindex="-1" class="text-base font-semibold text-slate-950">${currentClass ? `Ученики · ${escape(currentClass.name)}` : 'По классам'}</h3>
          ${currentClass ? '<button type="button" data-phone-report-reset-class class="workspace-link min-h-11 text-sm">Все классы</button>' : ''}
        </div>
        <div class="flex min-w-0 flex-wrap items-end gap-2">
          ${currentClass ? `<label class="min-w-0 text-xs font-medium text-slate-700"><span class="mb-1 block">Поиск ученика</span><input data-phone-report-search type="search" value="${escape(state.search)}" class="min-h-11 max-w-full rounded-md border border-slate-300 px-2 text-sm"></label>` : ''}
          <label class="min-w-0 text-xs font-medium text-slate-700"><span class="mb-1 block">Сортировка</span>
            <select data-phone-report-sort class="min-h-11 max-w-full rounded-md border border-slate-300 px-2 text-sm">
              <option value="count" ${state.sort === 'count' ? 'selected' : ''}>Больше случаев «не сдал»</option>
              <option value="share" ${state.sort === 'share' ? 'selected' : ''}>Выше доля «не сдал»</option>
              <option value="missing" ${state.sort === 'missing' ? 'selected' : ''}>Больше дней без отметки</option>
              <option value="notice" ${state.sort === 'notice' ? 'selected' : ''}>Чаще сдавали после замечания</option>
            </select>
          </label>
        </div>
      </div>
      <div data-phone-report-ranking></div>`;
    renderRanking();
  }

  function renderRanking() {
    const ranking = panel.querySelector('[data-phone-report-ranking]');
    if (!ranking || !state.data) return;
    const byStudent = Boolean(state.classId);
    const query = state.search.trim().toLocaleLowerCase('ru-RU');
    const rows = (byStudent ? state.data.students : state.data.classes)
      .filter((row) => !byStudent || !query || String(row.name).toLocaleLowerCase('ru-RU').includes(query));
    rows.sort((a, b) => {
      const noDifference = count(b.not_handed_in) - count(a.not_handed_in);
      const shareDifference = (share(b) ?? -1) - (share(a) ?? -1);
      const missingDifference = state.sort === 'missing' ? count(b.unknown) - count(a.unknown) : 0;
      const noticeDifference = state.sort === 'notice' ? count(b.handed_in_after_notice) - count(a.handed_in_after_notice) : 0;
      return noticeDifference || missingDifference || (state.sort === 'share' ? shareDifference || noDifference : noDifference || shareDifference) ||
        nameOrder.compare(a.name, b.name);
    });
    if (!rows.length) {
      const empty = query ? 'Ученики не найдены.' : 'За выбранный период нет данных.';
      ranking.innerHTML = `<p class="rounded-lg bg-slate-50 p-4 text-sm text-slate-600">${empty}</p>`;
      return;
    }
    const headers = [byStudent ? 'Ученик' : 'Класс', 'Не сдали при приходе', 'Не сдали из числа ответивших', 'После замечания', 'Сдали при приходе', 'Нет отметки', 'Приходы с отметкой о сдаче'];
    const cell = (index, content, classes = '') => `<td role="cell" data-label="${headers[index]}" class="${classes}">${content}</td>`;
    const displayed = byStudent ? rows.slice(0, state.limit) : rows;
    ranking.innerHTML = `
      <table class="phone-report-table text-sm" role="table" aria-label="${byStudent ? 'Сдача телефонов по ученикам' : 'Сдача телефонов по классам'}">
        <thead role="rowgroup"><tr role="row">${headers.map((label) => `<th scope="col" role="columnheader">${label}</th>`).join('')}</tr></thead>
        <tbody role="rowgroup">${displayed.map((row) => {
          const open = byStudent
            ? `data-student-analytics-open data-student-id="${escape(row.id)}" data-student-open-tab="phone" data-student-open-month="${escape(state.data.to.slice(0, 7))}"`
            : `data-phone-report-drilldown="${escape(row.id)}"`;
          return `<tr role="row">
            <td role="cell"><button type="button" ${open} class="workspace-link min-h-11 text-left font-semibold">${escape(row.name)}</button></td>
            ${cell(1, nf.format(count(row.not_handed_in)), 'font-semibold text-red-800')}
            ${cell(2, rateDescription(row))}
            ${cell(3, nf.format(count(row.handed_in_after_notice)), 'text-amber-800')}
            ${cell(4, nf.format(count(row.handed_in)), 'text-emerald-800')}
            ${cell(5, nf.format(count(row.unknown)))}
            ${cell(6, coverageDescription(row))}
          </tr>`;
        }).join('')}</tbody>
      </table>
      ${displayed.length < rows.length ? `<button type="button" data-phone-report-more class="workspace-secondary mt-3 min-h-11">Показать ещё · ${nf.format(displayed.length)} из ${nf.format(rows.length)}</button>` : ''}`;
  }

  async function load({ background = false, focusRanking = false, focusStudentId = '' } = {}) {
    state.request?.abort();
    const request = new AbortController();
    state.request = request;
    const error = panel.querySelector('[data-phone-report-error]');
    const status = panel.querySelector('[data-phone-report-status]');
    const results = panel.querySelector('[data-phone-report-results]');
    error.hidden = true;
    panel.setAttribute('aria-busy', 'true');
    status.textContent = background ? 'Обновляем данные…' : 'Загружаем данные…';
    if (!background) {
      results.replaceChildren();
      panel.querySelector('[data-phone-today]').hidden = true;
    }
    const params = new URLSearchParams();
    if (state.from && state.to) { params.set('from', state.from); params.set('to', state.to); }
    if (state.classId) params.set('class', state.classId);
    try {
      const response = await fetch(`/api/attendance/analytics/phones?${params}`, {
        cache: 'no-store', headers: { Accept: 'application/json' }, signal: request.signal,
      });
      const data = await response.json().catch(() => null);
      if (!response.ok || !data?.totals) throw new Error(data?.message || 'Не удалось загрузить данные о телефонах.');
      if (state.request !== request) return;
      state.data = data;
      state.from = data.from;
      state.to = data.to;
      state.today = data.today || todayInMoscow();
      const todayList = panel.querySelector('[data-phone-today]');
      const focusRegion = todayList.contains(document.activeElement) ? todayList : results;
      const restoreFocus = active() && focusStudentId && (focusRegion.contains(document.activeElement) || document.activeElement === document.body);
      panel.querySelector('[data-phone-report-scope]').textContent = data.scope === 'school' ? 'Вся школа' : 'Доступные ученики';
      const dateLabel = data.from === data.to ? df.format(utcDate(data.from)) : df.formatRange(utcDate(data.from), utcDate(data.to));
      status.textContent = `${dateLabel} · Очных учебных дней: ${nf.format(data.school_days.length)}`;
      updateFilters();
      renderSubmittedToday();
      renderResults();
      if (active() && focusRanking) panel.querySelector('[data-phone-report-ranking-title]')?.focus();
      if (restoreFocus) {
        const button = [...focusRegion.querySelectorAll('[data-student-analytics-open]')]
          .find((item) => item.dataset.studentId === focusStudentId);
        (button || (focusRegion === todayList ? todayList.querySelector('summary') : null))?.focus({ preventScroll: true });
      }
    } catch (err) {
      if (state.request !== request || err.name === 'AbortError') return;
      status.textContent = '';
      error.querySelector('[data-phone-report-error-text]').textContent = err.message;
      error.hidden = false;
    } finally {
      if (state.request === request) {
        state.request = null;
        panel.removeAttribute('aria-busy');
      }
    }
  }

  function chooseClass(classId, focusRanking = false) {
    state.classId = classId;
    state.search = '';
    state.limit = 20;
    const select = panel.querySelector('[data-phone-report-class]');
    select.value = classId;
    select.dispatchEvent(new Event('input'));
    load({ focusRanking });
  }

  panel.addEventListener('click', (event) => {
    const preset = event.target.closest('[data-phone-report-preset]');
    if (preset) {
      state.days = Number(preset.dataset.phoneReportPreset);
      state.to = state.today || todayInMoscow();
      state.from = iso(new Date(utcDate(state.to).getTime() - (state.days - 1) * dayMs));
      updateFilters();
      load();
      return;
    }
    const drilldown = event.target.closest('[data-phone-report-drilldown]');
    if (drilldown) chooseClass(drilldown.dataset.phoneReportDrilldown, true);
    if (event.target.closest('[data-phone-report-reset-class]')) chooseClass('', true);
    if (event.target.closest('[data-phone-report-retry]')) load();
    if (event.target.closest('[data-phone-report-more]')) {
      const before = state.limit;
      state.limit += 20;
      renderRanking();
      panel.querySelectorAll('[data-phone-report-ranking] [data-student-analytics-open]')[before]?.focus();
    }
    const student = event.target.closest('[data-student-analytics-open]');
    if (student) state.studentId = student.dataset.studentId;
  });
  panel.addEventListener('change', (event) => {
    if (event.target.matches('[data-phone-report-class]')) chooseClass(event.target.value);
    if (event.target.matches('[data-phone-report-sort]')) {
      state.sort = event.target.value;
      state.limit = 20;
      renderRanking();
    }
  });
  panel.addEventListener('input', (event) => {
    if (!event.target.matches('[data-phone-report-search]')) return;
    state.search = event.target.value;
    state.limit = 20;
    renderRanking();
  });
  panel.addEventListener('submit', (event) => {
    if (!event.target.matches('[data-phone-report-dates]')) return;
    event.preventDefault();
    const { from, to } = Object.fromEntries(new FormData(event.target));
    const error = event.target.querySelector('[data-phone-report-date-error]');
    const days = 1 + (utcDate(to) - utcDate(from)) / dayMs;
    error.textContent = days < 1 ? 'Дата начала позже даты окончания.' : days > 90 ? 'Выберите период до 90 дней.' : '';
    error.hidden = !error.textContent;
    if (!error.hidden) return;
    state.days = null;
    state.from = from;
    state.to = to;
    event.target.closest('details').open = false;
    event.target.closest('details').querySelector('summary').focus();
    updateFilters();
    load();
  });
  document.addEventListener('attendance:analytics-tab', (event) => {
    if (event.detail.tab === 'phones' && !state.data && !state.request) load();
  });
  document.addEventListener('attendance:analytics-refreshed', () => {
    if (active()) { updateFilters(); load(); }
    else state.data = null;
  });
  document.getElementById('student-analytics-dialog')?.addEventListener('close', () => {
    if (active() && state.studentId) load({ background: true, focusStudentId: state.studentId });
    state.studentId = '';
  });
  updateFilters();
  if (active()) load();
})();
