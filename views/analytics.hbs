<link rel="stylesheet" href="/assets/attendance-analytics.css">
<style>
  .staff-person { border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
  .staff-person summary { cursor: pointer; padding: 14px; display: flex; align-items: center; justify-content: space-between; gap: 16px; background: #f8fafc; }
  .staff-person summary::before { content: '▸'; color: #64748b; }
  .staff-person[open] summary::before { content: '▾'; }
  .staff-person summary > span:first-of-type { flex: 1; }
  .staff-counts { display: flex; gap: 18px; font-size: 13px; flex-wrap: wrap; }
  .staff-late-text { color: #b91c1c; }
  .staff-days th, .staff-days td { padding: 10px; text-align: left; border-bottom: 1px solid #e2e8f0; }
  .staff-days th { font-size: 12px; color: #64748b; }
  .staff-days [data-status="late"] { background: #fff1f2; color: #9f1239; box-shadow: inset 3px 0 #e11d48; }
  .staff-days [data-status="on_time"] { background: #f0fdf4; }
  .staff-days [data-status="no_arrival"] { background: #fffbeb; }
  .staff-days [data-status="future"] { color: #94a3b8; }
  @media (max-width: 640px) { .staff-person summary { flex-wrap: wrap; gap: 8px; } .staff-counts { width: 100%; gap: 8px 16px; } }
  @media (max-width: 640px) {
    .staff-days thead { display: none; }
    .staff-days tbody { display: block; }
    .staff-days tr { display: grid; grid-template-columns: 1fr 1fr; margin-bottom: 12px; border: 1px solid #e2e8f0; }
    .staff-days td:first-child, .staff-days td:last-child, .staff-days td:nth-child(4) { grid-column: 1 / -1; }
    .staff-days td[data-label]::before { content: attr(data-label); display: block; font-size: 11px; color: #64748b; margin-bottom: 3px; }
  }
  #student-analytics-dialog::backdrop { background: rgba(15, 23, 42, 0.45); }
  #student-export-form[hidden], #student-export-form [hidden], [data-student-export-toggle][hidden] { display: none; }
  #student-export-form { max-height: 45dvh; overflow-y: auto; overscroll-behavior: contain; }
  [data-phone-report-hidden] { display: none !important; }
  [data-phone-report-preset][aria-pressed="true"] { background: #dbeafe; border-color: #93c5fd; color: #1e40af; }
  .phone-report-table { width: 100%; border-collapse: collapse; text-align: left; }
  .phone-report-table th, .phone-report-table td { padding: .625rem .5rem; border-bottom: 1px solid #e2e8f0; }
  .phone-report-table th { color: #475569; font-size: .75rem; font-weight: 600; }
  .phone-report-table td { font-variant-numeric: tabular-nums; }
  .phone-report-table td:first-child { min-width: 9rem; overflow-wrap: anywhere; }
  @media (max-width: 850px) {
    .phone-report-table thead { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); }
    .phone-report-table tbody { display: grid; gap: .625rem; }
    .phone-report-table tr { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); border: 1px solid #e2e8f0; border-radius: .5rem; padding: .5rem .625rem; }
    .phone-report-table td { min-width: 0; border: 0; padding: .25rem .375rem; }
    .phone-report-table td:first-child { grid-column: 1 / -1; padding-block: 0; }
    .phone-report-table td[data-label]::before { content: attr(data-label); display: block; color: #475569; font-size: .75rem; }
  }
  @media print {
    .no-print { display: none !important; }
    body { background: #fff !important; }
    main { max-width: none !important; padding: 0 !important; }
    .shadow, .shadow-sm, .shadow-lg { box-shadow: none !important; }
  }
</style>

<section class="analytics-workspace">
  <div class="workspace-surface analytics-top">
    <div class="analytics-toolbar">
      <div>
        <h1 class="workspace-title">Аналитика посещаемости</h1>
        {{#if analytics.is_adult}}<div class="analytics-context">{{analytics.month_label}} · {{analytics.department_name}}</div>{{/if}}
      </div>

      <form id="analytics-controls" method="get" action="/attendance/analytics" data-analytics-controls class="no-print analytics-controls">
        <input type="hidden" name="audience" value="{{audience}}" />
        {{#if analytics.is_adult}}
        <label class="text-sm text-gray-700"><span class="block mb-1">С</span><input required name="from" value="{{analytics.period.from}}" type="date" class="w-full rounded border-gray-300" /></label>
        <label class="text-sm text-gray-700"><span class="block mb-1">По</span><input required name="to" value="{{analytics.period.to}}" type="date" class="w-full rounded border-gray-300" /></label>
          <label class="analytics-department text-sm text-gray-700">
            <span class="block mb-1">Кафедра</span>
            <select name="department" class="w-full sm:w-52 rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">
              {{#each departmentOptions}}
                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
          </label>
          <button type="submit" class="workspace-primary">Показать</button>
        {{else}}
          <label class="text-sm text-gray-700">
            <span class="mb-1 block">Месяц</span>
            <input name="month" value="{{analytics.month}}" type="month" class="w-full" />
          </label>
          <noscript><button type="submit" class="workspace-primary">Показать</button></noscript>
        {{/if}}
      </form>
        <details class="analytics-download no-print">
          <summary>Отчёт</summary>
          <div>
            <button type="button" data-export-analytics class="workspace-link">Скачать CSV</button>
            <button type="button" data-print-analytics class="workspace-link">Распечатать</button>
          </div>
        </details>
      {{#unless analytics.is_adult}}
        <div class="analytics-class-keys no-print">
          <label class="sr-only" for="analytics-class-filter">Класс</label>
          <select id="analytics-class-filter" name="class" form="analytics-controls" data-class-keyboard="Класс">
            {{#each classOptions}}
              <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
            {{/each}}
          </select>
        </div>
      {{/unless}}
    </div>

    {{#if audienceTabs.length}}
      <div class="no-print flex flex-wrap gap-2 border-b border-gray-200">
        {{#each audienceTabs}}
          <a href="{{href}}" class="rounded-t border border-b-0 px-3 py-2 text-sm font-medium {{#if active}}bg-white border-gray-200 text-gray-900 shadow-sm{{else}}border-transparent bg-gray-50 text-gray-600 hover:bg-white{{/if}}">{{#if (eq id "adults")}}Сотрудники{{else}}Ученики{{/if}}</a>
        {{/each}}
      </div>
    {{/if}}

    {{#if analytics.is_adult}}
    <div data-class-kpis class="analytics-metrics">
      {{#each kpiCards}}
        {{#if href}}
          <a href="{{href}}" data-kpi-card data-target-id="{{target_id}}" class="workspace-kpi analytics-metric analytics-metric-link">
            <div class="text-xs text-gray-500">{{label}}</div>
            <div class="mt-1 text-2xl font-semibold text-gray-900">{{value}}</div>
            {{#if hint}}<div class="mt-1 text-xs text-gray-500">{{hint}}</div>{{/if}}
            {{#if details}}
              <div class="mt-2 flex flex-wrap gap-1">
                {{#each details}}
                  <span class="rounded-full px-2 py-0.5 text-[11px] font-medium {{tone_class}}">{{label}}</span>
                {{/each}}
              </div>
            {{/if}}
            <div class="mt-2 text-xs font-medium text-indigo-700">{{action_label}}</div>
          </a>
        {{else}}
          <div class="workspace-kpi analytics-metric">
            <div class="text-xs text-gray-500">{{label}}</div>
            <div class="mt-1 text-2xl font-semibold text-gray-900">{{value}}</div>
            {{#if hint}}<div class="mt-1 text-xs text-gray-500">{{hint}}</div>{{/if}}
            {{#if details}}
              <div class="mt-2 flex flex-wrap gap-1">
                {{#each details}}
                  <span class="rounded-full px-2 py-0.5 text-[11px] font-medium {{tone_class}}">{{label}}</span>
                {{/each}}
              </div>
            {{/if}}
          </div>
        {{/if}}
      {{/each}}
    </div>
    {{/if}}
  </div>

  {{#if analytics.is_adult}}
    <div class="space-y-4">
      <section id="adult-people" class="workspace-surface p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-base font-semibold text-gray-900">Сотрудники <span class="text-gray-500">{{analytics.people.length}}</span></h2>
          <div class="no-print flex flex-wrap items-center gap-3">
            <a href="/attendance/mentor-schedule?week={{analytics.period.to}}#mentor-work-report" class="workspace-link text-sm font-medium">Часы наставников за последнюю неделю периода</a>
            <input type="search" data-staff-search aria-label="Поиск сотрудника" placeholder="Найти сотрудника" class="rounded border-gray-300" />
            <select data-staff-sort aria-label="Сортировка сотрудников" class="rounded border-gray-300 text-sm">
              <option value="late-desc">Время опозданий: сначала больше</option>
              <option value="late-asc">Время опозданий: сначала меньше</option>
              <option value="name">По имени</option>
            </select>
            <label class="text-sm"><input type="checkbox" data-staff-late /> Только с опозданиями</label>
          </div>
        </div>
        <div class="mt-3 text-xs text-gray-500">Приход наставников сверяется с опубликованной сменой, остальных сотрудников — с первым очным уроком. Время московское.</div>
        <div class="mt-3 space-y-2">
          {{#each analytics.people}}
          <details class="staff-person" data-person-id="{{person_id}}" data-person-name="{{person_name}}" data-late-days="{{late_days}}">
            <summary>
              <span><strong>{{person_name}}</strong><span class="block text-xs text-gray-500">{{department_name}}</span></span>
              <span class="staff-counts"><span>Приходов: <b>{{arrival_days}}</b></span><span class="{{#if late_days}}staff-late-text{{/if}}">Опозданий: <b>{{late_days}}</b>{{#if late_days}} · {{total_late_minutes}} мин.{{/if}}</span><span>{{#if is_mentor}}Смен без прихода{{else}}Без прихода к уроку{{/if}}: <b>{{no_arrival_days}}</b></span></span>
            </summary>
            <div class="p-3 border-t">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3"><span class="text-sm text-gray-600">{{../analytics.month_label}} · Вовремя: {{on_time_days}}</span><button type="button" class="workspace-secondary no-print" data-staff-export="{{person_id}}">CSV сотрудника</button></div>
              <div class="overflow-x-auto">
                <table class="staff-days min-w-full text-sm">
                  <thead><tr><th>Дата</th><th>Пришёл</th><th>Ушёл</th><th>{{#if is_mentor}}Смена по графику{{else}}Первый очный урок{{/if}}</th><th>Статус</th></tr></thead>
                  <tbody data-staff-days></tbody>
                </table>
              </div>
            </div>
          </details>
          {{else}}<p class="text-sm text-gray-500">Сотрудники не найдены.</p>{{/each}}
          <p data-staff-empty hidden class="text-sm text-gray-500">По выбранным условиям сотрудников нет.</p>
        </div>
      </section>

      <details id="adult-departments" class="workspace-surface p-4">
        <summary class="font-semibold cursor-pointer">Кафедры · {{analytics.departments.length}}</summary>
        {{#if analytics.departments.length}}
          <div class="mt-2 min-w-0">
            <table role="table" class="analytics-report-table min-w-full text-sm">
              <thead role="rowgroup" class="text-xs text-gray-500">
                <tr role="row" class="border-b">
                  <th scope="col" role="columnheader" class="py-2 pr-3 text-left font-medium">Кафедра</th>
                  <th scope="col" role="columnheader" class="py-2 pr-3 text-right font-medium">Сотрудники</th>
                  <th scope="col" role="columnheader" class="py-2 pr-3 text-right font-medium">Пришли сегодня</th>
                  <th scope="col" role="columnheader" class="py-2 pr-3 text-right font-medium">Ушли сегодня</th>
                  <th scope="col" role="columnheader" class="py-2 pr-3 text-right font-medium">Дней с приходом</th>
                  <th scope="col" role="columnheader" class="py-2 pr-3 text-right font-medium">Дней отсутствия</th>
                  <th scope="col" role="columnheader" class="py-2 text-right font-medium">Нужно проверить</th>
                </tr>
              </thead>
              <tbody role="rowgroup" class="divide-y divide-gray-100">
                {{#each analytics.departments}}
                  <tr role="row" class="hover:bg-indigo-50">
                    <td role="cell" data-report-primary class="py-2 pr-3 align-top font-medium text-gray-900">{{department_name}}</td>
                    <td role="cell" data-label="Сотрудники" class="py-2 pr-3 align-top text-right text-gray-700">{{people_total}}</td>
                    <td role="cell" data-label="Пришли сегодня" class="py-2 pr-3 align-top text-right text-emerald-700">{{present_today}}</td>
                    <td role="cell" data-label="Ушли сегодня" class="py-2 pr-3 align-top text-right text-gray-700">{{departed_today}}</td>
                    <td role="cell" data-label="Дней с приходом" class="py-2 pr-3 align-top text-right text-gray-700">{{present_days}}</td>
                    <td role="cell" data-label="Дней отсутствия" class="py-2 pr-3 align-top text-right text-gray-700">{{absence_days}}</td>
                    <td role="cell" data-label="Нужно проверить" class="py-2 align-top text-right {{#if needs_attention}}text-red-700{{else}}text-gray-500{{/if}}">{{needs_attention}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="mt-3 rounded border border-gray-200 bg-gray-50 p-4 text-sm text-gray-500">Сотрудники не найдены.</div>
        {{/if}}
      </details>

      <section id="adult-today-absences" class="workspace-surface p-4">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
          <h2 class="text-base font-semibold text-gray-900">Отсутствующие сегодня</h2>
          <span class="text-sm text-gray-500">{{analytics.class_summary.absent_today_label}}</span>
        </div>
        {{#if analytics.today_absences.students}}
          <div class="mt-2 min-w-0">
            <table role="table" class="analytics-report-table min-w-full text-sm">
              <thead role="rowgroup" class="text-xs text-gray-500">
                <tr role="row" class="border-b">
                  <th scope="col" role="columnheader" class="py-2 pr-3 text-left font-medium">Кафедра</th>
                  <th scope="col" role="columnheader" class="py-2 pr-3 text-left font-medium">Сотрудник</th>
                  <th scope="col" role="columnheader" class="py-2 pr-3 text-left font-medium">Период</th>
                  <th scope="col" role="columnheader" class="py-2 text-left font-medium">Причина</th>
                </tr>
              </thead>
              <tbody role="rowgroup" class="divide-y divide-gray-100">
                {{#each analytics.today_absences.students}}
                  <tr role="row" class="hover:bg-indigo-50">
                    <td role="cell" data-label="Кафедра" class="py-2 pr-3 align-top text-gray-600">{{class_name}}</td>
                    <td role="cell" data-report-primary class="py-2 pr-3 align-top font-medium text-gray-900">{{student_name}}</td>
                    <td role="cell" data-label="Период" class="py-2 pr-3 align-top text-gray-700">{{today_period_label}}</td>
                    <td role="cell" data-label="Причина" class="py-2 align-top text-gray-700">
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700">{{reason_name}}</span>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="mt-3 rounded border border-gray-200 bg-gray-50 p-4 text-sm text-gray-500">Отсутствующих сотрудников сегодня нет.</div>
        {{/if}}
      </section>


    </div>
  {{else}}
    <div data-analytics-tabs data-default-tab="summary" class="analytics-sections">
      <div role="tablist" aria-label="Разделы аналитики" class="no-print analytics-tabs">
        <button type="button" id="analytics-summary-tab" data-analytics-tab="summary" aria-controls="analytics-summary">Сводка</button>
        <button type="button" id="analytics-journal-tab" data-analytics-tab="journal" aria-controls="attendance-journal">Журнал</button>
        <button type="button" id="analytics-lessons-tab" data-analytics-tab="lessons" aria-controls="learning-analytics">Уроки</button>
        <button type="button" id="analytics-lateness-tab" data-analytics-tab="lateness" aria-controls="lateness-analytics">Опоздания</button>
        <button type="button" id="analytics-calendar-tab" data-analytics-tab="calendar" aria-controls="absence-calendar">Календарь</button>
        <button type="button" id="analytics-classes-tab" data-analytics-tab="classes" aria-controls="classes-breakdown">Классы</button>
        {{#if canViewPhoneAnalytics}}<button type="button" id="analytics-phones-tab" data-analytics-tab="phones" aria-controls="phone-report">Телефоны</button>{{/if}}
      </div>

      <section data-analytics-panel="summary" id="analytics-summary" role="tabpanel" aria-labelledby="analytics-summary-tab" tabindex="0" class="analytics-summary">
        <div id="today-absences" class="workspace-surface analytics-box">
          <div class="analytics-section-heading">
            <h2 class="analytics-heading">Кто отсутствует сегодня <span>{{analytics.class_summary.absent_today_label}}</span></h2>
            <a href="#attendance-journal" data-kpi-card data-target-id="attendance-journal" class="analytics-text-action">Открыть журнал</a>
          </div>
          {{#if analytics.today_absences.students}}
            <div class="mt-2 min-w-0 analytics-today-list"{{#if (gt analytics.today_absences.students.length 3)}} tabindex="0" role="region" aria-label="Список отсутствующих сегодня"{{/if}}>
              <table role="table" class="analytics-report-table min-w-full text-sm">
                <thead role="rowgroup" class="text-xs text-gray-500">
                  <tr role="row" class="border-b">
                    <th scope="col" role="columnheader" class="py-2 pr-3 text-left font-medium">Класс</th>
                    <th scope="col" role="columnheader" class="py-2 pr-3 text-left font-medium">Ученик</th>
                    <th scope="col" role="columnheader" class="py-2 pr-3 text-left font-medium">Период</th>
                    <th scope="col" role="columnheader" class="py-2 text-left font-medium">Причина</th>
                  </tr>
                </thead>
                <tbody role="rowgroup" class="divide-y divide-gray-100">
                  {{#each analytics.today_absences.students}}
                    <tr role="row" class="hover:bg-indigo-50">
                      <td role="cell" data-label="Класс" class="py-2 pr-3 align-top text-gray-600">{{class_name}}</td>
                      <td role="cell" data-report-primary class="py-2 pr-3 align-top font-medium text-gray-900">
                        <a href="/attendance/analytics?class={{class_id}}&month={{@root.analytics.month}}&student={{student_id}}&tab=history" data-student-analytics-open data-student-id="{{student_id}}" data-student-open-tab="history" class="hover:text-indigo-700">{{student_name}}</a>
                      </td>
                      <td role="cell" data-label="Период" class="py-2 pr-3 align-top text-gray-700">
                        <span>{{today_period_label}}</span>
                        {{#if period_count_label}}
                          <span class="ml-1 rounded-full bg-gray-100 px-1.5 py-0.5 text-xs text-gray-600">{{period_count_label}}</span>
                        {{/if}}
                      </td>
                      <td role="cell" data-label="Причина" class="py-2 align-top text-gray-700">
                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700">{{reason_name}}</span>
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else if analytics.today_absences.is_weekend}}
            <p class="mt-3 text-sm text-slate-600">Сегодня выходной. Уроков нет.</p>
          {{else}}
            <div class="mt-3 rounded border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-700">На сегодня нет отметок об отсутствии.</div>
          {{/if}}
        </div>

        <section class="workspace-surface analytics-box" aria-labelledby="analytics-month-heading">
          <h2 id="analytics-month-heading" class="analytics-heading">За месяц <span>{{analytics.month_label}}</span></h2>
          <div data-class-kpis class="analytics-metrics">
            {{#each kpiCards}}
              {{#if href}}
                <a href="{{href}}" data-kpi-card data-target-id="{{target_id}}" class="workspace-kpi analytics-metric analytics-metric-link">
                  <div class="text-xs text-gray-500">{{label}}</div>
                  <div class="mt-1 text-2xl font-semibold text-gray-900">{{value}}</div>
                  {{#if hint}}<div class="mt-1 text-xs text-gray-500">{{hint}}</div>{{/if}}
                  {{#if details}}
                    <div class="mt-2 flex flex-wrap gap-1">
                      {{#each details}}
                        <span class="rounded-full px-2 py-0.5 text-[11px] font-medium {{tone_class}}">{{label}}</span>
                      {{/each}}
                    </div>
                  {{/if}}
                </a>
              {{else}}
                <div class="workspace-kpi analytics-metric">
                  <div class="text-xs text-gray-500">{{label}}</div>
                  <div class="mt-1 text-2xl font-semibold text-gray-900">{{value}}</div>
                  {{#if hint}}<div class="mt-1 text-xs text-gray-500">{{hint}}</div>{{/if}}
                  {{#if details}}
                    <div class="mt-2 flex flex-wrap gap-1">
                      {{#each details}}
                        <span class="rounded-full px-2 py-0.5 text-[11px] font-medium {{tone_class}}">{{label}}</span>
                      {{/each}}
                    </div>
                  {{/if}}
                </div>
              {{/if}}
            {{/each}}
          </div>
          {{#if analytics.kpi.scheduled_minutes}}
            <div class="analytics-attendance-bar" role="img" aria-label="Посещаемость {{analytics.kpi.attendance_percent}} процентов">
              <span style="width: {{analytics.kpi.attendance_percent}}%"></span>
            </div>
          {{else}}<p class="analytics-note">За выбранный месяц нет учебного времени, по которому можно посчитать посещаемость.</p>{{/if}}
        </section>

        {{#if analytics.quality.has_issues}}
          <div id="data-quality" class="workspace-surface analytics-box">
            <h2 class="analytics-heading">Что проверить за месяц</h2>
            <dl class="analytics-review">
              {{#each analytics.quality.issues}}
                <div>
                  <dt>{{#if (eq code "without_reason")}}Отметки без причины{{else if (eq code "needs_attention")}}Отметки, требующие проверки{{else if (eq code "attendance_conflict")}}Случаи, когда отметки расходятся{{else if (eq code "schedule_gap")}}Случаи без расписания для ученика{{else}}{{label}}{{/if}}</dt>
                  <dd>{{value}}</dd>
                </div>
              {{/each}}
            </dl>
