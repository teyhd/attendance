<style>
  .staff-person { border: 1px solid #e2e8f0; border-radius: 10px; overflow: hidden; }
  .staff-person summary { cursor: pointer; padding: 14px; display: flex; align-items: center; justify-content: space-between; gap: 16px; background: #f8fafc; }
  .staff-person summary::before { content: '▸'; color: #64748b; }
  .staff-person[open] summary::before { content: '▾'; }
  .staff-person summary > span:first-of-type { flex: 1; }
  .staff-counts { display: flex; gap: 18px; font-size: 13px; flex-wrap: wrap; }
  .staff-late-text { color: #b91c1c; }
  .staff-days th, .staff-days td { padding: 10px; text-align: left; border-bottom: 1px solid #e2e8f0; }
  .staff-days th { font-size: 12px; color: #64748b; }
  .staff-days [data-status="late"] { background: #fff1f2; color: #9f1239; box-shadow: inset 3px 0 #e11d48; }
  .staff-days [data-status="on_time"] { background: #f0fdf4; }
  .staff-days [data-status="no_arrival"] { background: #fffbeb; }
  .staff-days [data-status="future"] { color: #94a3b8; }
  @media (max-width: 640px) { .staff-person summary { flex-wrap: wrap; gap: 8px; } .staff-counts { width: 100%; gap: 8px 16px; } }
  @media (max-width: 640px) {
    .staff-days thead { display: none; }
    .staff-days tbody { display: block; }
    .staff-days tr { display: grid; grid-template-columns: 1fr 1fr; margin-bottom: 12px; border: 1px solid #e2e8f0; }
    .staff-days td:first-child, .staff-days td:last-child, .staff-days td:nth-child(4) { grid-column: 1 / -1; }
    .staff-days td[data-label]::before { content: attr(data-label); display: block; font-size: 11px; color: #64748b; margin-bottom: 3px; }
  }
  #student-analytics-dialog::backdrop { background: rgba(15, 23, 42, 0.45); }
  @media print {
    .no-print { display: none !important; }
    body { background: #fff !important; }
    main { max-width: none !important; padding: 0 !important; }
    .shadow, .shadow-sm, .shadow-lg { box-shadow: none !important; }
  }
</style>

<section class="space-y-4">
  <div class="workspace-surface p-4 space-y-4">
    <div class="flex flex-col lg:flex-row lg:items-end lg:justify-between gap-3">
      <div>
        <h1 class="workspace-title">Аналитика</h1>
        <div class="mt-1 text-sm text-gray-600">{{analytics.month_label}} · {{#if analytics.is_adult}}{{analytics.department_name}}{{else}}{{analytics.class_name}}{{/if}}</div>
      </div>

      <form method="get" action="/attendance/analytics" data-analytics-controls class="no-print grid grid-cols-2 gap-3 sm:flex sm:flex-wrap sm:items-end">
        <input type="hidden" name="audience" value="{{audience}}" />
        {{#if analytics.is_adult}}
        <label class="text-sm text-gray-700"><span class="block mb-1">С</span><input required name="from" value="{{analytics.period.from}}" type="date" class="w-full rounded border-gray-300" /></label>
        <label class="text-sm text-gray-700"><span class="block mb-1">По</span><input required name="to" value="{{analytics.period.to}}" type="date" class="w-full rounded border-gray-300" /></label>
        <button type="submit" class="workspace-primary" style="align-self: end">Показать</button>
        {{else}}
        <label class="order-2 text-sm text-gray-700">
          <span class="block mb-1">Месяц</span>
          <input name="month" value="{{analytics.month}}" type="month" class="w-full sm:w-40 rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" />
        </label>
        {{/if}}
        {{#if analytics.is_adult}}
          <label class="text-sm text-gray-700">
            <span class="block mb-1">Кафедра</span>
            <select name="department" class="w-full sm:w-52 rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">
              {{#each departmentOptions}}
                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
          </label>
        {{else}}
          <label class="order-1 text-sm text-gray-700">
            <span class="block mb-1">Класс</span>
            <select name="class" class="w-full sm:w-44 rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">
              {{#each classOptions}}
                <option value="{{id}}" {{#if selected}}selected{{/if}}>{{name}}</option>
              {{/each}}
            </select>
          </label>
        {{/if}}
        <button type="button" data-print-analytics class="workspace-secondary order-3">Печать</button>
        <button type="button" data-export-analytics class="workspace-secondary order-4">CSV</button>
      </form>
    </div>

    {{#if audienceTabs.length}}
      <div class="no-print flex flex-wrap gap-2 border-b border-gray-200">
        {{#each audienceTabs}}
          <a href="{{href}}" class="rounded-t border border-b-0 px-3 py-2 text-sm font-medium {{#if active}}bg-white border-gray-200 text-gray-900 shadow-sm{{else}}border-transparent bg-gray-50 text-gray-600 hover:bg-white{{/if}}">{{label}}</a>
        {{/each}}
      </div>
    {{/if}}

    {{#if analytics.is_adult}}
    <div data-class-kpis class="grid grid-cols-2 gap-2 sm:grid-cols-3 xl:grid-cols-5">
      {{#each kpiCards}}
        {{#if href}}
          <a href="{{href}}" data-kpi-card data-target-id="{{target_id}}" class="workspace-kpi block transition hover:border-blue-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2">
            <div class="text-xs text-gray-500">{{label}}</div>
            <div class="mt-1 text-2xl font-semibold text-gray-900">{{value}}</div>
            {{#if hint}}<div class="mt-1 text-xs text-gray-500">{{hint}}</div>{{/if}}
            {{#if details}}
              <div class="mt-2 flex flex-wrap gap-1">
                {{#each details}}
                  <span class="rounded-full px-2 py-0.5 text-[11px] font-medium {{tone_class}}">{{label}}</span>
                {{/each}}
              </div>
            {{/if}}
            <div class="mt-2 text-xs font-medium text-indigo-700">{{action_label}}</div>
          </a>
        {{else}}
          <div class="workspace-kpi">
            <div class="text-xs text-gray-500">{{label}}</div>
            <div class="mt-1 text-2xl font-semibold text-gray-900">{{value}}</div>
            {{#if hint}}<div class="mt-1 text-xs text-gray-500">{{hint}}</div>{{/if}}
            {{#if details}}
              <div class="mt-2 flex flex-wrap gap-1">
                {{#each details}}
                  <span class="rounded-full px-2 py-0.5 text-[11px] font-medium {{tone_class}}">{{label}}</span>
                {{/each}}
              </div>
            {{/if}}
          </div>
        {{/if}}
      {{/each}}
    </div>
    {{/if}}
  </div>

  {{#if analytics.is_adult}}
    <div class="space-y-4">
      <section id="adult-people" class="workspace-surface p-4">
        <div class="flex flex-wrap items-center justify-between gap-3">
          <h2 class="text-base font-semibold text-gray-900">Сотрудники <span class="text-gray-500">{{analytics.people.length}}</span></h2>
          <div class="no-print flex flex-wrap items-center gap-3">
            <input type="search" data-staff-search aria-label="Поиск сотрудника" placeholder="Найти сотрудника" class="rounded border-gray-300" />
            <select data-staff-sort aria-label="Сортировка сотрудников" class="rounded border-gray-300 text-sm">
              <option value="late-desc">Время опозданий: сначала больше</option>
              <option value="late-asc">Время опозданий: сначала меньше</option>
              <option value="name">По имени</option>
            </select>
            <label class="text-sm"><input type="checkbox" data-staff-late /> Только с опозданиями</label>
          </div>
        </div>
        <div class="mt-3 text-xs text-gray-500">Первый приход и первый назначенный очный урок · московское время</div>
        <div class="mt-3 space-y-2">
          {{#each analytics.people}}
          <details class="staff-person" data-person-id="{{person_id}}" data-person-name="{{person_name}}" data-late-days="{{late_days}}">
            <summary>
              <span><strong>{{person_name}}</strong><span class="block text-xs text-gray-500">{{department_name}}</span></span>
              <span class="staff-counts"><span>Приходов: <b>{{arrival_days}}</b></span><span class="{{#if late_days}}staff-late-text{{/if}}">Опозданий: <b>{{late_days}}</b>{{#if late_days}} · {{total_late_minutes}} мин.{{/if}}</span><span>Без прихода к уроку: <b>{{no_arrival_days}}</b></span></span>
            </summary>
            <div class="p-3 border-t">
              <div class="flex flex-wrap items-center justify-between gap-2 mb-3"><span class="text-sm text-gray-600">{{../analytics.month_label}} · Вовремя: {{on_time_days}}</span><button type="button" class="workspace-secondary no-print" data-staff-export="{{person_id}}">CSV сотрудника</button></div>
              <div class="overflow-x-auto">
                <table class="staff-days min-w-full text-sm">
                  <thead><tr><th>Дата</th><th>Пришёл</th><th>Ушёл</th><th>Первый очный урок</th><th>Статус</th></tr></thead>
                  <tbody data-staff-days></tbody>
                </table>
              </div>
            </div>
          </details>
          {{else}}<p class="text-sm text-gray-500">Сотрудники не найдены.</p>{{/each}}
          <p data-staff-empty hidden class="text-sm text-gray-500">По выбранным условиям сотрудников нет.</p>
        </div>
      </section>

      <details id="adult-departments" class="workspace-surface p-4">
        <summary class="font-semibold cursor-pointer">Кафедры · {{analytics.departments.length}}</summary>
        {{#if analytics.departments.length}}
          <div class="mt-3 overflow-x-auto">
            <table class="min-w-full text-sm">
              <thead class="text-xs text-gray-500">
                <tr class="border-b">
                  <th class="py-2 pr-3 text-left font-medium">Кафедра</th>
                  <th class="py-2 pr-3 text-right font-medium">Сотрудники</th>
                  <th class="py-2 pr-3 text-right font-medium">Пришли сегодня</th>
                  <th class="py-2 pr-3 text-right font-medium">Ушли сегодня</th>
                  <th class="py-2 pr-3 text-right font-medium">Дни присутствия</th>
                  <th class="py-2 pr-3 text-right font-medium">Дни отсутствия</th>
                  <th class="py-2 text-right font-medium">Внимание</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {{#each analytics.departments}}
                  <tr class="hover:bg-indigo-50">
                    <td class="py-2 pr-3 align-top font-medium text-gray-900">{{department_name}}</td>
                    <td class="py-2 pr-3 align-top text-right text-gray-700">{{people_total}}</td>
                    <td class="py-2 pr-3 align-top text-right text-emerald-700">{{present_today}}</td>
                    <td class="py-2 pr-3 align-top text-right text-gray-700">{{departed_today}}</td>
                    <td class="py-2 pr-3 align-top text-right text-gray-700">{{present_days}}</td>
                    <td class="py-2 pr-3 align-top text-right text-gray-700">{{absence_days}}</td>
                    <td class="py-2 align-top text-right {{#if needs_attention}}text-red-700{{else}}text-gray-500{{/if}}">{{needs_attention}}</td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="mt-3 rounded border border-gray-200 bg-gray-50 p-4 text-sm text-gray-500">Сотрудники не найдены.</div>
        {{/if}}
      </details>

      <section id="adult-today-absences" class="workspace-surface p-4">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
          <h2 class="text-base font-semibold text-gray-900">Отсутствующие сегодня</h2>
          <span class="text-sm text-gray-500">{{analytics.class_summary.absent_today_label}}</span>
        </div>
        {{#if analytics.today_absences.students}}
          <div class="mt-3 overflow-x-auto">
            <table class="min-w-full text-sm">
              <thead class="text-xs text-gray-500">
                <tr class="border-b">
                  <th class="py-2 pr-3 text-left font-medium">Кафедра</th>
                  <th class="py-2 pr-3 text-left font-medium">Сотрудник</th>
                  <th class="py-2 pr-3 text-left font-medium">Период</th>
                  <th class="py-2 text-left font-medium">Причина</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-gray-100">
                {{#each analytics.today_absences.students}}
                  <tr class="hover:bg-indigo-50">
                    <td class="py-2 pr-3 align-top text-gray-600">{{class_name}}</td>
                    <td class="py-2 pr-3 align-top font-medium text-gray-900">{{student_name}}</td>
                    <td class="py-2 pr-3 align-top text-gray-700">{{today_period_label}}</td>
                    <td class="py-2 align-top text-gray-700">
                      <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700">{{reason_name}}</span>
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="mt-3 rounded border border-gray-200 bg-gray-50 p-4 text-sm text-gray-500">Отсутствующих сотрудников сегодня нет.</div>
        {{/if}}
      </section>


    </div>
  {{else}}
    <div data-analytics-tabs data-default-tab="journal" class="space-y-4">
      <div class="no-print flex flex-wrap gap-2 border-b border-gray-200">
        <button type="button" data-analytics-tab="journal" class="rounded-t border border-b-0 px-3 py-2 text-sm font-medium">Журнал</button>
        <button type="button" data-analytics-tab="summary" class="rounded-t border border-b-0 px-3 py-2 text-sm font-medium">Сводка</button>
        <button type="button" data-analytics-tab="lessons" class="rounded-t border border-b-0 px-3 py-2 text-sm font-medium">Уроки</button>
        <button type="button" data-analytics-tab="lateness" class="rounded-t border border-b-0 px-3 py-2 text-sm font-medium">Опоздания</button>
        <button type="button" data-analytics-tab="calendar" class="rounded-t border border-b-0 px-3 py-2 text-sm font-medium">Календарь</button>
        <button type="button" data-analytics-tab="classes" class="rounded-t border border-b-0 px-3 py-2 text-sm font-medium">Классы</button>
      </div>

      <section data-analytics-panel="summary" class="space-y-4">
    <div data-class-kpis class="grid grid-cols-2 gap-2 sm:grid-cols-3 xl:grid-cols-5">
      {{#each kpiCards}}
        {{#if href}}
          <a href="{{href}}" data-kpi-card data-target-id="{{target_id}}" class="workspace-kpi block transition hover:border-blue-300 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-400 focus-visible:ring-offset-2">
            <div class="text-xs text-gray-500">{{label}}</div>
            <div class="mt-1 text-2xl font-semibold text-gray-900">{{value}}</div>
            {{#if hint}}<div class="mt-1 text-xs text-gray-500">{{hint}}</div>{{/if}}
            {{#if details}}
              <div class="mt-2 flex flex-wrap gap-1">
                {{#each details}}
                  <span class="rounded-full px-2 py-0.5 text-[11px] font-medium {{tone_class}}">{{label}}</span>
                {{/each}}
              </div>
            {{/if}}
            <div class="mt-2 text-xs font-medium text-indigo-700">{{action_label}}</div>
          </a>
        {{else}}
          <div class="workspace-kpi">
            <div class="text-xs text-gray-500">{{label}}</div>
            <div class="mt-1 text-2xl font-semibold text-gray-900">{{value}}</div>
            {{#if hint}}<div class="mt-1 text-xs text-gray-500">{{hint}}</div>{{/if}}
            {{#if details}}
              <div class="mt-2 flex flex-wrap gap-1">
                {{#each details}}
                  <span class="rounded-full px-2 py-0.5 text-[11px] font-medium {{tone_class}}">{{label}}</span>
                {{/each}}
              </div>
            {{/if}}
          </div>
        {{/if}}
      {{/each}}
    </div>
        <div id="today-absences" class="workspace-surface p-4">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <h2 class="text-base font-semibold text-gray-900">Отсутствующие</h2>
              <div class="mt-1 flex flex-wrap gap-1 text-xs">
                <span class="rounded-full bg-gray-100 px-2 py-0.5 text-gray-600">{{analytics.class_summary.absent_today_label}}</span>
                <span class="rounded-full {{#if analytics.class_summary.without_reason}}bg-amber-100 text-amber-800{{else}}bg-gray-100 text-gray-600{{/if}} px-2 py-0.5">без причины: {{analytics.class_summary.without_reason}}</span>
                <span class="rounded-full {{#if analytics.class_summary.needs_attention}}bg-red-100 text-red-800{{else}}bg-gray-100 text-gray-600{{/if}} px-2 py-0.5">внимание: {{analytics.class_summary.needs_attention}}</span>
                <span class="rounded-full {{#if analytics.class_summary.needs_clarification}}bg-yellow-100 text-yellow-800{{else}}bg-gray-100 text-gray-600{{/if}} px-2 py-0.5">уточнить: {{analytics.class_summary.needs_clarification}}</span>
              </div>
            </div>
          </div>
          {{#if analytics.today_absences.students}}
            <div class="mt-3 overflow-x-auto">
              <table class="min-w-full text-sm">
                <thead class="text-xs text-gray-500">
                  <tr class="border-b">
                    <th class="py-2 pr-3 text-left font-medium">Класс</th>
                    <th class="py-2 pr-3 text-left font-medium">Имя</th>
                    <th class="py-2 pr-3 text-left font-medium">Период</th>
                    <th class="py-2 text-left font-medium">Причина</th>
                  </tr>
                </thead>
                <tbody class="divide-y divide-gray-100">
                  {{#each analytics.today_absences.students}}
                    <tr class="hover:bg-indigo-50">
                      <td class="py-2 pr-3 align-top text-gray-600">{{class_name}}</td>
                      <td class="py-2 pr-3 align-top font-medium text-gray-900">
                        <a href="{{href}}" class="hover:text-indigo-700">{{student_name}}</a>
                      </td>
                      <td class="py-2 pr-3 align-top text-gray-700">
                        <span>{{today_period_label}}</span>
                        {{#if period_count_label}}
                          <span class="ml-1 rounded-full bg-gray-100 px-1.5 py-0.5 text-xs text-gray-600">{{period_count_label}}</span>
                        {{/if}}
                      </td>
                      <td class="py-2 align-top text-gray-700">
                        <span class="rounded-full bg-slate-100 px-2 py-0.5 text-xs text-slate-700">{{reason_name}}</span>
                      </td>
                    </tr>
                  {{/each}}
                </tbody>
              </table>
            </div>
          {{else}}
            <div class="mt-3 rounded border border-gray-200 bg-gray-50 px-3 py-2 text-sm text-gray-500">Нет</div>
          {{/if}}
        </div>

        {{#if analytics.quality.has_issues}}
          <div id="data-quality" class="workspace-surface p-4 min-w-0">
            <h2 class="text-base font-semibold text-gray-900">Качество данных</h2>
            <div class="mt-3 grid sm:grid-cols-3 gap-2">
              {{#each analytics.quality.issues}}
                <div class="border rounded p-3 bg-amber-50 border-amber-200">
                  <div class="text-xs text-amber-800">{{label}}</div>
                  <div class="mt-1 text-xl font-semibold text-amber-900">{{value}}</div>
                </div>
              {{/each}}
            </div>
          </div>
        {{/if}}

        <div id="reasons-breakdown" class="workspace-surface p-4">
          <h2 class="text-base font-semibold text-gray-900">Причины</h2>
          <div class="mt-4 space-y-3">
            {{#each analytics.reasons}}
              <div>
                <div class="flex items-center justify-between gap-2 text-sm">
                  <span class="font-medium text-gray-900">{{name}}</span>
                  <span class="text-gray-500">{{absence_days}} дн. · {{percent}}%</span>
                </div>
                <div class="mt-1 h-2 rounded-full bg-gray-100 overflow-hidden">
                  <div class="h-2 rounded-full" style="width: {{bar_width}}%; background-color: {{bar_color}};"></div>
                </div>
              </div>
            {{/each}}
          </div>
        </div>
      </section>

      <section data-analytics-panel="lessons" id="learning-analytics" class="hidden workspace-surface p-4 space-y-4">
      <div class="flex flex-col gap-2 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-base font-semibold text-gray-900">Пропущенные уроки</h2>
          <div class="mt-1 text-sm text-gray-500">По опубликованному расписанию, пересечение больше 15 минут</div>
        </div>
        <div class="grid grid-cols-2 gap-2 text-center sm:grid-cols-4">
          <div class="border rounded px-3 py-2">
            <div class="text-lg font-semibold text-gray-900">{{analytics.learning.missed_lessons_total}}</div>
            <div class="text-xs text-gray-500">уроков</div>
          </div>
          <div class="border rounded px-3 py-2">
            <div class="text-lg font-semibold text-gray-900">{{analytics.learning.students_with_missed_lessons}}</div>
            <div class="text-xs text-gray-500">учеников</div>
          </div>
          <div class="border rounded px-3 py-2">
            <div class="text-lg font-semibold text-gray-900">{{analytics.learning.subjects_total}}</div>
            <div class="text-xs text-gray-500">предметов</div>
          </div>
          <div class="border rounded px-3 py-2">
            <div class="text-lg font-semibold {{#if analytics.learning.uncovered_absence_periods}}text-red-700{{else}}text-emerald-700{{/if}}">{{analytics.learning.coverage_percent}}%</div>
            <div class="text-xs text-gray-500">покрытие</div>
          </div>
        </div>
      </div>

      {{#if analytics.learning.data_gaps_total}}
        <div class="rounded border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">
          Отметки без опубликованного расписания: {{analytics.learning.uncovered_absence_periods}}. Дней без расписания: {{analytics.learning.data_gaps_total}}.
        </div>
      {{/if}}

      <div class="grid gap-4 xl:grid-cols-2">
        <div>
          <h3 class="text-sm font-semibold text-gray-900">Предметы</h3>
          {{#if analytics.learning.subjects}}
            <div class="mt-3 space-y-3">
              {{#each analytics.learning.subjects}}
                <div>
                  <div class="flex items-center justify-between gap-2 text-sm">
                    <span class="font-medium text-gray-900">{{subject_name}}</span>
                    <span class="text-gray-500">{{missed_lessons}} · {{students}} уч.</span>
                  </div>
                  <div class="mt-1 h-2 rounded-full bg-gray-100 overflow-hidden">
                    <div class="h-2 rounded-full bg-indigo-600" style="width: {{bar_width}}%;"></div>
                  </div>
                </div>
              {{/each}}
            </div>
          {{else}}
