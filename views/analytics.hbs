  {{/if}}
</section>

<dialog id="student-analytics-dialog" aria-labelledby="student-modal-title" class="p-0 text-left shadow-lg" data-can-manage="{{#if canManage}}1{{else}}0{{/if}}" data-can-manage-presence="{{#if canManagePresence}}1{{else}}0{{/if}}">
  <div class="student-dialog-shell">
    <div class="flex items-start justify-between gap-3 border-b border-gray-200 p-4">
      <div>
        <div class="text-xs font-medium uppercase text-gray-500">Ученик</div>
        <h2 id="student-modal-title" class="mt-1 text-lg font-semibold text-gray-900" data-student-modal-title>Аналитика</h2>
        <div class="mt-1 text-sm text-gray-500" data-student-modal-subtitle></div>
      </div>
      <button type="button" class="workspace-secondary text-sm" data-student-modal-close>Закрыть</button>
    </div>
    <div class="border-b border-gray-200 px-4">
      <div role="tablist" aria-label="Разделы карточки ученика" class="flex flex-nowrap gap-1 overflow-x-auto" data-student-modal-tabs></div>
    </div>
    <div id="student-analytics-panel" role="tabpanel" tabindex="0" class="student-dialog-body focus:outline-none" data-student-modal-body>
      <div class="text-sm text-gray-500">Загрузка...</div>
    </div>
  </div>
</dialog>

<script id="analytics-data" type="application/json">{{{json analytics}}}</script>
<script>
(() => {
  const form = document.querySelector('[data-analytics-controls]');
  form?.querySelectorAll('input[name="month"], select[name="class"], select[name="department"]').forEach((control) => {
    control.addEventListener('change', () => { if (!form.elements.from) form.requestSubmit(); });
  });

  document.querySelector('[data-print-analytics]')?.addEventListener('click', () => window.print());
})();

(() => {
  const button = document.querySelector('[data-export-analytics]');
  const source = document.getElementById('analytics-data');
  if (!button || !source) return;

  const quote = (value) => `"${String(value ?? '').replaceAll('"', '""')}"`;
  const row = (values) => values.map(quote).join(';');
  button.addEventListener('click', () => {
    const data = JSON.parse(source.textContent || '{}');
    if (data.is_adult) {
      window.exportStaffDays(data.people || [], data);
      return;
    }

    const lines = [
      row(['Раздел', 'Класс', 'Ученик', 'Период', 'Дни', 'Часы', 'Периоды', 'Без причины', 'Внимание', 'Опоздания', 'Минуты опозданий', 'Последний контекст']),
    ];

    (data.classes || []).forEach((item) => {
      lines.push(row(['Класс', item.class_name, '', '', item.absence_days, item.absence_hours, item.periods, item.without_reason, item.needs_attention, '', '', '']));
    });

    (data.student_attendance?.students || []).forEach((item) => {
      lines.push(row(['Ученик', item.class_name, item.student_name, item.metric_label || '', item.absence_days, '', '', item.unexcused_absence_days, '', '', '', item.absence_button_label || '']));
    });

    (data.lateness?.students || []).forEach((item) => {
      lines.push(row(['Опоздания', item.class_name, item.student_name, item.last_late_label || '', item.late_days, '', item.arrival_days, '', '', item.late_days, item.total_late_minutes, `уроки: ${item.missed_lessons || 0}; предметы: ${item.subjects || 0}`]));
    });

    const blob = new Blob([`\uFEFF${lines.join('\n')}`], { type: 'text/csv;charset=utf-8' });
    const link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = `attendance-${data.month || 'report'}-${data.class_id || 'all'}.csv`;
    document.body.append(link);
    link.click();
    URL.revokeObjectURL(link.href);
    link.remove();
  });
})();

(() => {
  const highlightClasses = ['ring-2', 'ring-indigo-300', 'bg-indigo-50/30'];
  const tabsRoot = document.querySelector('[data-analytics-tabs]');
  const storageKey = 'attendance.analyticsTab';
  const buttons = tabsRoot ? Array.from(tabsRoot.querySelectorAll('[data-analytics-tab]')) : [];
  const panels = tabsRoot ? Array.from(tabsRoot.querySelectorAll('[data-analytics-panel]')) : [];
  const available = new Set(buttons.map((button) => button.dataset.analyticsTab));
  let activeTarget = null;
  let highlightTimer = null;

  function clearHighlight() {
    if (highlightTimer) window.clearTimeout(highlightTimer);
    highlightTimer = null;
    if (!activeTarget) return;
    activeTarget.classList.remove(...highlightClasses);
    activeTarget = null;
  }

  function highlightTarget(target) {
    clearHighlight();
    activeTarget = target;
    activeTarget.classList.add(...highlightClasses);
    highlightTimer = window.setTimeout(clearHighlight, 1500);
  }

  function tabForTarget(target) {
    return target?.closest?.('[data-analytics-panel]')?.dataset.analyticsPanel || '';
  }

  function activateTab(tab, updateHash = false) {
    if (!tabsRoot) return;
    const defaultTab = tabsRoot.dataset.defaultTab || buttons[0]?.dataset.analyticsTab || '';
    const nextTab = available.has(tab) ? tab : defaultTab;
    buttons.forEach((button) => {
      const active = button.dataset.analyticsTab === nextTab;
      button.setAttribute('role', 'tab'); button.setAttribute('aria-selected', String(active)); button.tabIndex = active ? 0 : -1;
      button.classList.toggle('bg-white', active);
      button.classList.toggle('border-gray-200', active);
      button.classList.toggle('text-gray-900', active);
      button.classList.toggle('shadow-sm', active);
      button.classList.toggle('bg-gray-50', !active);
      button.classList.toggle('border-transparent', !active);
      button.classList.toggle('text-gray-600', !active);
      button.classList.toggle('hover:bg-white', !active);
    });
    panels.forEach((panel) => panel.classList.toggle('hidden', panel.dataset.analyticsPanel !== nextTab));
    sessionStorage.setItem(storageKey, nextTab);
    if (updateHash) window.history.replaceState(null, '', `#analytics-${nextTab}`);
  }

  buttons.forEach((button) => {
    button.addEventListener('keydown', (event) => {
      if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
      event.preventDefault(); const index = buttons.indexOf(button);
      const next = event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length;
      activateTab(buttons[next].dataset.analyticsTab, true); buttons[next].focus();
    });
    button.addEventListener('click', () => activateTab(button.dataset.analyticsTab, true));
  });

  if (tabsRoot) {
    const rawHash = window.location.hash.slice(1);
    const targetFromHash = rawHash ? document.getElementById(rawHash) : null;
    const hashTab = rawHash.startsWith('analytics-') ? rawHash.replace('analytics-', '') : tabForTarget(targetFromHash);
    const storedTab = sessionStorage.getItem(storageKey) || '';
    activateTab(available.has(hashTab) ? hashTab : (available.has(storedTab) ? storedTab : tabsRoot.dataset.defaultTab));
  }

  document.addEventListener('click', (event) => {
    const link = event.target.closest('a[data-kpi-card][href^="#"]');
    if (!link) return;
    const targetId = link.getAttribute('href').slice(1);
    const target = document.getElementById(targetId);
    if (!target) return;
    event.preventDefault(); activateTab(tabForTarget(target));
    target.scrollIntoView({ behavior: 'smooth', block: 'start' }); highlightTarget(target);
    window.history.replaceState(null, '', `#${targetId}`);
  });

  if (window.location.hash) {
    const target = document.getElementById(window.location.hash.slice(1));
    if (target) {
      activateTab(tabForTarget(target));
      window.setTimeout(() => highlightTarget(target), 250);
    }
  }
})();

(() => {
 const initialize = () => {
  const root = document.querySelector('[data-lateness-classes]');
  if (!root) return;

  const buttons = Array.from(document.querySelectorAll('[data-lateness-filter]'));
  const sortSelect = document.querySelector('[data-lateness-sort]');
  const classBlocks = Array.from(root.querySelectorAll('[data-lateness-class]'));
  const activeClasses = ['bg-gray-900', 'border-gray-900', 'text-white'];
  const inactiveClasses = ['bg-white', 'border-gray-300', 'text-gray-700', 'hover:bg-gray-50'];
  let activeFilter = 'all';

  function numberAttr(row, name) {
    return Number(row.dataset[name] || 0);
  }

  function rowMatches(row) {
    if (activeFilter === 'all') return true;
    if (activeFilter === 'on_time') return numberAttr(row, 'latenessOnTimeDays') > 0;
    if (activeFilter === 'gap') return numberAttr(row, 'latenessGaps') > 0;
    return row.dataset.latenessStatus === activeFilter;
  }

  function compareRows(left, right) {
    const sort = sortSelect?.value || 'late_first';
    if (sort === 'arrived_first') {
      return (
        numberAttr(right, 'latenessOnTimeDays') - numberAttr(left, 'latenessOnTimeDays')
        || numberAttr(right, 'latenessArrivals') - numberAttr(left, 'latenessArrivals')
        || String(left.dataset.latenessName || '').localeCompare(String(right.dataset.latenessName || ''), 'ru', { numeric: true, sensitivity: 'base' })
      );
    }
    if (sort === 'minutes') {
      return (
        numberAttr(right, 'latenessMinutes') - numberAttr(left, 'latenessMinutes')
        || numberAttr(right, 'latenessLateDays') - numberAttr(left, 'latenessLateDays')
        || String(left.dataset.latenessName || '').localeCompare(String(right.dataset.latenessName || ''), 'ru', { numeric: true, sensitivity: 'base' })
      );
    }
    if (sort === 'name') {
      return String(left.dataset.latenessName || '').localeCompare(String(right.dataset.latenessName || ''), 'ru', { numeric: true, sensitivity: 'base' });
    }
    return (
      Number(right.dataset.latenessStatus === 'late') - Number(left.dataset.latenessStatus === 'late')
      || numberAttr(right, 'latenessLateDays') - numberAttr(left, 'latenessLateDays')
      || numberAttr(right, 'latenessMinutes') - numberAttr(left, 'latenessMinutes')
      || String(left.dataset.latenessName || '').localeCompare(String(right.dataset.latenessName || ''), 'ru', { numeric: true, sensitivity: 'base' })
    );
  }

  function paintButtons() {
    buttons.forEach((button) => {
      const active = button.dataset.latenessFilter === activeFilter;
      button.classList.toggle(activeClasses[0], active);
      button.classList.toggle(activeClasses[1], active);
      button.classList.toggle(activeClasses[2], active);
      inactiveClasses.forEach((className) => button.classList.toggle(className, !active));
    });
  }

  function applyLatenessView() {
    paintButtons();
    classBlocks.forEach((block) => {
      const list = block.querySelector('[data-lateness-student-list]');
      const rows = Array.from(block.querySelectorAll('[data-lateness-student]')).sort(compareRows);
      let visible = 0;
      rows.forEach((row) => {
        const show = rowMatches(row);
        row.classList.toggle('hidden', !show);
        if (show) visible += 1;
        list?.append(row);
      });
      block.classList.toggle('hidden', visible === 0);
      const count = block.querySelector('[data-lateness-class-visible]');
      if (count) count.textContent = String(visible);
    });
  }

  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      activeFilter = button.dataset.latenessFilter || 'all';
      applyLatenessView();
    });
  });
  sortSelect?.addEventListener('change', applyLatenessView);
  applyLatenessView();
 };
 initialize(); document.addEventListener('attendance:analytics-refreshed', initialize);
})();

(() => {
 const initialize = () => {
  const search = document.querySelector('[data-journal-search]');
  const rows = Array.from(document.querySelectorAll('[data-journal-student]'));
  const empty = document.querySelector('[data-journal-empty]');
  if (!search || !rows.length) return;

  search.addEventListener('input', () => {
    const query = search.value.trim().toLocaleLowerCase('ru');
    let visible = 0;
    rows.forEach((row) => {
      const matches = !query || String(row.dataset.journalName || '').toLocaleLowerCase('ru').includes(query);
      row.classList.toggle('hidden', !matches);
      if (matches) visible += 1;
    });
    empty?.classList.toggle('hidden', visible > 0);
  });
  search.dispatchEvent(new Event('input'));
 };
 initialize(); document.addEventListener('attendance:analytics-refreshed', initialize);
})();

(() => {
  const source = document.getElementById('analytics-data');
  const dialog = document.getElementById('student-analytics-dialog');
  if (!source || !dialog) return;

  let analytics = JSON.parse(source.textContent || '{}');
  const title = dialog.querySelector('[data-student-modal-title]');
  const subtitle = dialog.querySelector('[data-student-modal-subtitle]');
  const tabs = dialog.querySelector('[data-student-modal-tabs]');
  const body = dialog.querySelector('[data-student-modal-body]');
  const closeButton = dialog.querySelector('[data-student-modal-close]');
  const canManagePage = dialog.dataset.canManage === '1';
  const canManagePresencePage = dialog.dataset.canManagePresence === '1';
  const state = {
    payload: null,
    tab: 'overview',
    dayMode: 'all',
    history: null,
    historyError: '',
    quickAction: '',
    createOpen: false,
    historyFilters: { from: '', to: '', includeCancelled: false },
    request: 0,
    busy: false,
    dirty: false,
  };

  const tabItems = [['overview', 'Обзор'], ['lessons', 'По урокам'], ['history', 'История']];

  const normalizeTab = (tab) => ['history', 'periods'].includes(tab) ? 'history' : tab === 'lessons' ? 'lessons' : 'overview';
  const tabBaseClass = 'shrink-0 whitespace-nowrap border-b-2 min-h-11 px-4 py-3 text-sm font-medium transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-inset focus-visible:ring-indigo-500';
  const activeTabClass = 'border-indigo-600 bg-indigo-50 text-indigo-700';
  const inactiveTabClass = 'border-transparent text-gray-600 hover:border-gray-300 hover:text-gray-900';

  const escapeHtml = (value) => String(value ?? '').replace(/[&<>"']/g, (char) => ({
    '&': '&amp;',
    '<': '&lt;',
    '>': '&gt;',
    '"': '&quot;',
    "'": '&#39;',
  }[char]));
  const attr = escapeHtml;
  const number = (value) => Number(value || 0);
  const status = (message, tone = 'gray') => `<div role="${tone === 'red' ? 'alert' : 'status'}" aria-live="polite" class="mb-3 rounded border px-3 py-2 text-sm ${tone === 'red' ? 'border-red-200 bg-red-50 text-red-800' : 'border-green-200 bg-green-50 text-green-800'}" data-modal-status>${escapeHtml(message)}</div>`;

  function openDialog() {
    if (typeof dialog.showModal === 'function' && !dialog.open) dialog.showModal();
    else dialog.setAttribute('open', '');
  }

  async function openStudent(studentId, options = {}) {
    const request = ++state.request;
    state.createOpen = Boolean(options.quickAction);
    state.historyFilters = { from: '', to: '', includeCancelled: false };
    const url = new URL(window.location.href); url.searchParams.set('student', studentId); url.searchParams.set('tab', normalizeTab(options.tab)); window.history.replaceState(null, '', url);
    state.payload = null;
    state.tab = normalizeTab(options.tab);
    state.dayMode = options.mode || 'all';
    state.history = null;
    state.historyError = '';
    state.quickAction = options.quickAction || '';
    title.textContent = 'Аналитика';
    subtitle.textContent = '';
    tabs.innerHTML = '';
    body.removeAttribute('aria-labelledby');
    body.innerHTML = '<div class="text-sm text-gray-500">Загрузка...</div>';
    openDialog();

    try {
      const response = await fetch(`/api/v2/attendance/students/${encodeURIComponent(studentId)}/analytics?month=${encodeURIComponent(analytics.month || '')}`, {
        headers: { Accept: 'application/json' },
      });
      if (!response.ok) throw new Error('Не удалось загрузить аналитику ученика');
      const payload = await response.json();
      if (request !== state.request) return;
      state.payload = payload;
      if (state.tab === 'history') await ensureHistory();
      render();
      body.scrollTop = 0;
      revealActiveTab();
    } catch (err) {
      body.innerHTML = `<div class="rounded border border-red-200 bg-red-50 p-3 text-sm text-red-800">${escapeHtml(err.message || err)}</div>`;
    }
  }

  function render(message = '') {
    const payload = state.payload;
    if (!payload) return;
    state.tab = normalizeTab(state.tab);
    const canManage = Boolean(payload.can_manage) && canManagePage;
    const canManagePresence = Boolean(payload.can_manage_presence) && canManagePresencePage;
    title.textContent = payload.student?.name || 'Ученик';
    subtitle.textContent = `${state.tab === 'history' ? (state.historyFilters.from || state.historyFilters.to ? 'История за период' : 'Вся история') : payload.month_label || payload.month || ''}${payload.student?.class_name ? ` · Класс ${payload.student.class_name}` : ''}`;
    ensureTabs();
    syncTabs();
    body.innerHTML = `${message ? status(message) : ''}${renderActiveTab(payload, canManage, canManagePresence)}`;
    focusQuickAction();
  }

  function ensureTabs() {
    if (tabs.querySelectorAll('[role="tab"]').length === tabItems.length) return;
    tabs.innerHTML = tabItems.map(([id, label]) => `
      <button
        type="button"
        id="student-analytics-tab-${id}"
        role="tab"
        aria-controls="student-analytics-panel"
        data-student-tab="${id}"
        class="${tabBaseClass}"
      >${label}</button>
    `).join('');
  }

  function syncTabs() {
    tabs.querySelectorAll('[role="tab"]').forEach((button) => {
      const selected = button.dataset.studentTab === state.tab;
      button.setAttribute('aria-selected', selected ? 'true' : 'false');
      button.tabIndex = selected ? 0 : -1;
      button.className = `${tabBaseClass} ${selected ? activeTabClass : inactiveTabClass}`;
    });
    body.setAttribute('aria-labelledby', `student-analytics-tab-${state.tab}`);
  }

  function revealActiveTab({ focus = false } = {}) {
    const activeTab = tabs.querySelector(`[role="tab"][data-student-tab="${state.tab}"]`);
    if (!activeTab) return;
    if (focus) activeTab.focus({ preventScroll: true });
    activeTab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
  }

  function renderActiveTab(payload, canManage, canManagePresence) {
    if (state.tab === 'history') return renderHistory(payload, canManage, canManagePresence);
    if (state.tab === 'lessons') return renderLessons(payload);
    return renderOverview(payload);
  }

  function renderOverview(payload) {
    const kpi = payload.kpi || {};
    const learning = payload.learning || {};
    return `<div class="grid grid-cols-2 gap-2 lg:grid-cols-4">
      ${summaryCard('Присутствовал, дней', `${number(kpi.present_days)} / ${number(kpi.school_days_total)}`)}
      ${summaryCard('Отсутствовал, дней', kpi.absence_days)}
      ${summaryCard('Пропущено уроков', learning.data_gaps_total && !learning.affected_lessons_total ? 'Не рассчитано' : kpi.missed_lessons)}
      ${summaryCard('Опоздания', kpi.late_days)}
      </div>
      ${learning.data_gaps_total ? '<p class="mt-3 text-sm text-amber-800">Расчёт уроков неполный: для части дней нет опубликованного расписания.</p>' : ''}
      <h3 class="mb-3 mt-6 font-semibold text-slate-900">Посещаемость по дням</h3>
      ${renderDays(payload)}`;
  }

  function renderLessons(payload) {
    const actual = payload.missed_lessons || payload.learning?.lessons || [];
    const planned = payload.planned_lessons || payload.learning?.planned_lessons || [];
    const gaps = number(payload.learning?.data_gaps_total);
    const row = (lesson, isPlanned) => {
      const label = isPlanned ? 'Запланировано' : lesson.attendance_status === 'conflict' ? 'Требует уточнения' : lesson.is_unconfirmed ? 'Неподтверждённый пропуск' : lesson.is_partial ? 'Частичное отсутствие' : 'Отсутствие';
      const minutes = number(lesson.absence_minutes ?? lesson.overlap_minutes);
      return `<article class="workspace-lesson-row text-sm"><div><div class="font-medium text-slate-900">${escapeHtml(lesson.date_label || lesson.date)}</div><div class="mt-1 text-slate-500">${escapeHtml(lesson.time_label)} · ${escapeHtml(lesson.lesson_number)} урок</div></div><div><h4 class="font-medium text-slate-900">${escapeHtml(lesson.subject_name)}</h4><div class="mt-1 text-slate-500">${escapeHtml(lesson.teacher_name)}${lesson.room_name ? ` · Каб. ${escapeHtml(lesson.room_name)}` : ''}</div>${lesson.comment ? `<p class="mt-1 text-slate-600">${escapeHtml(lesson.comment)}</p>` : ''}</div><div><div class="text-xs font-medium ${isPlanned ? 'text-blue-700' : lesson.is_unconfirmed ? 'text-amber-800' : 'text-slate-600'}">${label}</div><div class="mt-1 text-slate-700">${escapeHtml(lesson.reason_name)}</div>${minutes ? `<div class="mt-1 text-xs text-slate-500">${minutes} мин.${!isPlanned && lesson.counts_as_missed_lesson === false ? ' · не засчитан как пропуск урока' : ''}</div>` : ''}</div></article>`;
    };
    return `<h3 class="font-semibold text-slate-900">Отсутствия по урокам</h3><p class="mt-1 text-sm text-slate-500">По отметкам и опубликованному расписанию</p>
      ${gaps ? '<div class="mt-3 rounded-lg border border-amber-200 bg-amber-50 p-3 text-sm text-amber-900">Для части дней нет опубликованного расписания. Периоды отсутствия сохранены в истории; полный расчёт уроков пока недоступен.</div>' : ''}
      <div class="mt-3">${actual.length ? actual.map((lesson) => row(lesson, false)).join('') : `<div class="rounded-lg bg-slate-50 p-4 text-sm text-slate-600">${gaps ? 'Уроки за эти дни пока не рассчитаны.' : 'Фактических отсутствий на уроках за месяц нет.'}</div>`}</div>
      ${planned.length ? `<section class="mt-6 border-t border-slate-200 pt-4"><h3 class="font-semibold text-slate-900">Планируемые отсутствия</h3><p class="mt-1 text-sm text-slate-500">Будущие уроки не входят в фактические пропуски.</p>${planned.map((lesson) => row(lesson, true)).join('')}</section>` : ''}`;
  }

  function renderHistory(payload, canManage, canManagePresence) {
    const items = state.history?.items || [];
    const f = state.historyFilters;
    return `<div class="flex flex-wrap items-center justify-between gap-2"><h3 class="font-semibold text-slate-900">${f.from || f.to ? 'История за период' : 'Вся история отметок'}</h3>${canManage ? '<button type="button" data-create-toggle class="workspace-primary text-sm">Добавить отметку</button>' : ''}</div>
      ${state.createOpen ? `<div class="mt-4"><div class="mb-2 text-right"><button type="button" data-create-toggle class="workspace-link text-sm">Закрыть форму</button></div>${renderNewMarks(payload, canManage, canManagePresence)}</div>` : ''}
      <form data-history-filters class="mt-4 grid grid-cols-2 gap-3 rounded-lg bg-slate-50 p-3 sm:flex sm:flex-wrap sm:items-end"><label class="text-sm"><span class="mb-1 block">С</span><input name="from" type="date" value="${attr(f.from)}" class="w-full" /></label><label class="text-sm"><span class="mb-1 block">По</span><input name="to" type="date" value="${attr(f.to)}" class="w-full" /></label><label class="col-span-2 flex min-h-11 items-center gap-2 text-sm"><input type="checkbox" name="includeCancelled" class="h-5 w-5" ${f.includeCancelled ? 'checked' : ''} />Включая отменённые</label><button type="submit" class="workspace-secondary text-sm">Показать</button><button type="button" data-history-reset class="workspace-link text-sm">За всё время</button></form>
      ${state.historyError ? status(state.historyError, 'red') + '<button type="button" data-history-retry class="workspace-secondary text-sm">Повторить</button>' : ''}
      <div class="mt-3">${state.history === null ? '<p class="p-4 text-sm text-slate-500">Загрузка истории…</p>' : items.length ? items.map((entry) => renderHistoryEntry(entry, payload.reason_options || [])).join('') : '<p class="rounded-lg bg-slate-50 p-4 text-sm text-slate-600">За выбранный период отметок нет.</p>'}</div>
      <div class="mt-4 flex flex-wrap items-center justify-between gap-2"><span class="text-xs text-slate-500">Загружено записей: ${items.length}</span>${state.history?.next_cursor ? '<button type="button" data-history-more class="workspace-secondary text-sm">Загрузить ещё</button>' : state.history && items.length ? '<span class="text-xs text-slate-500">Вся история загружена</span>' : ''}</div>`;
  }

  function renderHistoryEntry(entry, reasons) {
    const r = entry.record || {}; const absence = entry.kind === 'absence'; const cancelled = Boolean(r.deleted_at || r.cancelled_at); const key = `${entry.kind}:${entry.id}`;
    const stamp = absence ? periodLabel(r) : r.occurred_label || String(r.occurred_at || '');
    const label = absence ? r.reason_name || r.reason_code : r.source === 'mentor_manual_late' ? 'Приход с опозданием' : r.event_type === 'departure' ? 'Уход' : 'Приход';
    const past = String(r.attendance_date || r.occurred_at || r.starts_at || '').slice(0, 10) < localDate();
    const formPeriod = { ...r, starts_at_input: dateTimeInput(r.starts_at), ends_at_input: dateTimeInput(r.ends_at) };
    return `<article class="workspace-history-entry ${cancelled ? 'is-cancelled' : ''}"><div class="flex flex-wrap items-start justify-between gap-2"><div><h4 class="text-sm font-medium text-slate-900 ${cancelled ? 'line-through' : ''}">${escapeHtml(stamp)}</h4><div class="mt-1 text-sm text-slate-700">${escapeHtml(label)}</div></div>${cancelled ? '<span class="rounded-full bg-slate-200 px-2 py-1 text-xs text-slate-600">Отменено</span>' : ''}</div><div class="workspace-history-meta mt-1">${r.source === 'face' ? '<span>Автоматическая отметка</span>' : ['tablet', 'mentor_manual_late', 'mentor_manual', 'mentor'].includes(r.source) ? '<span>Ручная отметка</span>' : ''}${r.actor_name ? `<span>${escapeHtml(r.actor_name)}</span>` : ''}</div>${r.comment ? `<p class="mt-2 whitespace-pre-wrap break-words text-sm text-slate-600">${escapeHtml(r.comment)}</p>` : ''}
      ${!cancelled && r.can_edit ? absence ? renderCommentForm(formPeriod, past) + renderEditForm(formPeriod, reasons) : renderPresenceEdit(r, past) : ''}
      ${!cancelled && r.can_cancel ? `<details class="mt-1"><summary class="text-sm font-medium text-red-700">Отменить отметку</summary><form data-cancel-history="${attr(key)}" class="mt-2 space-y-3 rounded-lg border border-red-100 bg-red-50/30 p-3"><div class="text-sm text-slate-700">${escapeHtml(label)} · ${escapeHtml(stamp)}</div><label class="block text-sm"><span class="mb-1 block">Причина отмены${past ? '' : ' (необязательно)'}</span><textarea name="changeReason" rows="2" maxlength="1000" ${past ? 'required' : ''} class="w-full"></textarea></label><button type="submit" class="workspace-danger text-sm">Подтвердить отмену</button></form></details>` : ''}
      ${renderChanges(r.changes || [])}</article>`;
  }

  function renderPresenceEdit(r, past) {
    const late = r.source === 'mentor_manual_late';
    return `<details class="mt-2"><summary class="text-sm font-medium text-blue-700">Изменить</summary><form data-edit-presence="${attr(r.id)}" class="mt-2 space-y-3 rounded-lg border border-slate-200 bg-slate-50 p-3"><input type="hidden" name="expectedUpdatedAt" value="${attr(r.expected_updated_at || r.updated_at)}" /><div class="grid gap-3 sm:grid-cols-2"><label class="text-sm"><span class="mb-1 block">Дата и время</span><input name="occurredAt" type="datetime-local" value="${attr(dateTimeInput(r.occurred_at))}" required class="w-full" /></label>${late ? '<input name="eventType" type="hidden" value="arrival" />' : `<label class="text-sm"><span class="mb-1 block">Событие</span><select name="eventType" class="w-full">${option('arrival', 'Приход', r.event_type)}${option('departure', 'Уход', r.event_type)}</select></label>`}</div><label class="block text-sm"><span class="mb-1 block">Причина исправления${past ? '' : ' (необязательно)'}</span><textarea name="reason" rows="2" maxlength="1000" ${past ? 'required' : ''} class="w-full"></textarea></label><button type="submit" class="workspace-primary text-sm">Сохранить изменения</button></form></details>`;
  }

  function renderChanges(changes) {
    if (!changes.length) return '';
    const fields = { starts_at: 'Начало', ends_at: 'Окончание', occurred_at: 'Время', event_type: 'Событие', reason_code: 'Причина', comment: 'Комментарий' };
    const labels = { arrival: 'Приход', departure: 'Уход' };
    const value = (v) => labels[v] || (state.payload.reason_options || []).find((reason) => reason.code === v)?.name || String(v ?? '—');
    return `<details class="mt-1"><summary class="text-xs font-medium text-slate-500">Изменения · ${changes.length}</summary><ol class="space-y-3 border-l border-slate-200 pl-3">${changes.map((change) => { const before = change.before || {}; const after = change.after || {}; const names = Object.keys(fields).filter((key) => String(before[key] ?? '') !== String(after[key] ?? '') && (key in before || key in after)); return `<li class="text-xs text-slate-600"><div class="font-medium text-slate-700">${/cancel|delete/.test(change.event_type) ? 'Отметка отменена' : /creat|insert/.test(change.event_type) ? 'Отметка создана' : 'Отметка изменена'}</div><div class="mt-1">${escapeHtml(change.created_at)}${change.actor_name ? ` · ${escapeHtml(change.actor_name)}` : ''}</div>${change.reason ? `<p class="mt-1 break-words">${escapeHtml(change.reason)}</p>` : ''}${names.map((key) => `<div class="mt-1 break-words">${fields[key]}: ${escapeHtml(value(before[key]))} → ${escapeHtml(value(after[key]))}</div>`).join('')}</li>`; }).join('')}</ol></details>`;
  }

  function renderNewMarks(payload, canManage, canManagePresence) {
    const reasons = payload.reason_options || [];
    const student = payload.student || {};
    const defaultReason = reasons.find((item) => item.code === 'without_reason')?.code || reasons[0]?.code || '';
    return `
      ${canManage ? `
        <div class="grid gap-4 xl:grid-cols-2">
          <form class="space-y-3 rounded border border-slate-200 bg-slate-50 p-3" data-create-absence>
            <input type="hidden" name="studentId" value="${attr(student.id)}" />
            <input type="hidden" name="classId" value="${attr(student.class_id)}" />
            <input type="hidden" name="source" value="mentor" />
            <div>
              <h3 class="text-sm font-semibold text-gray-900">Отметить отсутствие</h3>

            </div>
            <div class="grid gap-2 sm:grid-cols-2">
              <label class="text-sm text-gray-700">
                <span class="mb-1 block">Начало</span>
                <input name="from" type="datetime-local" value="${attr(defaultSchoolStart())}" required class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" />
              </label>
              <label class="text-sm text-gray-700">
                <span class="mb-1 block">Окончание</span>
                <input name="to" type="datetime-local" value="${attr(defaultSchoolEnd())}" required class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" />
              </label>
            </div>
            <label class="block text-sm text-gray-700">
              <span class="mb-1 block">Причина</span>
              <select name="reason" class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">
                ${reasons.map((reason) => `<option value="${attr(reason.code)}" ${reason.code === defaultReason ? 'selected' : ''}>${escapeHtml(reason.name)}</option>`).join('')}
              </select>
            </label>
            <label class="block text-sm text-gray-700">
              <span class="mb-1 block">Комментарий</span>
              <textarea name="comment" rows="2" maxlength="1000" class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500"></textarea>
            </label>
            <button type="submit" class="workspace-primary text-sm">Сохранить отсутствие</button>
          </form>

          <form class="space-y-3 rounded border border-slate-200 bg-slate-50 p-3" data-create-late>
            <input type="hidden" name="studentId" value="${attr(student.id)}" />
            <input type="hidden" name="classId" value="${attr(student.class_id)}" />
            <div>
              <h3 class="text-sm font-semibold text-gray-900">Отметить опоздание</h3>

            </div>
            <label class="block text-sm text-gray-700">
              <span class="mb-1 block">Время прихода</span>
              <input name="occurredAt" type="datetime-local" value="${attr(defaultLateTime())}" required class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" />
            </label>
            <button type="submit" class="workspace-primary text-sm">Сохранить опоздание</button>
          </form>
        </div>
      ` : ''}

    `;
  }

  function defaultSchoolStart() {
    return analytics.journal_school_day?.start_input || `${localDate()}T09:00`;
  }

  function defaultSchoolEnd() {
    return analytics.journal_school_day?.end_input || `${localDate()}T19:00`;
  }

  function defaultLateTime() {
    const now = new Date();
    const pad = (value) => String(value).padStart(2, '0');
    return `${localDate()}T${pad(now.getHours())}:${pad(now.getMinutes())}`;
  }

  function localDate() { return new Intl.DateTimeFormat('sv-SE', { timeZone: 'Europe/Moscow', year: 'numeric', month: '2-digit', day: '2-digit' }).format(new Date()); }

  function dateTimeInput(value) {
    return String(value || '').slice(0, 16).replace(' ', 'T');
  }

  function periodLabel(period) {
    const start = String(period?.starts_at || '');
    const end = String(period?.ends_at || '');
    const date = (value) => {
      const match = String(value || '').match(/^(\d{4})-(\d{2})-(\d{2})/);
      return match ? `${match[3]}.${match[2]}.${match[1]}` : '';
    };
    const time = (value) => String(value || '').match(/[ T](\d{2}:\d{2})/)?.[1] || '';
    if (!end) return `с ${date(start)} ${time(start)}`.trim();
    return date(start) === date(end)
      ? `${date(start)} · ${time(start)} — ${time(end)}`
      : `${date(start)} ${time(start)} — ${date(end)} ${time(end)}`;
  }

  function focusQuickAction() {
    if (!state.quickAction) return;
    const selector = state.quickAction === 'late' ? '[data-create-late]' : '[data-create-absence]';
    const target = body.querySelector(selector);
    state.quickAction = '';
    target?.scrollIntoView({ behavior: 'smooth', block: 'start' });
    target?.querySelector('input:not([type="hidden"]), select, textarea')?.focus();
  }

  async function ensureHistory(force = false, append = false) {
    if (!state.payload?.student?.id || (!force && state.history !== null)) return;
    const request = state.request; const previous = state.history;
    const params = new URLSearchParams({ limit: '50' });
    const f = state.historyFilters;
    if (f.from) params.set('from', f.from); if (f.to) params.set('to', f.to);
    if (f.includeCancelled) params.set('includeCancelled', '1');
    if (append && previous?.next_cursor) params.set('cursor', previous.next_cursor);
    state.historyError = '';
    try {
      const response = await fetch(`/api/attendance/students/${encodeURIComponent(state.payload.student.id)}/history?${params}`, { headers: { Accept: 'application/json' } });
      if (!response.ok) throw new Error('Не удалось загрузить историю отметок');
      const payload = await response.json(); if (request !== state.request) return;
      const old = append ? previous?.items || [] : [];
      state.history = { items: [...old, ...(payload.items || []).filter((item) => !old.some((entry) => entry.kind === item.kind && entry.id === item.id))], next_cursor: payload.next_cursor || null };
    } catch (err) { state.history = previous || { items: [], next_cursor: null }; state.historyError = err.message || String(err); }
  }

  function renderEditForm(period, reasons) {
    return `
      <details class="mt-3">
        <summary class="cursor-pointer select-none text-sm font-medium text-indigo-700">Изменить</summary>
        <form class="mt-3 space-y-3 rounded border border-gray-100 bg-gray-50 p-3" data-edit-absence="${attr(period.id)}">
          <input type="hidden" name="expectedUpdatedAt" value="${attr(period.expected_updated_at || period.updated_at)}" /><input type="hidden" name="studentId" value="${attr(period.student_id)}" />
          <input type="hidden" name="classId" value="${attr(period.class_id)}" />
          <div class="grid gap-2 md:grid-cols-2">
            <label class="text-sm text-gray-700">
              <span class="mb-1 block">Начало</span>
              <input name="from" type="datetime-local" value="${attr(period.starts_at_input)}" required class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" />
            </label>
            <label class="text-sm text-gray-700">
              <span class="mb-1 block">Окончание</span>
              <input name="to" type="datetime-local" value="${attr(period.ends_at_input)}" class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" />
            </label>
          </div>
          <div class="grid gap-2 md:grid-cols-3">
            <label class="text-sm text-gray-700">
              <span class="mb-1 block">Причина</span>
              <select name="reason" class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">
                ${period.reason_code === 'excused' ? `<option value="${attr(period.reason_code)}" selected>${escapeHtml(period.reason_name)}</option>` : ''}
                ${reasons.map((reason) => `<option value="${attr(reason.code)}" ${reason.code === period.reason_code ? 'selected' : ''}>${escapeHtml(reason.name)}</option>`).join('')}
              </select>
            </label>
            <label class="text-sm text-gray-700">
              <span class="mb-1 block">Подтверждение</span>
              <select name="confirmationStatus" class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">
                ${option('confirmed', 'Подтверждено', period.confirmation_status)}
                ${option('reported', 'Со слов', period.confirmation_status)}
                ${option('needs_clarification', 'Уточнить', period.confirmation_status)}
                ${option('system_conflict', 'Конфликт', period.confirmation_status)}
              </select>
            </label>
            <label class="text-sm text-gray-700">
              <span class="mb-1 block">Внимание</span>
              <select name="attentionStatus" class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">
                ${option('normal', 'Обычная', period.attention_status)}
                ${option('needs_attention', 'Требует внимания', period.attention_status)}
                ${option('resolved', 'Закрыто', period.attention_status)}
              </select>
            </label>
          </div>
          <label class="text-sm text-gray-700">
            <span class="mb-1 block">Комментарий</span>
            <textarea name="comment" rows="2" maxlength="1000" class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">${escapeHtml(period.comment)}</textarea>
          </label>
<label class="block text-sm text-slate-700"><span class="mb-1 block">Причина исправления</span><textarea name="changeReason" rows="2" maxlength="1000" required class="w-full"></textarea></label>
          <button type="submit" class="workspace-primary text-sm">Сохранить изменения</button>
        </form>
      </details>
    `;
  }

  function renderCommentForm(period, past) {
    return `<details class="mt-2"><summary class="workspace-link text-sm">${period.comment ? 'Изменить комментарий' : 'Добавить комментарий'}</summary>
      <form data-comment-absence="${attr(period.id)}" class="mt-2 space-y-3 rounded-lg border border-indigo-100 bg-indigo-50/50 p-3">
        <input type="hidden" name="expectedUpdatedAt" value="${attr(period.expected_updated_at || period.updated_at)}" />
        <label class="block text-sm"><span class="mb-1 block">Комментарий</span><textarea name="comment" rows="3" maxlength="1000" required class="w-full">${escapeHtml(period.comment)}</textarea></label>
        ${past ? '<label class="block text-sm"><span class="mb-1 block">Причина изменения</span><textarea name="changeReason" rows="2" maxlength="1000" required class="w-full"></textarea></label>' : ''}
        <button type="submit" class="workspace-primary text-sm">Сохранить комментарий</button>
      </form></details>`;
  }

  function recentDaysFirst(days) {
    const today = localDate();
    return [...days].sort((a, b) => {
      const aPast = a.date <= today; const bPast = b.date <= today;
      if (aPast !== bPast) return aPast ? -1 : 1;
      return aPast ? b.date.localeCompare(a.date) : a.date.localeCompare(b.date);
    });
  }

  function renderDays(payload) {
    const attendance = payload.attendance || {};
    const mode = state.dayMode === 'absences' ? 'absences' : 'all';
    return `
      ${renderDayModeToggle(mode)}
      ${mode === 'absences'
        ? renderAbsenceDetails(attendance.absence_details || [])
        : renderAttendanceDays(attendance.days || [])}
    `;
  }

  function renderDayModeToggle(mode) {
    const button = (id, label) => `
      <button
        type="button"
        data-student-days-mode="${id}"
        aria-pressed="${mode === id ? 'true' : 'false'}"
        class="min-h-11 rounded-md px-3 py-1.5 text-sm transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-indigo-500 ${mode === id ? 'bg-white font-semibold text-gray-900 shadow-sm' : 'text-gray-600 hover:bg-gray-200 hover:text-gray-900'}"
      >${label}</button>
    `;
    return `
      <div class="mb-4 flex flex-wrap items-center gap-2" role="group" aria-label="Фильтр дней">
        <span class="text-sm font-medium text-gray-700">Показывать:</span>
        <div class="inline-flex rounded-lg bg-gray-100 p-1">
          ${button('all', 'Все дни')}
          ${button('absences', 'Только отсутствия')}
        </div>
      </div>
    `;
  }

  function renderAbsenceDetails(days) {
    if (!days.length) return '<div class="rounded border border-gray-200 bg-gray-50 p-4 text-sm text-gray-500">Дат отсутствия за месяц нет.</div>';
    return `<div class="space-y-2">${recentDaysFirst(days).map((day) => `
      <div class="rounded border border-gray-200 p-3 text-sm">
        <div class="flex flex-col gap-1 sm:flex-row sm:items-center sm:justify-between">
          <div class="font-medium text-gray-900">${escapeHtml(day.short_date_label)} — ${escapeHtml(day.status_label)}${day.absence_state_label && day.absence_state_label.toLowerCase() !== day.status_label?.toLowerCase() ? ` — ${escapeHtml(day.absence_state_label)}` : ''}</div>
          ${day.reason_label ? `<span class="rounded-full px-2 py-0.5 text-xs ${day.is_unexcused ? 'bg-amber-50 text-amber-800' : 'bg-indigo-50 text-indigo-700'}">${escapeHtml(day.reason_label)}</span>` : ''}
        </div>
        ${day.comment_label ? `<div class="mt-1 text-sm text-gray-600">${escapeHtml(day.comment_label)}</div>` : ''}
      </div>
    `).join('')}</div>`;
  }

  function renderAttendanceDays(days) {
    if (!days.length) return '<div class="rounded border border-gray-200 bg-gray-50 p-4 text-sm text-gray-500">Учебных дней за период нет.</div>';
    return `<div class="grid gap-2 md:grid-cols-2">${recentDaysFirst(days).map((day) => `
      <div class="rounded border border-gray-200 p-3 text-sm">
        <div class="flex items-start justify-between gap-2">
          <div>
            <div class="font-medium text-gray-900">${escapeHtml(day.date_label)}</div>
            <div class="mt-1 flex flex-wrap gap-1 text-xs">
              <span class="rounded-full px-2 py-0.5 ${escapeHtml(day.status_class)}">${escapeHtml(day.status_label)}</span>
              ${day.arrival_time ? `<span class="rounded-full bg-emerald-50 px-2 py-0.5 text-emerald-700">присутствие: ${escapeHtml(day.arrival_time)}</span>` : ''}
              ${day.departure_time ? `<span class="rounded-full bg-sky-50 px-2 py-0.5 text-sky-700">уход: ${escapeHtml(day.departure_time)}</span>` : ''}
            </div>
          </div>
        </div>
        ${day.reason_label ? `<div class="mt-2 text-sm text-gray-700">${escapeHtml(day.absence_state_label)} · ${escapeHtml(day.reason_label)}</div>` : ''}
        ${day.is_unconfirmed ? '<div class="mt-2 text-xs font-medium text-amber-800">Не подтверждено</div>' : ''}${day.comment_label ? `<div class="mt-1 text-xs text-gray-500">${escapeHtml(day.comment_label)}</div>` : ''}
      </div>
    `).join('')}</div>`;
  }

  function summaryCard(label, value, tone = 'gray') {
    const toneClass = tone === 'red' ? 'text-red-700' : tone === 'amber' ? 'text-amber-700' : tone === 'green' ? 'text-emerald-700' : tone === 'sky' ? 'text-sky-700' : 'text-gray-900';
    return `<div class="workspace-kpi"><div class="workspace-kpi-label">${escapeHtml(label)}</div><div class="workspace-kpi-value">${escapeHtml(value ?? 0)}</div></div>`;
  }

  function option(value, label, selected) {
    return `<option value="${attr(value)}" ${value === selected ? 'selected' : ''}>${escapeHtml(label)}</option>`;
  }

  function setInlineError(message) {
    const node = body.querySelector('[data-modal-status]');
    if (node) node.remove();
    body.insertAdjacentHTML('afterbegin', status(message, 'red'));
    body.scrollTop = 0;
  }

  document.addEventListener('click', (event) => {
    const quickAbsence = event.target.closest('[data-quick-absence]');
    if (quickAbsence) {
      event.preventDefault();
      openStudent(quickAbsence.dataset.studentId, { tab: 'history', quickAction: 'absence' });
      return;
    }
    const quickLate = event.target.closest('[data-quick-late]');
    if (quickLate) {
      event.preventDefault();
      openStudent(quickLate.dataset.studentId, { tab: 'history', quickAction: 'late' });
      return;
    }
    const button = event.target.closest('[data-student-analytics-open]');
    if (button) {
      event.preventDefault();
      openStudent(button.dataset.studentId, {
        tab: button.dataset.studentOpenTab || 'overview',
        mode: button.dataset.studentOpenMode || 'all',
      });
      return;
    }
    const row = event.target.closest('[data-student-analytics-row]');
    if (row && !event.target.closest('a, button, input, select, textarea, summary')) {
      openStudent(row.dataset.studentId, {
        tab: row.dataset.studentOpenTab || 'overview',
        mode: row.dataset.studentOpenMode || 'all',
      });
    }
  });

  dialog.addEventListener('click', (event) => {
    if (event.target === dialog && !state.busy && allowDiscard()) dialog.close();
    if (event.target.closest('[data-student-modal-close]')) { if (!state.busy && allowDiscard()) dialog.close(); }
    const dayMode = event.target.closest('[data-student-days-mode]');
    if (dayMode) {
      state.dayMode = dayMode.dataset.studentDaysMode || 'all';
    }
    const tab = event.target.closest('[data-student-tab]');
    if (tab) {
      if (tab.dataset.studentDaysMode) state.dayMode = tab.dataset.studentDaysMode;
      selectTab(tab.dataset.studentTab, { focus: tab.getAttribute('role') !== 'tab' });
      return;
    }
    if (dayMode) {
      render();
      body.scrollTop = 0;
    }
  });

  tabs.addEventListener('keydown', (event) => {
    const current = event.target.closest('[role="tab"]');
    if (!current || !['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
    event.preventDefault();
    const buttons = Array.from(tabs.querySelectorAll('[role="tab"]'));
    const currentIndex = buttons.indexOf(current);
    const nextIndex = event.key === 'Home'
      ? 0
      : event.key === 'End'
        ? buttons.length - 1
        : (currentIndex + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length;
    selectTab(buttons[nextIndex]?.dataset.studentTab, { focus: true });
  });

  function allowDiscard() { return !state.dirty || window.confirm('Изменения ещё не сохранены. Закрыть их?'); }
  async function refreshAfterWrite(message) {
    const studentId = state.payload.student.id;
    const results = await Promise.allSettled([
      fetch(`/api/v2/attendance/students/${encodeURIComponent(studentId)}/analytics?month=${encodeURIComponent(analytics.month || '')}`, { headers: { Accept: 'application/json' } }).then(async (response) => { if (!response.ok) throw new Error('Не удалось обновить ученика'); return response.json(); }),
      fetch(window.location.pathname + window.location.search, { headers: { Accept: 'text/html' } }).then(async (response) => { if (!response.ok) throw new Error('Не удалось обновить класс'); return response.text(); }),
    ]);
    if (results[0].status === 'fulfilled') state.payload = results[0].value;
    if (results[1].status === 'fulfilled') {
      const nextDocument = new DOMParser().parseFromString(results[1].value, 'text/html');
      const nextSource = nextDocument.getElementById('analytics-data');
      if (nextSource) {
        const query = document.querySelector('[data-journal-search]')?.value || '';
        analytics = JSON.parse(nextSource.textContent || '{}'); source.textContent = nextSource.textContent;
        document.querySelectorAll('[data-analytics-panel]').forEach((panel) => { const next = nextDocument.querySelector(`[data-analytics-panel="${panel.dataset.analyticsPanel}"]`); if (next) panel.innerHTML = next.innerHTML; });
        const search = document.querySelector('[data-journal-search]'); if (search) search.value = query;
        document.dispatchEvent(new CustomEvent('attendance:analytics-refreshed'));
      }
    }
    await ensureHistory(true);
    render(message);
    if (results.some((result) => result.status === 'rejected')) setInlineError('Отметка сохранена. Часть показателей не обновилась — закройте и снова откройте ученика.');
  }
  dialog.addEventListener('input', (event) => { if (event.target.closest('[data-create-absence], [data-create-late], [data-edit-absence], [data-comment-absence], [data-edit-presence], [data-cancel-history]')) state.dirty = true; });
  dialog.addEventListener('cancel', (event) => { if (state.busy || !allowDiscard()) event.preventDefault(); });
  dialog.addEventListener('close', () => { state.dirty = false; ++state.request; const url = new URL(window.location.href); url.searchParams.delete('student'); url.searchParams.delete('tab'); window.history.replaceState(null, '', url); });
  dialog.addEventListener('click', async (event) => {
    if (state.busy) return;
    const toggle = event.target.closest('[data-create-toggle]');
    if (toggle) { if (!allowDiscard()) return; state.dirty = false; state.createOpen = !state.createOpen; render(); return; }
    const more = event.target.closest('[data-history-more]'); const reset = event.target.closest('[data-history-reset]'); const retry = event.target.closest('[data-history-retry]');
    if (!more && !reset && !retry) return;
    if (!allowDiscard()) return; state.dirty = false;
    if (reset) state.historyFilters = { from: '', to: '', includeCancelled: false };
    const button = more || reset || retry; const scroll = body.scrollTop; button.disabled = true;
    await ensureHistory(true, Boolean(more)); render(); body.scrollTop = more ? scroll : 0;
  });
  dialog.addEventListener('change', (event) => { if (event.target.matches('[data-history-filters] input[type="checkbox"]')) event.target.form.requestSubmit(); });
  dialog.addEventListener('submit', async (event) => {
    const filters = event.target.closest('[data-history-filters]'); const edit = event.target.closest('[data-edit-presence]'); const cancel = event.target.closest('[data-cancel-history]');
    if (!filters && !edit && !cancel) return;
    event.preventDefault(); event.stopImmediatePropagation(); if (state.busy) return;
    const payload = Object.fromEntries(new FormData(event.target));
    if (filters) {
      if (!allowDiscard()) return;
      if (payload.from && payload.to && payload.from > payload.to) { setInlineError('Начало периода должно быть раньше окончания.'); return; }
      state.dirty = false; state.historyFilters = { from: payload.from || '', to: payload.to || '', includeCancelled: Boolean(payload.includeCancelled) };
      await ensureHistory(true); render(); return;
    }
    const button = event.target.querySelector('[type="submit"]'); state.busy = true; if (button) button.disabled = true;
    try {
      let url; let method;
      if (edit) { url = `/api/attendance/presence/events/${encodeURIComponent(edit.dataset.editPresence)}`; method = 'PATCH'; payload.audience = 'children'; }
      else {
        const entry = (state.history?.items || []).find((item) => `${item.kind}:${item.id}` === cancel.dataset.cancelHistory);
        if (!entry) throw new Error('Отметка не найдена. Обновите историю.');
        payload.expectedUpdatedAt = entry.record.expected_updated_at || entry.record.updated_at;
        const absence = entry.kind === 'absence';
        url = absence ? `/api/attendance/absences/${encodeURIComponent(entry.id)}` : `/api/attendance/presence/events/${encodeURIComponent(entry.id)}/cancel`;
        method = absence ? 'DELETE' : 'POST';
        if (!absence) { payload.reason = payload.changeReason || ''; delete payload.changeReason; payload.audience = 'children'; }
      }
      const response = await fetch(url, { method, headers: { Accept: 'application/json', 'Content-Type': 'application/json' }, body: JSON.stringify(payload) });
      if (!response.ok) { const error = await response.json().catch(() => ({})); throw new Error(response.status === 409 ? 'Отметку уже изменили. Введённые значения сохранены в форме. Обновите историю и повторите исправление.' : error.message || 'Не удалось сохранить отметку.'); }
      state.dirty = false; await refreshAfterWrite(cancel ? 'Отметка отменена. Она сохранена в истории изменений.' : 'Изменения сохранены. Посещаемость пересчитана.');
    } catch (err) { setInlineError(err.message || String(err)); }
    finally { state.busy = false; if (button?.isConnected) button.disabled = false; }
  });

  dialog.addEventListener('submit', async (event) => {
    const resolveForm = event.target.closest('[data-resolve-absence]');
    const editForm = event.target.closest('[data-edit-absence]');
    const commentForm = event.target.closest('[data-comment-absence]');
    const createForm = event.target.closest('[data-create-absence]');
    const lateForm = event.target.closest('[data-create-late]');
    if (!resolveForm && !editForm && !commentForm && !createForm && !lateForm) return;
    event.preventDefault();
    if (state.busy) return; state.busy = true;
    const submitButton = event.target.querySelector('[type="submit"]'); if (submitButton) submitButton.disabled = true;
    try {
      if (resolveForm) {
        const id = resolveForm.dataset.resolveAbsence;
        const response = await fetch(`/api/attendance/absences/${encodeURIComponent(id)}/resolve`, {
          method: 'POST',
          headers: { Accept: 'application/json' },
        });
        if (!response.ok) throw new Error('Не удалось закрыть внимание');
      } else if (editForm || commentForm) {
        const id = editForm?.dataset.editAbsence || commentForm.dataset.commentAbsence;
        const payload = Object.fromEntries(new FormData(editForm || commentForm).entries());
        const response = await fetch(`/api/attendance/absences/${encodeURIComponent(id)}`, {
          method: 'PATCH',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) {
          const error = await response.json().catch(() => ({}));
          throw new Error(response.status === 409 ? 'Отметку уже изменили. Введённые значения сохранены в форме. Обновите историю, затем повторите исправление.' : error.message || 'Не удалось сохранить отметку');
        }
      } else if (createForm) {
        const payload = Object.fromEntries(new FormData(createForm).entries());
        const response = await fetch('/api/attendance/absences', {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) {
          const error = await response.json().catch(() => ({}));
          throw new Error(error.message || 'Не удалось добавить отсутствие');
        }
      } else if (lateForm) {
        const payload = Object.fromEntries(new FormData(lateForm).entries());
        payload.idempotencyKey = newIdempotencyKey();
        const response = await fetch('/api/attendance/presence/late', {
          method: 'POST',
          headers: { Accept: 'application/json', 'Content-Type': 'application/json' },
          body: JSON.stringify(payload),
        });
        if (!response.ok) {
          const error = await response.json().catch(() => ({}));
          throw new Error(error.message || 'Не удалось добавить опоздание');
        }
      }
      state.dirty = false; state.createOpen = false;
      await refreshAfterWrite('Сохранено. Посещаемость пересчитана.');
    } catch (err) {
      setInlineError(err.message || String(err));
    } finally { state.busy = false; if (submitButton?.isConnected) submitButton.disabled = false; }
  });

  async function selectTab(tab, { focus = false } = {}) {
    if (state.busy || !allowDiscard()) return; state.dirty = false; state.createOpen = false;
    const url = new URL(window.location.href); url.searchParams.set('tab', normalizeTab(tab)); window.history.replaceState(null, '', url);
    state.tab = normalizeTab(tab);
    render();
    body.scrollTop = 0;
    revealActiveTab({ focus });
    if (state.tab === 'history') {
      await ensureHistory();
      render();
      body.scrollTop = 0;
      revealActiveTab({ focus });
    }
  }

  function newIdempotencyKey() {
    return window.crypto?.randomUUID?.() || `${Date.now()}-${Math.random().toString(16).slice(2)}`;
  }
  const initialStudent = new URLSearchParams(window.location.search);
  if (initialStudent.get('student')) openStudent(initialStudent.get('student'), { tab: initialStudent.get('tab') || 'overview' });
})();
</script>

<script>
(() => {
  const source = document.getElementById('analytics-data');
  const data = JSON.parse(source?.textContent || '{}');
  if (!data.is_adult) return;
  const form = document.querySelector('[data-analytics-controls]');
  form.addEventListener('submit', event => {
    const from = form.elements.from, to = form.elements.to;
    to.setCustomValidity('');
    if (from.value > to.value) to.setCustomValidity('Окончание периода должно быть не раньше начала');
    else if ((Date.parse(to.value) - Date.parse(from.value)) / 86400000 >= 366) to.setCustomValidity('Выберите период не длиннее 366 дней');
    if (!form.reportValidity()) event.preventDefault();
  });
  form.elements.to.addEventListener('input', () => form.elements.to.setCustomValidity(''));
  form.elements.from.addEventListener('input', () => form.elements.to.setCustomValidity(''));
  const search = document.querySelector('[data-staff-search]'), late = document.querySelector('[data-staff-late]');
  const people = [...document.querySelectorAll('.staff-person')];
  const personData = new Map(data.people.map(person => [person.person_id, person]));
  const sort = document.querySelector('[data-staff-sort]');
  function comparePeople(a, b) {
    const minutes = Number(a.total_late_minutes || 0) - Number(b.total_late_minutes || 0);
    return (sort.value === 'late-desc' ? -minutes : sort.value === 'late-asc' ? minutes : 0)
      || a.person_name.localeCompare(b.person_name, 'ru', { numeric: true, sensitivity: 'base' });
  }
  function sortPeople() {
    const empty = document.querySelector('[data-staff-empty]');
    people.sort((a, b) => comparePeople(personData.get(a.dataset.personId), personData.get(b.dataset.personId)));
    for (const person of people) empty.before(person);
  }
  sort.addEventListener('change', sortPeople);
  sortPeople();
  for (const person of people) person.addEventListener('toggle', () => {
    if (!person.open || person.dataset.loaded) return;
    const tbody = person.querySelector('[data-staff-days]');
    for (const day of personData.get(person.dataset.personId)?.days || []) {
      const tr = document.createElement('tr'); tr.dataset.status = day.status;
      const values = [day.date_label + ' ' + day.weekday, day.arrival_time, day.departure_time, day.lesson_time, day.status_label];
      values.forEach((value, index) => {
        const td = document.createElement('td'); td.textContent = value;
        if (index > 0 && index < 4) td.dataset.label = ['','Пришёл','Ушёл','Первый очный урок'][index];
        if (index === 0) td.className = 'whitespace-nowrap';
        if (index === 3 && day.lesson_label) { const label = document.createElement('span'); label.className = 'block text-xs text-gray-500'; label.textContent = day.lesson_label; td.append(label); }
        tr.append(td);
      });
      tbody.append(tr);
    }
    person.dataset.loaded = '1';
  });
  function filter() {
    const query = search.value.trim().toLocaleLowerCase('ru');
    for (const person of people) person.hidden = !person.dataset.personName.toLocaleLowerCase('ru').includes(query) || (late.checked && Number(person.dataset.lateDays) === 0);
    document.querySelector('[data-staff-empty]').hidden = people.some(person => !person.hidden);
  }
  search.addEventListener('input', filter); late.addEventListener('change', filter);
  window.exportStaffDays = (people, report) => {
    const quote = value => { let text = String(value ?? ''); if (/^[=+@\-\t\r]/.test(text)) text = "'" + text; return '"' + text.replaceAll('"', '""') + '"'; };
    const rows = [['Сотрудник', 'Кафедра', 'Дата', 'Пришёл (МСК)', 'Ушёл (МСК)', 'Первый очный урок (МСК)', 'Предмет / класс', 'Статус', 'Минуты опоздания']];
    for (const person of [...people].sort(comparePeople)) for (const day of person.days || []) rows.push([person.person_name, person.department_name, day.date, day.arrival_time, day.departure_time, day.lesson_time, day.lesson_label, day.status_label, day.late_minutes]);
    const url = URL.createObjectURL(new Blob(['\uFEFF' + rows.map(row => row.map(quote).join(';')).join('\r\n')], { type: 'text/csv;charset=utf-8' }));
    const link = document.createElement('a'); link.href = url; link.download = `attendance-staff-${report.period.from}-${report.period.to}${people.length === 1 ? '-' + people[0].person_id : ''}.csv`; document.body.append(link); link.click(); link.remove(); setTimeout(() => URL.revokeObjectURL(url), 1000);
  };
  document.querySelectorAll('[data-staff-export]').forEach(button => button.addEventListener('click', () => window.exportStaffDays(data.people.filter(person => person.person_id === button.dataset.staffExport), data)));
})();
</script>
