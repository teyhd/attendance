<style>
  .student-attendance-page { display: grid; grid-template-columns: minmax(0, 1fr); gap: .75rem; min-width: 0; }
  main:has(> .student-attendance-page) { padding-block: .875rem 1.5rem; }
  .student-page-heading { display: flex; flex-wrap: wrap; align-items: end; justify-content: space-between; gap: .5rem 1rem; }
  .student-page-heading h1 { font-size: 1.5rem; font-weight: 650; line-height: 1.2; }
  .student-page-month { display: flex; align-items: end; gap: .5rem; }
  .student-page-month label { min-width: 0; }
  .student-page-month input { width: 100%; min-width: 0; }
  .student-page-month button { flex: none; }
  .student-page-month [data-month-step] { min-width: 2.75rem; padding-inline: .5rem; }
  .student-page-month [data-month-step][hidden] { display: none; }
  .student-page-tabs { display: flex; flex-wrap: wrap; gap: 0 .375rem; border-bottom: 1px solid #e2e8f0; }
  .student-page-tabs button {
    min-height: 2.75rem;
    padding-inline: .5rem;
    border-bottom: 2px solid transparent;
    color: #475569;
    font-size: .875rem;
    font-weight: 600;
  }
  .student-page-tabs button[aria-selected="true"] { border-color: #1d4ed8; color: #1d4ed8; }
  .student-page-panel { min-width: 0; margin-top: .625rem; padding: .75rem; overflow-wrap: anywhere; }
  .student-page-panel[hidden] { display: none; }
  .student-page-overview { display: grid; gap: .75rem; }
  .student-page-counts { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: .625rem .75rem; }
  .student-page-counts div { padding-inline-start: .5rem; border-inline-start: 2px solid #e2e8f0; }
  .student-page-counts dt { color: #475569; font-size: .8125rem; }
  .student-page-counts dd { margin-top: .125rem; font-size: 1.25rem; line-height: 1.25; font-weight: 650; font-variant-numeric: tabular-nums; }
  .student-page-counts dd span { color: #475569; font-size: .8125rem; font-weight: 500; }
  .student-page-note { margin-top: .625rem; font-size: .8125rem; color: #854d0e; }
  .student-page-overview h2, .student-page-panel h2 { font-size: .9375rem; font-weight: 650; }
  .student-page-row { display: grid; align-items: start; gap: .125rem .75rem; padding-block: .5rem; }
  .student-page-row + .student-page-row { border-top: 1px solid #e2e8f0; }
  .student-page-line { display: flex; flex-wrap: wrap; align-items: baseline; gap: .125rem .625rem; }
  .student-page-subhead { color: #475569; font-size: .8125rem; }
  @media (max-width: 39.99rem) {
    .student-page-month { display: grid; grid-template-columns: auto minmax(0, 1fr) auto auto; width: 100%; gap: .375rem; }
    .student-page-month .workspace-primary { padding-inline: .625rem; }
    .student-page-tabs { gap: 0; }
    .student-page-tabs button { padding-inline: .375rem; font-size: .8125rem; }
  }
  @media (min-width: 40rem) {
    .student-page-counts { grid-template-columns: repeat(4, minmax(0, 1fr)); }
    .student-page-row--detail { grid-template-columns: minmax(9rem, .65fr) minmax(0, 1.2fr) minmax(0, 1fr); }
  }
  @media (min-width: 64rem) {
    .student-page-overview { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); }
    .student-page-note { margin-top: .75rem; }
  }
</style>

<section class="student-attendance-page">
  <header class="student-page-heading">
    <div>
      <h1>Моя посещаемость</h1>
      <p class="mt-1 text-sm text-slate-600">{{analytics.month_label}}{{#if analytics.student.class_name}} · Класс {{analytics.student.class_name}}{{/if}}</p>
    </div>
    <form method="get" action="/attendance/me" class="student-page-month">
      <button type="button" data-month-step="-1" aria-label="Предыдущий месяц" class="workspace-secondary" hidden>‹</button>
      <label class="text-sm text-slate-700">
        <span class="sr-only">Месяц</span>
        <input name="month" value="{{analytics.month}}" type="month" required />
      </label>
      <button type="submit" class="workspace-primary text-sm">Показать</button>
      <button type="button" data-month-step="1" aria-label="Следующий месяц" class="workspace-secondary" hidden>›</button>
    </form>
  </header>

  <div data-student-page-tabs>
    <div role="tablist" aria-label="Моя посещаемость" class="student-page-tabs">
      <button type="button" id="student-tab-overview" role="tab" aria-controls="student-panel-overview" aria-selected="true" data-student-page-tab="overview">Обзор</button>
      <button type="button" id="student-tab-days" role="tab" aria-controls="student-panel-days" aria-selected="false" tabindex="-1" data-student-page-tab="days">По дням</button>
      <button type="button" id="student-tab-absences" role="tab" aria-controls="student-panel-absences" aria-selected="false" tabindex="-1" data-student-page-tab="absences">Отсутствия</button>
      <button type="button" id="student-tab-lessons" role="tab" aria-controls="student-panel-lessons" aria-selected="false" tabindex="-1" data-student-page-tab="lessons">Уроки</button>
      <button type="button" id="student-tab-late" role="tab" aria-controls="student-panel-late" aria-selected="false" tabindex="-1" data-student-page-tab="late">Опоздания</button>
    </div>

    <section id="student-panel-overview" role="tabpanel" aria-labelledby="student-tab-overview" tabindex="0" data-student-page-panel="overview" class="student-page-panel workspace-surface student-page-overview">
      <div>
        <dl class="student-page-counts">
          <div>
            <dt><a href="#days" data-student-page-go="days" class="workspace-link">Дни с присутствием</a></dt>
            <dd>{{#if analytics.attendance.school_days_total}}{{analytics.attendance.present_days}} <span>из {{analytics.attendance.school_days_total}} уч. дн.</span>{{else}}—{{/if}}</dd>
          </div>
          <div>
            <dt><a href="#absences" data-student-page-go="absences" class="workspace-link">Дни без посещений</a></dt>
            <dd>{{#if analytics.attendance.school_days_total}}{{analytics.attendance.absence_days}}{{else}}—{{/if}}</dd>
          </div>
          <div>
            <dt><a href="#lessons" data-student-page-go="lessons" class="workspace-link">Пропущено уроков</a></dt>
            <dd>{{#if analytics.kpi.missed_lessons}}{{analytics.kpi.missed_lessons}}{{else if analytics.kpi.data_gaps}}—{{else if analytics.attendance.school_days_total}}0{{else}}—{{/if}}</dd>
          </div>
          <div>
            <dt><a href="#late" data-student-page-go="late" class="workspace-link">Опоздания</a></dt>
            <dd>{{#if analytics.kpi.late_days}}{{analytics.kpi.late_days}} <span>· {{analytics.kpi.late_minutes}} мин.</span>{{else if analytics.lateness.data_gaps_total}}—{{else if analytics.attendance.school_days_total}}0{{else}}—{{/if}}</dd>
          </div>
        </dl>
        {{#if analytics.attendance.incomplete_days}}<p class="mt-2 text-sm text-slate-600">Присутствие только на части занятий: {{analytics.attendance.incomplete_days}} дн.</p>{{/if}}
        {{#if analytics.kpi.data_gaps}}
          <p class="student-page-note">За дни без расписания пропуски не рассчитаны.</p>
        {{else unless analytics.attendance.school_days_total}}
          <p class="mt-2 text-sm text-slate-600">За этот месяц пока нет прошедших учебных дней с расписанием.</p>
        {{/if}}
      </div>

      <div>
        <h2>Пропуски по предметам</h2>
        {{#if analytics.kpi.missed_lessons}}
          <ul class="mt-1">
            {{#each analytics.learning.subjects}}
              {{#if missed_lessons}}
                <li class="py-1">
                  <div class="flex items-baseline justify-between gap-2 text-sm">
                    <span>{{subject_name}}</span>
                    <strong class="tabular-nums">{{missed_lessons}}</strong>
                  </div>
                  <div class="mt-1 h-1.5 overflow-hidden rounded-full bg-slate-100" aria-hidden="true">
                    <div class="h-full rounded-full bg-blue-700" style="width: {{bar_width}}%;"></div>
                  </div>
                </li>
              {{/if}}
            {{/each}}
          </ul>
        {{else if analytics.kpi.data_gaps}}
          <p class="student-page-subhead mt-1">Недостаточно данных для разбивки по предметам.</p>
        {{else if analytics.attendance.school_days_total}}
          <p class="student-page-subhead mt-1">Пропущенных уроков нет.</p>
        {{else}}
          <p class="student-page-subhead mt-1">Пропуски появятся после первых учебных дней.</p>
        {{/if}}
      </div>
    </section>

    <section id="student-panel-days" role="tabpanel" aria-labelledby="student-tab-days" tabindex="0" data-student-page-panel="days" hidden class="student-page-panel workspace-surface">
      <ul>
        {{#each analytics.attendance.days}}
          <li class="student-page-row text-sm">
            <div class="student-page-line">
              <time datetime="{{date}}" class="font-semibold">{{date_label}}</time>
              <span class="rounded px-1.5 py-0.5 {{status_class}}">{{#if (eq status_code "incomplete")}}Был на части занятий{{else if (eq status_code "conflict")}}Отметки расходятся{{else}}{{status_label}}{{/if}}</span>
            </div>
            {{#if (or arrival_time departure_time)}}
              <div class="student-page-line student-page-subhead">
                {{#if arrival_time}}<span>Приход {{arrival_time}}</span>{{/if}}
                {{#if departure_time}}<span>Уход {{departure_time}}</span>{{/if}}
              </div>
            {{/if}}
            {{#if reason_label}}<p>{{reason_label}}</p>{{/if}}
            {{#if comment_label}}<p class="student-page-subhead">{{comment_label}}</p>{{/if}}
          </li>
        {{else}}
          <li class="text-sm text-slate-600">За этот месяц пока нет учебных дней.</li>
        {{/each}}
      </ul>
    </section>

    <section id="student-panel-absences" role="tabpanel" aria-labelledby="student-tab-absences" tabindex="0" data-student-page-panel="absences" hidden class="student-page-panel workspace-surface">
      <h2 class="mb-1">Отметки об отсутствии</h2>
      <ul>
        {{#each analytics.periods}}
          <li class="student-page-row text-sm">
            <div class="student-page-line">
              <strong>{{reason_name}}</strong>
              <span class="student-page-subhead">{{period_label}}</span>
            </div>
            {{#if comment}}<p>{{comment}}</p>{{/if}}
          </li>
        {{else}}
          <li class="text-sm text-slate-600">Отметок об отсутствии за этот месяц нет.</li>
        {{/each}}
      </ul>
    </section>

    <section id="student-panel-lessons" role="tabpanel" aria-labelledby="student-tab-lessons" tabindex="0" data-student-page-panel="lessons" hidden class="student-page-panel workspace-surface">
      <h2 class="mb-1">Пропуски занятий</h2>
      <ul>
        {{#each analytics.missed_lessons}}
          <li class="student-page-row student-page-row--detail text-sm">
            <div class="student-page-line student-page-subhead">
              <time datetime="{{date}}" class="font-semibold text-slate-900">{{date_label}}</time>
              {{#if time_label}}<span>{{time_label}}</span>{{/if}}
              {{#if lesson_number}}<span>Урок {{lesson_number}}</span>{{/if}}
            </div>
            <div>
              <strong>{{subject_name}}</strong>
              {{#if teacher_name}}<p class="student-page-subhead">{{teacher_name}}</p>{{/if}}
            </div>
            <div>
              {{#if (eq attendance_status "conflict")}}<p class="font-medium text-amber-800">Отметки расходятся</p>
              {{else if is_unconfirmed}}<p class="font-medium text-amber-800">Нет отметки о посещении</p>
              {{else if is_partial}}<p class="font-medium">Пропущена часть урока</p>{{/if}}
              {{#if reason_name}}<p>{{reason_name}}</p>{{/if}}
              {{#if overlap_minutes}}<p class="student-page-subhead">{{overlap_minutes}} мин.{{#unless counts_as_missed_lesson}} · не учтено в числе пропущенных уроков{{/unless}}</p>{{/if}}
              {{#if comment}}<p class="student-page-subhead">{{comment}}</p>{{/if}}
            </div>
          </li>
        {{else}}
          <li class="text-sm text-slate-600">
            {{#if analytics.kpi.data_gaps}}За дни без расписания пропуски не рассчитаны.
            {{else if analytics.attendance.school_days_total}}Пропусков занятий за этот месяц нет.
            {{else}}За этот месяц пока нет прошедших учебных дней с расписанием.{{/if}}
          </li>
        {{/each}}
      </ul>
      {{#if (and analytics.kpi.data_gaps analytics.missed_lessons.length)}}
        <p class="student-page-note">За дни без расписания пропуски не рассчитаны.</p>
      {{/if}}
      {{#if analytics.planned_lessons.length}}
        <h2 class="mt-3 border-t border-slate-200 pt-2">Запланированные пропуски</h2>
        <ul>
          {{#each analytics.planned_lessons}}
            <li class="student-page-row student-page-row--detail text-sm">
              <div class="student-page-line student-page-subhead">
                <time datetime="{{date}}" class="font-semibold text-slate-900">{{date_label}}</time>
                {{#if time_label}}<span>{{time_label}}</span>{{/if}}
                {{#if lesson_number}}<span>Урок {{lesson_number}}</span>{{/if}}
              </div>
              <strong>{{subject_name}}</strong>
              {{#if reason_name}}<span>{{reason_name}}</span>{{/if}}
            </li>
          {{/each}}
        </ul>
      {{/if}}
    </section>

    <section id="student-panel-late" role="tabpanel" aria-labelledby="student-tab-late" tabindex="0" data-student-page-panel="late" hidden class="student-page-panel workspace-surface">
      <ul>
        {{#each analytics.lateness.events}}
          <li class="student-page-row student-page-row--detail text-sm">
            <div class="student-page-line">
              <time datetime="{{date}}" class="font-semibold">{{date_label}}</time>
              <strong class="text-amber-800">{{late_minutes}} мин.</strong>
            </div>
            <div>
              <p>Приход в {{arrival_time}}</p>
              <p class="student-page-subhead">Начало занятий в {{first_lesson_time}}{{#if first_subject_name}} · {{first_subject_name}}{{/if}}</p>
            </div>
            {{#if missed_lessons}}
              <div>
                <p>Пропущено уроков: {{missed_lessons}}</p>
                {{#if missed_lessons_list.length}}
                  <ul class="student-page-subhead">
                    {{#each missed_lessons_list}}
                      <li>{{time_label}} · {{subject_name}}{{#if room_name}} · {{room_name}}{{/if}}</li>
                    {{/each}}
                  </ul>
                {{else if missed_subject_names}}<p class="student-page-subhead">{{missed_subject_names}}</p>{{/if}}
              </div>
            {{/if}}
          </li>
        {{else}}
          <li class="text-sm text-slate-600">
            {{#if analytics.lateness.data_gaps_total}}По отметкам о приходе нет расписания, поэтому опоздания не рассчитаны.
            {{else if analytics.attendance.school_days_total}}Опозданий по расписанию за этот месяц нет.
            {{else}}За этот месяц пока нет прошедших учебных дней с расписанием.{{/if}}
          </li>
        {{/each}}
      </ul>
      {{#if (and analytics.lateness.data_gaps_total analytics.lateness.events.length)}}
        <p class="student-page-note">Приходы без расписания не учтены: {{analytics.lateness.data_gaps_total}}.</p>
      {{/if}}
    </section>
  </div>
</section>

<script>
(() => {
  const root = document.querySelector('[data-student-page-tabs]');
  if (!root) return;

  const buttons = Array.from(root.querySelectorAll('[data-student-page-tab]'));
  const panels = Array.from(root.querySelectorAll('[data-student-page-panel]'));
  const available = new Set(buttons.map((button) => button.dataset.studentPageTab));

  function activate(tab, updateHash = false) {
    const next = available.has(tab) ? tab : 'overview';
    for (const button of buttons) {
      const active = button.dataset.studentPageTab === next;
      button.setAttribute('aria-selected', String(active));
      button.tabIndex = active ? 0 : -1;
    }
    for (const panel of panels) panel.hidden = panel.dataset.studentPagePanel !== next;
    if (updateHash) window.history.replaceState(null, '', `#${next}`);
  }

  buttons.forEach((button, index) => {
    button.addEventListener('click', () => activate(button.dataset.studentPageTab, true));
    button.addEventListener('keydown', (event) => {
      const last = buttons.length - 1;
      const targetIndex = {
        ArrowLeft: (index + last) % buttons.length,
        ArrowRight: (index + 1) % buttons.length,
        Home: 0,
        End: last,
      }[event.key];
      if (!Number.isInteger(targetIndex)) return;
      event.preventDefault();
      const target = buttons[targetIndex];
      activate(target.dataset.studentPageTab, true);
      target.focus();
    });
  });
  root.querySelectorAll('[data-student-page-go]').forEach((link) => link.addEventListener('click', (event) => {
    if (event.ctrlKey || event.metaKey || event.shiftKey || event.altKey) return;
    event.preventDefault();
    activate(link.dataset.studentPageGo, true);
    buttons.find((button) => button.dataset.studentPageTab === link.dataset.studentPageGo)?.focus();
  }));

  const monthForm = document.querySelector('.student-page-month');
  monthForm?.addEventListener('submit', () => {
    const tab = buttons.find((button) => button.getAttribute('aria-selected') === 'true');
    const hash = tab && tab.dataset.studentPageTab !== 'overview' ? `#${tab.dataset.studentPageTab}` : '';
    monthForm.action = `/attendance/me${hash}`;
  });
  monthForm?.querySelectorAll('[data-month-step]').forEach((button) => {
    const input = monthForm.elements.month;
    const displayedMonth = input.defaultValue;
    if (!/^\d{4}-\d{2}$/.test(displayedMonth)) return;
    button.hidden = false;
    button.addEventListener('click', () => {
      const date = new Date(`${displayedMonth}-01T12:00:00Z`);
      date.setUTCMonth(date.getUTCMonth() + Number(button.dataset.monthStep));
      input.value = date.toISOString().slice(0, 7);
      monthForm.requestSubmit();
    });
  });

  window.addEventListener('hashchange', () => activate(window.location.hash.slice(1)));
  activate(window.location.hash.slice(1));
})();
</script>
