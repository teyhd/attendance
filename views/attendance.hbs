<link rel="stylesheet" href="/assets/attendance-workspace.css?v=3">
{{#*inline "attendance-record"}}
  <article id="attendance-{{panel}}-record-{{id}}" class="attendance-record" tabindex="-1" data-attendance-record="{{id}}">
    <div class="attendance-record-content">
      <div class="attendance-record-heading">
        <strong class="attendance-break-text">{{reason_name}}</strong>
        <span class="attendance-record-period attendance-break-text">{{period_label}}</span>
      </div>
      <div class="attendance-record-meta">
        {{#unless (eq confirmation_status "confirmed")}}<span>{{confirmation_label}}</span>{{/unless}}
        {{#if needs_attention}}
          <strong class="text-red-700">{{attention_label}}</strong>
        {{else if is_resolved}}
          <span class="text-green-700">{{attention_label}}</span>
        {{/if}}
      </div>
      {{#if comment}}<p class="attendance-record-comment attendance-break-text">{{comment}}</p>{{/if}}
    </div>
    {{#if canManage}}
      <div class="attendance-record-actions">
        <details name="attendance-{{panel}}-{{id}}" {{#if editDraft.commentOnly}}open{{/if}}>
          <summary class="attendance-record-action">Комментарий</summary>
          <form method="post" action="/attendance/{{id}}/update" class="attendance-record-form space-y-2">
            <input type="hidden" name="expectedUpdatedAt" value="{{#if editDraft.commentOnly}}{{editDraft.expected}}{{else}}{{expected_updated_at}}{{/if}}" />
            <input type="hidden" name="editMode" value="comment" />
            <input type="hidden" name="childId" value="{{student_id}}" />
            <input type="hidden" name="classId" value="{{class_id}}" />
            <input type="hidden" name="date" value="{{selectedDate}}" />
            <input type="hidden" name="filter" value="{{activeFilter}}" />
            <input type="hidden" name="returnTab" value="{{panel}}" />
            <label class="block text-sm text-slate-700"><span id="attendance-comment-{{panel}}-{{id}}" class="mb-1 block">Комментарий</span><textarea name="comment" aria-labelledby="attendance-comment-{{panel}}-{{id}}" rows="2" maxlength="1000" required class="w-full">{{#if editDraft.commentOnly}}{{editDraft.comment}}{{else}}{{comment}}{{/if}}</textarea></label>
            {{#if is_historical}}<label class="block text-sm text-slate-700"><span class="mb-1 block">Причина изменения</span><textarea name="changeReason" rows="2" maxlength="1000" required class="w-full">{{#if editDraft.commentOnly}}{{editDraft.changeReason}}{{/if}}</textarea></label>{{/if}}
            <button type="submit" class="workspace-primary text-sm">Сохранить комментарий</button>
          </form>
        </details>
        <details name="attendance-{{panel}}-{{id}}" {{#if editDraft.fullEdit}}open{{/if}}>
          <summary class="attendance-record-action">Изменить</summary>
          <form method="post" action="/attendance/{{id}}/update" class="attendance-record-form space-y-3">
            <input type="hidden" name="expectedUpdatedAt" value="{{#if editDraft.fullEdit}}{{editDraft.expected}}{{else}}{{expected_updated_at}}{{/if}}" />
            <input type="hidden" name="childId" value="{{student_id}}" />
            <input type="hidden" name="classId" value="{{class_id}}" />
            <input type="hidden" name="date" value="{{selectedDate}}" />
            <input type="hidden" name="filter" value="{{activeFilter}}" />
            <input type="hidden" name="returnTab" value="{{panel}}" />
            <div class="grid sm:grid-cols-2 gap-2">
              <label class="text-sm text-gray-700">
                <span class="block mb-1">Начало</span>
                <input name="from" type="datetime-local" value="{{#if editDraft.fullEdit}}{{editDraft.from}}{{else}}{{starts_at_input}}{{/if}}" required class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" />
              </label>
              <label class="text-sm text-gray-700">
                <span class="block mb-1">Окончание</span>
                <input name="to" type="datetime-local" value="{{#if editDraft.fullEdit}}{{editDraft.to}}{{else}}{{ends_at_input}}{{/if}}" class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500" />
              </label>
            </div>
            <div class="grid sm:grid-cols-3 gap-2">
              <label class="text-sm text-gray-700">
                <span class="block mb-1">Причина</span>
                <select name="reason" class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">
                  {{#if (eq reason_code "excused")}}
                    <option value="{{reason_code}}" selected>{{reason_name}}</option>
                  {{/if}}
                  {{#each reasons}}
                    <option value="{{code}}" {{#if (eq ../reason_code code)}}selected{{/if}}>{{name}}</option>
                  {{/each}}
                </select>
              </label>
              <label class="text-sm text-gray-700">
                <span class="block mb-1">Подтверждение</span>
                <select name="confirmationStatus" class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">
                  <option value="confirmed" {{#if (eq confirmation_status "confirmed")}}selected{{/if}}>Подтверждено</option>
                  <option value="reported" {{#if (eq confirmation_status "reported")}}selected{{/if}}>Со слов</option>
                  <option value="needs_clarification" {{#if (eq confirmation_status "needs_clarification")}}selected{{/if}}>Уточнить</option>
                  <option value="system_conflict" {{#if (eq confirmation_status "system_conflict")}}selected{{/if}}>Конфликт</option>
                </select>
              </label>
              <label class="text-sm text-gray-700">
                <span class="block mb-1">Внимание</span>
                <select name="attentionStatus" class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">
                  <option value="normal" {{#if (eq attention_status "normal")}}selected{{/if}}>Обычная</option>
                  <option value="needs_attention" {{#if (eq attention_status "needs_attention")}}selected{{/if}}>Требует внимания</option>
                  <option value="resolved" {{#if (eq attention_status "resolved")}}selected{{/if}}>Закрыто</option>
                </select>
              </label>
            </div>
            <label class="text-sm text-gray-700">
              <span id="attendance-edit-comment-{{panel}}-{{id}}" class="block mb-1">Комментарий</span>
              <textarea name="comment" aria-labelledby="attendance-edit-comment-{{panel}}-{{id}}" rows="2" maxlength="1000" class="w-full rounded border-gray-300 focus:border-indigo-500 focus:ring-indigo-500">{{#if editDraft.fullEdit}}{{editDraft.comment}}{{else}}{{comment}}{{/if}}</textarea>
            </label>
            <label class="block text-sm text-gray-700"><span class="mb-1 block">Причина исправления</span><textarea name="changeReason" rows="2" maxlength="1000" required class="w-full" placeholder="Почему нужно изменить отметку">{{#if editDraft.fullEdit}}{{editDraft.changeReason}}{{/if}}</textarea></label>
            <button type="submit" class="workspace-primary text-sm">Сохранить изменения</button>
          </form>
        </details>
        <details name="attendance-{{panel}}-{{id}}">
          <summary class="attendance-record-action attendance-record-cancel">Отменить</summary>
          <form method="post" action="/attendance/{{id}}/delete" class="attendance-record-form space-y-2">
            <input type="hidden" name="childId" value="{{student_id}}" />
            <input type="hidden" name="classId" value="{{class_id}}" />
            <input type="hidden" name="date" value="{{selectedDate}}" />
            <input type="hidden" name="filter" value="{{activeFilter}}" />
            <input type="hidden" name="returnTab" value="{{panel}}" />
            <input type="hidden" name="expectedUpdatedAt" value="{{expected_updated_at}}" />
            <label class="block text-sm"><span class="mb-1 block">Причина отмены</span><textarea name="changeReason" required rows="2" maxlength="1000" class="w-full"></textarea></label>
            <button type="submit" class="workspace-danger">Подтвердить отмену</button>
          </form>
        </details>
        {{#if needs_attention}}
          <form method="post" action="/attendance/{{id}}/resolve">
            <input type="hidden" name="childId" value="{{student_id}}" />
            <input type="hidden" name="classId" value="{{class_id}}" />
            <input type="hidden" name="date" value="{{selectedDate}}" />
            <input type="hidden" name="filter" value="{{activeFilter}}" />
            <input type="hidden" name="returnTab" value="{{panel}}" />
            <button type="submit" class="attendance-record-action attendance-record-resolve">Закрыть вопрос</button>
          </form>
        {{/if}}
      </div>
    {{/if}}
  </article>
{{/inline}}
<section class="attendance-workspace">
  <div class="attendance-toolbar">
    <h1 class="workspace-title">Пропуски</h1>
    {{#if attendanceSummaryFilters.length}}
      <nav class="attendance-filters" aria-label="Сводка пропусков">
        {{#each attendanceSummaryFilters}}
          <a href="{{href}}" {{#if active}}aria-current="true"{{/if}} class="attendance-filter">
            <span>{{#if (eq id 'all')}}Ученики{{else}}{{label}}{{/if}}</span>
            <strong class="{{value_class}}">{{value}}</strong>
            {{#if (eq detail_class 'text-red-700')}}<small class="{{detail_class}}">{{detail}}</small>{{/if}}
          </a>
        {{/each}}
      </nav>
    {{/if}}
  </div>

  {{#if attendanceFilterTable.visible}}
    <details id="attendance-filter-table" class="attendance-results workspace-surface" open>
      <summary id="attendance-filter-title">{{attendanceFilterTable.title}} <span>Отметки · {{attendanceFilterTable.count}}</span></summary>
        {{#if attendanceFilterTable.rows.length}}
          <div class="attendance-results-table" tabindex="0" role="region" aria-label="Список отметок">
            <table data-attendance-filter-rows role="table" aria-labelledby="attendance-filter-title" class="text-sm">
              <thead role="rowgroup" class="text-xs text-gray-500">
                <tr role="row" class="border-b">
                  <th role="columnheader" scope="col" class="attendance-break-text py-1.5 pr-3 text-left font-medium">Ученик</th>
                  <th role="columnheader" scope="col" class="attendance-break-text py-1.5 pr-3 text-left font-medium">Период</th>
                  <th role="columnheader" scope="col" class="attendance-break-text py-1.5 pr-3 text-left font-medium">Причина</th>
                  <th role="columnheader" scope="col" class="attendance-break-text py-1.5 pr-3 text-left font-medium">Статус</th>
                  <th role="columnheader" scope="col" class="attendance-break-text py-1.5 text-left font-medium">Комментарий</th>
                </tr>
              </thead>
              <tbody role="rowgroup" class="divide-y divide-gray-100">
                {{#each attendanceFilterTable.rows}}
                  <tr role="row" class="hover:bg-indigo-50">
                    <td role="cell" class="attendance-break-text py-2 pr-3 align-top font-medium text-gray-900">
                      <a href="{{href}}#attendance-history-record-{{id}}" class="hover:text-indigo-700">{{student_name}}</a>
                    </td>
                    <td role="cell" class="attendance-break-text py-2 pr-3 align-top text-gray-700">{{period_label}}</td>
                    <td role="cell" class="attendance-break-text py-2 pr-3 align-top">
                      <span class="attendance-filter-label" aria-hidden="true">Причина</span>
                      <span class="rounded-full px-2 py-0.5 text-xs {{reason_class}}">{{reason_name}}</span>
                    </td>
                    <td role="cell" class="attendance-break-text py-2 pr-3 align-top">
                      <span class="attendance-filter-label" aria-hidden="true">Статус</span>
                      <span class="rounded-full px-2 py-0.5 text-xs {{attention_class}}">{{attention_label}}</span>
                    </td>
                    <td role="cell" class="attendance-break-text py-2 align-top text-gray-600 {{#unless comment}}attendance-no-comment{{/unless}}">
                      <span class="attendance-filter-label" aria-hidden="true">Комментарий</span>
                      {{#if comment}}{{comment}}{{else}}<span class="text-gray-400">—</span>{{/if}}
                    </td>
                  </tr>
                {{/each}}
              </tbody>
            </table>
          </div>
        {{else}}
          <div class="border-t border-slate-200 px-3 py-2 text-sm text-gray-500">{{attendanceFilterTable.empty_label}}</div>
        {{/if}}
    </details>
  {{/if}}

  <div class="attendance-columns">
    <form id="attendance-class-form" method="get" action="/attendance" class="attendance-class-form min-w-0">
      <input type="hidden" name="student" value="{{selectedStudentId}}" />
      <input type="hidden" name="filter" value="{{activeFilter}}" />
      <input type="hidden" name="tab" value="{{selectedTab}}" />
      <label for="class-select" class="sr-only">Класс</label>
      <select id="class-select" data-testid="class-select" name="class" data-class-keyboard="Класс">
        {{#each classes}}
          <option value="{{id}}" {{#if (eq ../selectedClass id)}}selected{{/if}}>{{name}}</option>
        {{/each}}
      </select>
    </form>
    <aside data-attendance-roster class="attendance-roster workspace-surface">
        <div class="attendance-roster-date">
          <label for="attendance-date">Дата</label>
          <input id="attendance-date" type="date" name="date" value="{{selectedDate}}" form="attendance-class-form" required>
          <noscript><button type="submit" form="attendance-class-form">Показать</button></noscript>
        </div>
      {{#if children.length}}
        <label class="workspace-mobile-picker min-w-0">
          <span class="sr-only">Ученик</span>
          <select data-mobile-student-select>
            {{#each children}}<option value="{{href}}" {{#if isActive}}selected{{/if}}>{{name}}</option>{{/each}}
          </select>
        </label>
        <label class="attendance-roster-search">
          <span class="sr-only">Найти ученика</span>
          <input type="search" data-attendance-student-search placeholder="Найти ученика" autocomplete="off">
        </label>
        <div class="attendance-roster-title">
          <h2>Ученики</h2>
          <span data-attendance-student-count aria-live="polite">{{children.length}}</span>
        </div>
        <div class="attendance-roster-list workspace-desktop-students">
          {{#each children}}
            <a href="{{href}}#attendance-student" data-attendance-student-row data-student-name="{{name}}" {{#if isActive}}aria-current="true"{{/if}} class="attendance-student-row">
              <span class="font-medium">{{name}}</span>
              <span class="attendance-roster-status">
                {{#if hasCurrentAbsence}}<span class="font-medium text-amber-800">Отсутствует</span>{{/if}}
                {{#if hasFutureAbsence}}<span class="font-medium text-sky-800">Запланировано</span>{{/if}}
                {{#if hasMissingReason}}<span class="font-medium text-amber-800">Без причины</span>{{else if dayAbsence}}<span>{{dayAbsence.reason_name}}</span>{{/if}}
                {{#if needsAttention}}<span class="font-medium text-red-700">Требует внимания</span>{{/if}}
                {{#if isFrequent}}<span>Частые пропуски</span>{{/if}}
              </span>
            </a>
          {{/each}}
        </div>
        <p data-attendance-student-empty class="attendance-roster-empty text-sm text-slate-600" role="status" hidden>Ученики не найдены</p>
      {{/if}}
    </aside>

    <div id="attendance-student" tabindex="-1" class="attendance-student workspace-surface">
      {{#if error}}
        <div id="attendance-feedback" tabindex="-1" role="alert" class="attendance-break-text rounded border border-red-200 bg-red-50 text-red-800 mb-2 px-3 py-2 text-sm">{{error}}</div>
      {{else if success}}
        <div id="attendance-feedback" tabindex="-1" role="status" class="rounded border border-green-200 bg-green-50 text-green-800 mb-2 px-3 py-2 text-sm">
          {{#if (eq success "created")}}Отметка сохранена.{{/if}}
          {{#if batchCreatedCount}}Отметки созданы: {{batchCreatedCount}}.{{/if}}
          {{#if (eq success "updated")}}Отметка обновлена.{{/if}}
          {{#if (eq success "deleted")}}Отметка отменена.{{/if}}
          {{#if (eq success "resolved")}}Вопрос закрыт.{{/if}}
        </div>
      {{/if}}
      {{#if selectedChild}}
        <div class="attendance-student-heading">
          <div class="min-w-0">
            <h2 class="attendance-break-text">{{selectedChild.name}}</h2>
            <div class="attendance-student-meta">
              <span>Класс {{#with (findById classes selectedChild.classId)}}{{name}}{{/with}}</span>
              {{#if studentContext}}<span>Присутствие · <strong>{{studentContext.present_days}}</strong> из {{studentContext.present_days_window}} дней</span>{{/if}}
            </div>
          </div>
          <div class="attendance-student-links">
            <a href="{{studentAnalyticsHref}}">Аналитика ученика</a>
            <a href="{{studentAnalyticsHref}}&export=1">Скачать отчёт</a>
          </div>
        </div>
        {{#if studentContext.last_comment}}
          <p class="attendance-last-comment attendance-break-text mt-1 line-clamp-2 text-sm text-slate-600">{{studentContext.last_comment}}</p>
        {{/if}}

        <div data-attendance-tabs data-default-tab="{{#if canManage}}mark{{else}}active{{/if}}" data-selected-tab="{{selectedTab}}" data-selected-record="{{selectedRecordId}}" {{#if draft}}data-attendance-draft{{/if}}>
          <div class="workspace-tabs" role="tablist" aria-label="Отметки ученика">
            {{#if canManage}}
              <button type="button" id="attendance-tab-mark" role="tab" aria-controls="attendance-panel-mark" data-attendance-tab="mark">Новая отметка</button>
            {{/if}}
            <button type="button" id="attendance-tab-active" role="tab" aria-controls="attendance-panel-active" data-attendance-tab="active">
              Активные <span class="ml-1 text-xs text-gray-500">{{currentAbsences.length}}</span>
            </button>
            <button type="button" id="attendance-tab-history" role="tab" aria-controls="attendance-panel-history" data-attendance-tab="history">
              История <span class="ml-1 text-xs text-gray-500">{{childAbsences.length}}</span>
            </button>
          </div>

          {{#if canManage}}
            <section id="attendance-panel-mark" role="tabpanel" aria-labelledby="attendance-tab-mark" data-attendance-panel="mark">
              <form id="new-absence-form" method="post" action="/attendance" class="attendance-mark-form" data-school-day-start="{{schoolDay.start_input}}" data-school-day-end="{{schoolDay.end_input}}">
                <input type="hidden" name="childId" value="{{selectedChild.id}}" />
                <input type="hidden" name="classId" value="{{selectedChild.classId}}" />
                <input type="hidden" name="date" value="{{selectedDate}}" />
                <input type="hidden" name="filter" value="{{activeFilter}}" />
                <input type="hidden" name="source" value="mentor" />

                <div class="attendance-period">
                  <label class="block">
                    <span class="attendance-field-label">Начало</span>
                    <input id="absence-from" name="from" type="datetime-local" value="{{#if draft}}{{draft.from}}{{else}}{{defaultFrom}}{{/if}}" required />
                  </label>
                  <label class="block">
                    <span class="attendance-field-label">Окончание <span class="attendance-field-hint">(можно оставить открытым)</span></span>
                    <input id="absence-to" name="to" type="datetime-local" value="{{draft.to}}" aria-describedby="absence-period-error" />
                  </label>
                  <div class="attendance-presets" role="group" aria-label="Быстрый выбор окончания">
                    <button type="button" data-fill="day-end" aria-pressed="false" title="До {{schoolDay.end_label}}">До конца дня</button>
                    <button type="button" data-fill="lesson" aria-pressed="false">На 45 минут</button>
                  </div>
                </div>
                <p id="absence-period-error" role="status" class="text-sm text-red-800" hidden></p>

                <div class="attendance-mark-details">
                  <label class="block">
                    <span class="attendance-field-label">Причина</span>
                    <select id="reason" name="reason">
                      {{#each reasons}}
                        <option value="{{code}}" {{#if (eq ../draft.reason code)}}selected{{/if}}>{{name}}</option>
                      {{/each}}
                    </select>
                  </label>
                  <label class="block">
                    <span class="attendance-field-label">Комментарий</span>
                    <textarea id="comment" name="comment" aria-describedby="absence-reason-note" rows="2" maxlength="1000">{{draft.comment}}</textarea>
                  </label>
                </div>

                <div id="absence-reason-note" data-reason-note role="status" class="hidden rounded border border-amber-200 bg-amber-50 px-3 py-2 text-sm text-amber-900"></div>

                <div class="attendance-form-actions">
                  <label class="attendance-repeat">
                    <input id="repeat-weekly" type="checkbox" name="repeatWeekly" value="1" aria-controls="repeat-options" {{#if draft.repeatWeekly}}checked{{/if}} />
                    Повторять по дням недели
                  </label>
                  <div id="repeat-options" class="attendance-repeat-options space-y-2 {{#unless draft.repeatWeekly}}hidden{{/unless}}" data-selected-days="{{#each draft.repeatWeekdays}}{{this}} {{/each}}">
                    <fieldset>
                      <legend class="mb-2 text-sm font-medium text-slate-700">В какие дни</legend>
                      <div class="grid grid-cols-4 gap-2 sm:grid-cols-7">
                        <label class="repeat-day"><input type="checkbox" name="repeatWeekdays" value="1" />Пн</label>
                        <label class="repeat-day"><input type="checkbox" name="repeatWeekdays" value="2" />Вт</label>
                        <label class="repeat-day"><input type="checkbox" name="repeatWeekdays" value="3" />Ср</label>
                        <label class="repeat-day"><input type="checkbox" name="repeatWeekdays" value="4" />Чт</label>
                        <label class="repeat-day"><input type="checkbox" name="repeatWeekdays" value="5" />Пт</label>
                        <label class="repeat-day"><input type="checkbox" name="repeatWeekdays" value="6" />Сб</label>
                        <label class="repeat-day"><input type="checkbox" name="repeatWeekdays" value="7" />Вс</label>
                      </div>
                    </fieldset>
                    <label class="block max-w-xs text-sm font-medium text-slate-700">
                      <span class="mb-1 block">Повторять по</span>
                      <input id="repeat-until" name="repeatUntil" type="date" value="{{draft.repeatUntil}}" class="h-11 w-full rounded border border-slate-300 bg-white px-3 text-base" />
                    </label>
                    <p id="repeat-preview" role="status" aria-live="polite" class="text-sm text-indigo-700"></p>
                  </div>
                  <button id="absence-submit" type="submit" class="workspace-primary">Сохранить отметку</button>
                </div>
              </form>
            </section>
          {{/if}}

          <section id="attendance-panel-active" role="tabpanel" aria-labelledby="attendance-tab-active" tabindex="0" data-attendance-panel="active" class="{{#if canManage}}hidden{{/if}}">
            {{#if currentAbsences.length}}
              {{#if activeNowAbsences.length}}
                <h3 class="attendance-record-group">Сейчас</h3>
                <div class="attendance-record-list">
                  {{#each activeNowAbsences}}
                    {{> attendance-record this canManage=../canManage selectedDate=../selectedDate activeFilter=../activeFilter reasons=../reasons panel="active"}}
                  {{/each}}
                </div>
              {{/if}}
              {{#if futureAbsences.length}}
                <h3 class="attendance-record-group">Запланировано</h3>
                <div class="attendance-record-list">
                  {{#each futureAbsences}}
                    {{> attendance-record this canManage=../canManage selectedDate=../selectedDate activeFilter=../activeFilter reasons=../reasons panel="active"}}
                  {{/each}}
                </div>
              {{/if}}
            {{else}}
              <p class="text-sm text-gray-500">Активных и будущих отметок нет.</p>
            {{/if}}
          </section>

          <section id="attendance-panel-history" role="tabpanel" aria-labelledby="attendance-tab-history" tabindex="0" data-attendance-panel="history" class="hidden">
            <div class="attendance-history-heading">
              <h3>Последние периоды отсутствия</h3>
              <a href="{{studentAnalyticsHref}}&tab=history" class="workspace-link text-sm">Все события</a>
            </div>
            {{#if childAbsences.length}}
              <div class="attendance-record-list">
                {{#each childAbsences}}
                  {{> attendance-record this canManage=../canManage selectedDate=../selectedDate activeFilter=../activeFilter reasons=../reasons panel="history"}}
                {{/each}}
              </div>
            {{else}}
              <p class="text-sm text-gray-500">Отметок пока нет.</p>
            {{/if}}
          </section>
        </div>
      {{else}}
        <div class="text-sm text-gray-500">В выбранном классе нет учеников.</div>
      {{/if}}
    </div>
  </div>
</section>

<script>
(() => {
  const classSelect = document.getElementById('class-select');
  const roster = document.querySelector('[data-attendance-roster]');
  const search = roster?.querySelector('[data-attendance-student-search]');
  const picker = roster?.querySelector('[data-mobile-student-select]');
  const rows = Array.from(roster?.querySelectorAll('[data-attendance-student-row]') || []);
  const forms = Array.from(document.querySelectorAll('.attendance-workspace form[method="post"]'));
  const readDraft = (form) => JSON.stringify(Array.from(new FormData(form)));
  const initialDrafts = new Map(forms.map((form) => [form, readDraft(form)]));
  const protectDrafts = (event) => {
    if (forms.some((form) => readDraft(form) !== initialDrafts.get(form))) {
      event.preventDefault();
      event.returnValue = true;
    }
  };
  forms.forEach((form) => {
    form.addEventListener('input', () => window.addEventListener('beforeunload', protectDrafts));
    form.addEventListener('click', (event) => {
      if (event.target.closest('[data-fill]')) window.addEventListener('beforeunload', protectDrafts);
    });
    form.addEventListener('submit', (event) => {
      if (!event.defaultPrevented) window.removeEventListener('beforeunload', protectDrafts);
    });
  });
  const normalizeName = (value) => value.toLocaleLowerCase('ru').replace(/ё/g, 'е').trim();
  const openStudent = (value) => {
    if (!value) return;
    const url = new URL(value, window.location.href);
    url.hash = 'attendance-student';
    window.location.assign(url);
  };
  picker?.addEventListener('change', () => openStudent(picker.value));
  search?.addEventListener('input', () => {
    const words = normalizeName(search.value).split(/\s+/).filter(Boolean);
    roster.classList.toggle('is-searching', words.length > 0);
    let matchCount = 0;
    for (const row of rows) {
      const name = normalizeName(row.dataset.studentName);
      row.hidden = !words.every((word) => name.includes(word));
      if (!row.hidden) matchCount += 1;
    }
    roster.querySelector('[data-attendance-student-count]').textContent = words.length ? `${matchCount} из ${rows.length}` : String(rows.length);
    roster.querySelector('[data-attendance-student-empty]').hidden = matchCount > 0;
  });
  search?.addEventListener('keydown', (event) => {
    if (event.key !== 'Enter' || event.isComposing || !search.value.trim()) return;
    const first = rows.find((row) => !row.hidden);
    if (first) {
      event.preventDefault();
      openStudent(first.href);
    }
  });
  const dateSelect = document.getElementById('attendance-date');
  classSelect?.addEventListener('change', () => {
    classSelect.form.elements.namedItem('student').disabled = true;
    classSelect.form.requestSubmit();
  });
  dateSelect?.addEventListener('change', () => { if (dateSelect.value) dateSelect.form.requestSubmit(); });

  document.getElementById('attendance-feedback')?.focus();

  const tabsRoot = document.querySelector('[data-attendance-tabs]');
  if (tabsRoot) {
    const storageKey = 'attendance.activeTab';
    const buttons = Array.from(tabsRoot.querySelectorAll('[data-attendance-tab]'));
    const panels = Array.from(tabsRoot.querySelectorAll('[data-attendance-panel]'));
    const available = new Set(buttons.map((button) => button.dataset.attendanceTab));
    const defaultTab = tabsRoot.dataset.defaultTab || buttons[0]?.dataset.attendanceTab || '';
    const hashTab = window.location.hash.startsWith('#attendance-') ? window.location.hash.replace('#attendance-', '') : '';
    const storedTab = sessionStorage.getItem(storageKey) || '';
    const selectedTab = tabsRoot.dataset.selectedTab;

    const activate = (tab, updateLocation = false) => {
      const nextTab = available.has(tab) ? tab : defaultTab;
      buttons.forEach((button) => {
        const active = button.dataset.attendanceTab === nextTab;
        button.setAttribute('aria-selected', String(active));
        button.tabIndex = active ? 0 : -1;
      });
      panels.forEach((panel) => panel.classList.toggle('hidden', panel.dataset.attendancePanel !== nextTab));
      sessionStorage.setItem(storageKey, nextTab);
      document.getElementById('attendance-class-form').elements.namedItem('tab').value = nextTab;
      if (updateLocation) {
        const url = new URL(window.location.href);
        url.searchParams.set('tab', nextTab);
        url.searchParams.delete('record');
        url.hash = 'attendance-student';
        window.history.replaceState(null, '', url);
      }
    };

    buttons.forEach((button) => {
      button.addEventListener('keydown', (event) => {
        if (!['ArrowLeft', 'ArrowRight', 'Home', 'End'].includes(event.key)) return;
        event.preventDefault();
        const index = buttons.indexOf(button);
        const next = event.key === 'Home' ? 0 : event.key === 'End' ? buttons.length - 1 : (index + (event.key === 'ArrowRight' ? 1 : -1) + buttons.length) % buttons.length;
        activate(buttons[next].dataset.attendanceTab, true); buttons[next].focus();
      });
      button.addEventListener('click', () => activate(button.dataset.attendanceTab, true));
    });

    const requestedTab = [hashTab, selectedTab, storedTab].find((tab) => available.has(tab));
    activate(tabsRoot.hasAttribute('data-attendance-draft') ? 'mark' : requestedTab);
    if (tabsRoot.dataset.selectedRecord && selectedTab === 'history') {
      document.getElementById(`attendance-history-record-${tabsRoot.dataset.selectedRecord}`)?.focus();
    }
  }

  const applyReasonState = (form, syncStatuses = false) => {
    const reasonSelect = form.querySelector('select[name="reason"]');
    const commentField = form.querySelector('textarea[name="comment"]');
    if (!reasonSelect || !commentField) return;

    const reason = reasonSelect.value;
    const note = form.querySelector('[data-reason-note]');
    commentField.required = reason === 'other';
    commentField.placeholder = reason === 'without_reason'
      ? 'Что нужно уточнить'
      : reason === 'other'
        ? 'Опишите причину'
        : 'Комментарий';
    if (note) {
      const message = reason === 'without_reason'
        ? 'Отметка попадет в «Требуют внимания».'
        : reason === 'other'
          ? 'Комментарий обязателен.'
          : '';
      note.textContent = message;
      note.classList.toggle('hidden', !message);
    }

    if (!syncStatuses) return;
    const confirmationSelect = form.querySelector('select[name="confirmationStatus"]');
    const attentionSelect = form.querySelector('select[name="attentionStatus"]');
    if (reason === 'without_reason') {
      if (confirmationSelect) confirmationSelect.value = 'needs_clarification';
      if (attentionSelect && attentionSelect.value === 'normal') attentionSelect.value = 'needs_attention';
    }
    if (reason === 'other') {
      if (confirmationSelect && confirmationSelect.value === 'needs_clarification') confirmationSelect.value = 'reported';
      if (attentionSelect && attentionSelect.value === 'needs_attention') attentionSelect.value = 'normal';
    }
  };

  document.querySelectorAll('form').forEach((form) => {
    const reasonSelect = form.querySelector('select[name="reason"]');
    if (!reasonSelect) return;
    applyReasonState(form);
    reasonSelect.addEventListener('change', () => applyReasonState(form, true));
  });

  const fromInput = document.getElementById('absence-from');
  const toInput = document.getElementById('absence-to');
  if (!fromInput || !toInput) return;
  const form = document.getElementById('new-absence-form');
  const selectedDate = form?.querySelector('input[name="date"]')?.value || '';
  const schoolDayStart = form?.dataset.schoolDayStart || '';
  const schoolDayEnd = form?.dataset.schoolDayEnd || '';
  const quickButtons = Array.from(document.querySelectorAll('[data-fill]'));
  const repeatToggle = document.getElementById('repeat-weekly');
  const repeatOptions = document.getElementById('repeat-options');
  const repeatUntil = document.getElementById('repeat-until');
  const repeatPreview = document.getElementById('repeat-preview');
  const absenceSubmit = document.getElementById('absence-submit');
  const periodError = document.getElementById('absence-period-error');
  const repeatDays = Array.from(form?.querySelectorAll('input[name="repeatWeekdays"]') || []);
  const draftDays = new Set((repeatOptions.dataset.selectedDays || '').trim().split(' '));
  repeatDays.forEach((day) => { day.checked = draftDays.has(day.value); });
  let repeatDaysTouched = repeatToggle.checked;

  const syncPeriod = () => {
    let message = '';
    if (fromInput.value && toInput.value) {
      if (toInput.value <= fromInput.value) {
        message = 'Укажите окончание отсутствия позже начала.';
      } else if (repeatToggle.checked && toInput.value.slice(0, 10) !== fromInput.value.slice(0, 10)) {
        message = 'Для повторов начало и окончание должны быть в один день.';
      }
    }
    toInput.setCustomValidity(message);
    if (message) toInput.setAttribute('aria-invalid', 'true');
    else toInput.removeAttribute('aria-invalid');
    periodError.textContent = message;
    periodError.hidden = !message;
  };

  const isoDay = (date) => date.toISOString().slice(0, 10);
  const utcDay = (value) => new Date(`${value}T00:00:00Z`);
  const markWord = (count) => count % 10 === 1 && count % 100 !== 11 ? 'отметка' : count % 10 >= 2 && count % 10 <= 4 && (count % 100 < 12 || count % 100 > 14) ? 'отметки' : 'отметок';
  const selectStartWeekday = () => {
    const first = utcDay(fromInput.value.slice(0, 10));
    if (Number.isNaN(first.getTime())) return;
    const weekday = String(first.getUTCDay() || 7);
    repeatDays.forEach((day) => { day.checked = day.value === weekday; });
  };
  const syncRepeat = () => {
    const active = repeatToggle.checked;
    repeatOptions.classList.toggle('hidden', !active);
    repeatUntil.required = active;
    repeatUntil.disabled = !active;
    if (!active) {
      absenceSubmit.textContent = 'Сохранить отметку';
      return;
    }
    repeatPreview.dataset.count = '0';
    absenceSubmit.textContent = 'Создать отметки';
    const startDate = fromInput.value.slice(0, 10);
    const first = utcDay(startDate);
    if (Number.isNaN(first.getTime())) {
      repeatUntil.removeAttribute('min');
      repeatUntil.removeAttribute('max');
      repeatPreview.textContent = 'Сначала укажите дату начала.';
      return;
    }
    const limit = new Date(first.getTime() + 90 * 86400000);
    repeatUntil.min = startDate;
    repeatUntil.max = isoDay(limit);
    const last = utcDay(repeatUntil.value);
    const selected = new Set(repeatDays.filter((day) => day.checked).map((day) => day.value));
    if (!selected.size) { repeatPreview.textContent = 'Выберите хотя бы один день недели.'; return; }
    if (Number.isNaN(last.getTime()) || last < first || last > limit) {
      repeatPreview.textContent = 'Выберите дату окончания повторов в пределах 90 дней.';
      return;
    }
    let count = 0;
    for (let day = first; day <= last; day = new Date(day.getTime() + 86400000)) {
      if (selected.has(String(day.getUTCDay() || 7))) count += 1;
    }
    repeatPreview.dataset.count = String(count);
    repeatPreview.textContent = count > 60 ? 'Выберите меньший период: не более 60 отметок за раз.' : count ? `Будет создано ${count} ${markWord(count)}` : 'В этом периоде нет выбранных дней недели.';
    if (count > 0 && count <= 60) {
      absenceSubmit.textContent = `Создать ${count} ${markWord(count) === 'отметка' ? 'отметку' : markWord(count)}`;
    }
  };

  repeatToggle.addEventListener('change', () => {
    if (repeatToggle.checked) {
      const first = utcDay(fromInput.value.slice(0, 10));
      if (!Number.isNaN(first.getTime())) {
        if (!repeatDaysTouched) selectStartWeekday();
        if (!repeatUntil.value) repeatUntil.value = isoDay(new Date(first.getTime() + 28 * 86400000));
      }
    }
    syncPeriod();
    syncRepeat();
  });
  repeatUntil.addEventListener('input', syncRepeat);
  repeatDays.forEach((day) => day.addEventListener('change', () => { repeatDaysTouched = true; syncRepeat(); }));
  const onPeriodChange = () => {
    if (repeatToggle.checked && !repeatDaysTouched) selectStartWeekday();
    syncPeriod();
    syncRepeat();
  };
  form?.addEventListener('submit', (event) => {
    if (!repeatToggle.checked) return;
    const count = Number(repeatPreview.dataset.count || 0);
    if (count < 1 || count > 60) {
      event.preventDefault();
      if (repeatDays.some((day) => day.checked)) repeatUntil.focus();
      else repeatDays[0]?.focus();
    }
  });

  const setActivePreset = (preset) => {
    quickButtons.forEach((button) => {
      button.setAttribute('aria-pressed', String(button.dataset.fill === preset));
    });
  };

  const pad = (n) => String(n).padStart(2, '0');
  const format = (d) => `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;
  const dateParts = () => {
    const match = selectedDate.match(/^(\d{4})-(\d{2})-(\d{2})$/);
    if (!match) return null;
    return [Number(match[1]), Number(match[2]) - 1, Number(match[3])];
  };
  const selectedDateFromParts = () => {
    const parts = dateParts();
    if (!parts) return '';
    return `${parts[0]}-${pad(parts[1] + 1)}-${pad(parts[2])}`;
  };
  const inputDate = (value) => String(value || '').slice(0, 10);
  const timeForDate = (date, fallbackTime, scheduledValue) => {
    if (date && date === selectedDateFromParts() && scheduledValue) return scheduledValue;
    return date ? `${date}T${fallbackTime}` : '';
  };
  const schoolStartForDate = (date) => timeForDate(date, '09:00', schoolDayStart);
  const schoolEndForDate = (date) => timeForDate(date, '19:00', schoolDayEnd);

  const setDayEnd = () => {
    const currentStart = fromInput.value || schoolDayStart || format(new Date());
    const date = inputDate(currentStart) || selectedDateFromParts();
    const dayEnd = schoolEndForDate(date);
    const dayStart = schoolStartForDate(date);
    fromInput.value = currentStart >= dayEnd ? dayStart : currentStart;
    toInput.value = dayEnd;
    setActivePreset('day-end');
    onPeriodChange();
  };

  const setOneLesson = () => {
    const base = fromInput.value ? new Date(fromInput.value) : new Date();
    const end = new Date(base.getTime() + 45 * 60 * 1000);
    fromInput.value = format(base);
    toInput.value = format(end);
    setActivePreset('lesson');
    onPeriodChange();
  };

  document.querySelector('[data-fill="day-end"]')?.addEventListener('click', setDayEnd);
  document.querySelector('[data-fill="lesson"]')?.addEventListener('click', setOneLesson);
  [fromInput, toInput].forEach((field) => field.addEventListener('input', () => {
    setActivePreset('');
    onPeriodChange();
  }));
  syncPeriod();
  syncRepeat();
})();
</script>
