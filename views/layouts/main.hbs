<!DOCTYPE html>
<html lang="ru">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="icon" href="/favicon.ico" sizes="any">
  <link rel="stylesheet" href="/assets/app.css">
  <!-- Yandex.Metrika counter -->
  <script type="text/javascript">
    (function(m,e,t,r,i,k,a){m[i]=m[i]||function(){(m[i].a=m[i].a||[]).push(arguments)};
    m[i].l=1*new Date();
    for (var j = 0; j < document.scripts.length; j++) {if (document.scripts[j].src === r) { return; }}
    k=e.createElement(t),a=e.getElementsByTagName(t)[0],k.async=1,k.src=r,a.parentNode.insertBefore(k,a)})
    (window, document, "script", "https://mc.yandex.ru/metrika/tag.js", "ym");

    ym(99316009, "init", {
      clickmap:true,
      trackLinks:true,
      accurateTrackBounce:true,
      webvisor:true,
      ecommerce:"dataLayer"
    });
  </script>
  {{#if enableUxRocket}}
    <script type="text/javascript" src="https://api.uxrocket.ru/js/uxrocket.js" authkey="E7TH49MVLG" fetchpriority="high"></script>
  {{/if}}
  <noscript><div><img src="https://mc.yandex.ru/watch/99316009" style="position:absolute; left:-9999px;" alt=""></div></noscript>
  <!-- /Yandex.Metrika counter -->
</head>
<body class="min-h-screen bg-gray-50 text-slate-950 antialiased">
  <header class="relative z-40 border-b border-slate-200 bg-white">
    <div class="mx-auto flex min-h-[4.75rem] max-w-[1480px] items-center justify-between gap-6 px-4 sm:px-6">
      <a href="/" class="shrink-0 text-lg font-semibold tracking-[-0.01em] text-slate-950 sm:text-xl">Учёт посещаемости</a>

      <nav class="hidden self-stretch md:flex md:items-stretch md:gap-8" aria-label="Основная навигация">
        {{#if currentUser.permissions.view_own_attendance}}
          <a href="/attendance/me" class="inline-flex items-center border-b-2 px-1 text-sm font-medium transition {{#if (eq activePage 'student-attendance')}}border-blue-700 text-blue-700{{else}}border-transparent text-slate-600 hover:border-slate-300 hover:text-slate-950{{/if}}">Моя посещаемость</a>
        {{else}}
          <a href="/attendance" class="inline-flex items-center border-b-2 px-1 text-sm font-medium transition {{#if (eq activePage 'attendance')}}border-blue-700 text-blue-700{{else}}border-transparent text-slate-600 hover:border-slate-300 hover:text-slate-950{{/if}}">Пропуски</a>
          <a href="/attendance/analytics" class="inline-flex items-center border-b-2 px-1 text-sm font-medium transition {{#if (eq activePage 'analytics')}}border-blue-700 text-blue-700{{else}}border-transparent text-slate-600 hover:border-slate-300 hover:text-slate-950{{/if}}">Аналитика</a>
        {{/if}}
      </nav>

      <div class="flex shrink-0 items-center gap-1.5 sm:gap-2">
        {{#if currentUser.permissions.use_attendance}}
          <a href="/attendance/presence" {{#if (eq activePage 'presence')}}aria-current="page"{{/if}} class="inline-flex h-10 items-center justify-center gap-1.5 rounded-lg border px-2.5 text-sm font-semibold transition focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600 focus-visible:ring-offset-2 sm:h-11 sm:px-3.5 {{#if (eq activePage 'presence')}}border-blue-700 bg-blue-700 text-white shadow-sm{{else}}border-blue-200 bg-blue-50 text-blue-700 hover:border-blue-300 hover:bg-blue-100{{/if}}">
            <svg class="h-5 w-5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M4 21V9l8-6 8 6v12M9 21v-6h6v6M8 10h.01M12 10h.01M16 10h.01" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span class="sm:hidden">Сейчас</span><span class="hidden sm:inline">Сейчас в школе</span>
          </a>
        {{/if}}

        {{#if currentUser}}
          <details class="group relative hidden md:block">
            <summary class="flex min-w-[12rem] cursor-pointer list-none items-center justify-end gap-3 rounded-lg px-2 py-2 text-right hover:bg-slate-50 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600">
              <span class="min-w-0">
                <span class="block max-w-[13rem] truncate text-sm font-semibold text-slate-900">{{currentUser.name}}</span>
                <span class="block max-w-[13rem] truncate text-xs text-slate-500">{{roleLabel currentUser}}</span>
              </span>
              <svg class="h-4 w-4 shrink-0 text-slate-700 transition group-open:rotate-180" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
                <path d="m6 9 6 6 6-6" stroke-linecap="round" stroke-linejoin="round"/>
              </svg>
            </summary>
            <div class="absolute right-0 top-full mt-2 w-44 rounded-lg border border-slate-200 bg-white p-1.5 shadow-lg">
              <a href="/api/auth/logout" class="block rounded-md px-3 py-2 text-sm font-medium text-slate-700 hover:bg-slate-100 hover:text-slate-950">Выйти</a>
            </div>
          </details>

          <details class="group relative md:hidden">
            <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-lg border border-transparent text-slate-950 hover:bg-slate-100 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-blue-600" aria-label="Открыть меню">
              <svg class="h-7 w-7" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                <path d="M4 7h16M4 12h16M4 17h16" stroke-linecap="round"/>
              </svg>
            </summary>
            <div class="absolute right-0 top-full mt-2 w-[min(20rem,calc(100vw-2rem))] rounded-xl border border-slate-200 bg-white p-2 shadow-xl">
              <div class="border-b border-slate-100 px-3 py-2">
                <div class="truncate text-sm font-semibold text-slate-950">{{currentUser.name}}</div>
                <div class="truncate text-xs text-slate-500">{{roleLabel currentUser}}</div>
              </div>
              <nav class="space-y-1 py-2" aria-label="Мобильная навигация">
                {{#if currentUser.permissions.view_own_attendance}}
                  <a href="/attendance/me" class="block rounded-lg px-3 py-2.5 text-sm font-medium {{#if (eq activePage 'student-attendance')}}bg-blue-50 text-blue-700{{else}}text-slate-700 hover:bg-slate-100{{/if}}">Моя посещаемость</a>
                {{else}}
                  <a href="/attendance/presence" class="block rounded-lg px-3 py-2.5 text-sm font-medium {{#if (eq activePage 'presence')}}bg-blue-50 text-blue-700{{else}}text-slate-700 hover:bg-slate-100{{/if}}">Сейчас в школе</a>
                  <a href="/attendance" class="block rounded-lg px-3 py-2.5 text-sm font-medium {{#if (eq activePage 'attendance')}}bg-blue-50 text-blue-700{{else}}text-slate-700 hover:bg-slate-100{{/if}}">Пропуски</a>
                  <a href="/attendance/analytics" class="block rounded-lg px-3 py-2.5 text-sm font-medium {{#if (eq activePage 'analytics')}}bg-blue-50 text-blue-700{{else}}text-slate-700 hover:bg-slate-100{{/if}}">Аналитика</a>
                {{/if}}
              </nav>
              <a href="/api/auth/logout" class="block rounded-lg border-t border-slate-100 px-3 py-2.5 text-sm font-medium text-slate-700 hover:bg-slate-100">Выйти</a>
            </div>
          </details>
        {{/if}}
      </div>
    </div>
  </header>
  <main class="mx-auto {{#if wideLayout}}max-w-[1480px]{{else}}max-w-6xl{{/if}} px-4 py-6 sm:px-6 sm:py-8">
    {{{body}}}
  </main>
</body>
</html>
